{
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Auth": {
    "Jwt": {
      "SigningKey": "",
      "Issuer": "focus-api",
      "Audience": "focus-web",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    },
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:5001,http://127.0.0.1:3000,http://127.0.0.1:5001"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Ai": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Media": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "Reaction": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Algorithms": {
    "XpPerFocusMinute": 10,
    "CoinsPerFocusMinute": 1,
    "BreakBonusXp": 50,
    "BreakBonusCoins": 10,
    "BreakMinCompletionRatio": 0.9,
    "BreakMaxGapMinutes": 10,
    "MinRewardedFocusMinutes": 5,
    "AbandonRewardMinMinutes": 10,
    "CompletionToleranceSeconds": 15,
    "DailyCoinCap": 400,
    "MaxExtensions": 3,
    "MaxContinuousFocusMinutes": 90,
    "StaleRunningGraceMinutes": 10,
    "StalePausedHours": 3,
    "RoomMemberStaleMinutes": 30,
    "StreakMultipliers": {
      "3": 1.10,
      "7": 1.25,
      "30": 1.50
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": ""
  },
  "ExternalApis": {
    "Pixabay": {
      "ApiKey": ""
    },
    "Jamendo": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "OpenMeteo": {
      "BaseUrl": "https://api.open-meteo.com/v1"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
