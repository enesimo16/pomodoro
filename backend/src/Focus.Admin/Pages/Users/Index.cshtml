@page
@model Focus.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-0 text-dark">Kullanıcılar</h4>
        <span class="text-muted small">Tüm misafir ve kayıtlı hesapların detayları</span>
    </div>
    <a asp-page="/ApiLab/Index" class="btn btn-primary">API Test Konsolu</a>
</div>

<div class="card card-custom p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Kullanıcı adı veya e-posta ile arayın..." />
        </div>
        <div class="col-md-3">
            <select name="Filter" class="form-select">
                <option value="">Tüm Kullanıcılar</option>
                <option value="guest" selected="@(Model.Filter == "guest")">Yalnızca Misafirler</option>
                <option value="registered" selected="@(Model.Filter == "registered")">Yalnızca Kayıtlılar</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Filtrele</button>
            <a asp-page="/Users/Index" class="btn btn-outline-secondary">Sıfırla</a>
        </div>
    </form>
</div>

<div class="card card-custom overflow-hidden">
    @if (!Model.Users.Any())
    {
        <div class="p-4 text-center text-muted small">
            Arama kriterine uygun kullanıcı bulunamadı.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>Kullanıcı</th>
                        <th>Hesap Türü</th>
                        <th>Oda Adı</th>
                        <th>Seviye / XP</th>
                        <th>Coin</th>
                        <th>Kayıt Tarihi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@user.DisplayName</div>
                                <div class="small text-muted">@(user.Email ?? "Misafir (E-posta yok)")</div>
                            </td>
                            <td>
                                @if (user.IsGuest)
                                {
                                    <span class="badge rounded-pill badge-status-guest">Misafir</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill badge-status-registered">Kayıtlı</span>
                                }
                            </td>
                            <td>
                                <span class="text-dark">@(user.RoomName ?? "-")</span>
                            </td>
                            <td>
                                <span class="badge rounded-pill badge-status-level">Lvl @user.Level</span>
                                <span class="small text-muted ms-1">@user.Xp XP</span>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">@user.Coins</span>
                            </td>
                            <td class="text-muted small">
                                @user.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
