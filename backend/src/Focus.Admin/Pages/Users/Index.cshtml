@page
@model Focus.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>Kullanıcılar & Karakterler</h2>
        <p class="text-secondary mb-0">Tüm misafir ve kayıtlı kullanıcıların seviye, oda ve coin durumları.</p>
    </div>
    <a asp-page="/ApiLab/Index" class="btn btn-outline-info">
        <i class="bi bi-terminal me-1"></i> API Test Konsolu
    </a>
</div>

<!-- Filtre & Arama Formu -->
<div class="card card-custom p-3 mb-4 shadow-sm">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                <input type="text" name="Search" value="@Model.Search" class="form-control bg-dark text-white border-secondary" placeholder="İsim veya e-posta ile ara..." />
            </div>
        </div>
        <div class="col-md-4">
            <select name="Filter" class="form-select bg-dark text-white border-secondary">
                <option value="">Tüm Kullanıcılar</option>
                <option value="guest" selected="@(Model.Filter == "guest")">Yalnızca Misafirler</option>
                <option value="registered" selected="@(Model.Filter == "registered")">Yalnızca Kayıtlı Kullanıcılar</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Filtrele</button>
            <a asp-page="/Users/Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Kullanici Tablosu -->
<div class="card card-custom p-4 shadow-sm">
    @if (!Model.Users.Any())
    {
        <div class="alert alert-secondary mb-0 bg-dark text-secondary border-secondary">
            Kriterlere uygun kullanıcı bulunamadı.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-secondary small text-uppercase">
                        <th>Kullanıcı Adı</th>
                        <th>Tür</th>
                        <th>Oda Adı</th>
                        <th>Seviye / XP</th>
                        <th>Coin</th>
                        <th>Kayıt Tarihi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-white">@user.DisplayName</div>
                                <div class="small text-secondary">@(user.Email ?? "Misafir (E-posta yok)")</div>
                            </td>
                            <td>
                                @if (user.IsGuest)
                                {
                                    <span class="badge bg-warning text-dark status-badge">Misafir</span>
                                }
                                else
                                {
                                    <span class="badge bg-success status-badge">Kayıtlı</span>
                                }
                            </td>
                            <td>
                                <span class="text-info"><i class="bi bi-house-door me-1"></i>@(user.RoomName ?? "Yok")</span>
                            </td>
                            <td>
                                <span class="badge bg-primary">Lvl @user.Level</span>
                                <span class="small text-secondary ms-1">@user.Xp XP</span>
                            </td>
                            <td>
                                <span class="text-warning fw-bold"><i class="bi bi-coin me-1"></i>@user.Coins</span>
                            </td>
                            <td class="text-secondary small">
                                @user.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
