@page
@model Focus.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Kullanıcılar</h3>
    <a asp-page="/ApiLab/Index" class="btn btn-outline-secondary btn-sm">API Test</a>
</div>

<div class="card card-custom p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="İsim veya e-posta ile ara..." />
        </div>
        <div class="col-md-4">
            <select name="Filter" class="form-select">
                <option value="">Tümü</option>
                <option value="guest" selected="@(Model.Filter == "guest")">Misafirler</option>
                <option value="registered" selected="@(Model.Filter == "registered")">Kayıtlı Kullanıcılar</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Filtrele</button>
            <a asp-page="/Users/Index" class="btn btn-outline-secondary">Temizle</a>
        </div>
    </form>
</div>

<div class="card card-custom p-4">
    @if (!Model.Users.Any())
    {
        <div class="text-muted small py-3">
            Kriterlere uygun kullanıcı bulunamadı.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="text-muted small text-uppercase border-bottom">
                        <th>Kullanıcı</th>
                        <th>Tür</th>
                        <th>Oda</th>
                        <th>Seviye / XP</th>
                        <th>Coin</th>
                        <th>Kayıt Tarihi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@user.DisplayName</div>
                                <div class="small text-muted">@(user.Email ?? "Misafir")</div>
                            </td>
                            <td>
                                @if (user.IsGuest)
                                {
                                    <span class="badge bg-light text-secondary border">Misafir</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Kayıtlı</span>
                                }
                            </td>
                            <td>
                                <span class="text-dark">@(user.RoomName ?? "-")</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border">Lvl @user.Level</span>
                                <span class="small text-muted ms-1">@user.Xp XP</span>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">@user.Coins</span>
                            </td>
                            <td class="text-muted small">
                                @user.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
