@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Sistem Genel Bakış</h2>
        <p class="text-secondary mb-0">Focus platformu veritabanı, kullanıcılar ve aktif oturum istatistikleri.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/ApiLab/Index" class="btn btn-primary">
            <i class="bi bi-play-circle me-1"></i> API Test Alanına Git
        </a>
        <a asp-page="/Users/Index" class="btn btn-outline-light">
            <i class="bi bi-people me-1"></i> Tüm Kullanıcılar
        </a>
    </div>
</div>

<!-- Istatistik Kartlari -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom p-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Toplam Kullanıcı</span>
                    <h3 class="fw-bold mt-1 text-white">@Model.TotalUsers</h3>
                </div>
                <div class="bg-primary bg-opacity-25 p-3 rounded-circle text-primary">
                    <i class="bi bi-people fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Aktif Misafirler</span>
                    <h3 class="fw-bold mt-1 text-warning">@Model.GuestUsers</h3>
                </div>
                <div class="bg-warning bg-opacity-25 p-3 rounded-circle text-warning">
                    <i class="bi bi-person-badge fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Kayıtlı (OAuth)</span>
                    <h3 class="fw-bold mt-1 text-success">@Model.RegisteredUsers</h3>
                </div>
                <div class="bg-success bg-opacity-25 p-3 rounded-circle text-success">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-secondary small text-uppercase fw-semibold">Dolaşımdaki Coin</span>
                    <h3 class="fw-bold mt-1 text-info">@Model.TotalCoinsInCirculation</h3>
                </div>
                <div class="bg-info bg-opacity-25 p-3 rounded-circle text-info">
                    <i class="bi bi-coin fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Son Kullanicilar Tablosu -->
<div class="card card-custom p-4 shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-white"><i class="bi bi-clock-history me-2 text-warning"></i>Son Katılan Kullanıcılar</h5>
        <a asp-page="/Users/Index" class="btn btn-sm btn-outline-secondary">Hepsini Gör</a>
    </div>

    @if (!Model.RecentUsers.Any())
    {
        <div class="alert alert-secondary mb-0 bg-dark text-secondary border-secondary">
            <i class="bi bi-info-circle me-1"></i> Henüz veritabanında kullanıcı bulunmuyor. <a asp-page="/ApiLab/Index" class="text-primary fw-semibold">API Test Alanı</a> üzerinden hemen bir misafir oluşturup test edebilirsiniz.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-secondary small text-uppercase">
                        <th>Kullanıcı</th>
                        <th>Tür</th>
                        <th>Seviye / XP</th>
                        <th>Kayıt Tarihi</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.RecentUsers)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-white">@user.DisplayName</div>
                                <div class="small text-secondary">@(user.Email ?? "Misafir (E-posta yok)")</div>
                            </td>
                            <td>
                                @if (user.IsGuest)
                                {
                                    <span class="badge bg-warning text-dark status-badge">Misafir</span>
                                }
                                else
                                {
                                    <span class="badge bg-success status-badge">Kayıtlı</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-primary">Lvl @user.Level</span>
                                <span class="small text-secondary ms-1">@user.Xp XP</span>
                            </td>
                            <td class="text-secondary small">
                                @user.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td>
                                <a asp-page="/Users/Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-light">
                                    <i class="bi bi-eye me-1"></i> İncele
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
