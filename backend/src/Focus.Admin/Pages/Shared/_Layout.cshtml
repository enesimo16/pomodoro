<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">
        <!-- Mobil Karartma Perdesi (Backdrop) -->
        <div class="admin-sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- SOL PANEL (Shopify Dark Charcoal Sidebar) -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Marka Alanı: Sadece Sade ve Büyük "Dashboard" Yazısı + Mobil Kapatma -->
            <div class="sidebar-brand d-flex justify-content-between align-items-center">
                <span class="sidebar-brand-title">Dashboard</span>
                <button type="button" class="sidebar-close-btn d-lg-none text-white small" id="sidebarCloseBtn" aria-label="Menüyü Kapat">
                    Kapat
                </button>
            </div>

            <!-- Menü Grupları & Klasör Hiyerarşisi (Shopify Polaris Folder Hierarchy) -->
            <div class="sidebar-nav-container">
                <!-- Sabit Linkler: Genel -->
                <div class="sidebar-nav-group">
                    <div class="sidebar-group-title">GENEL</div>
                    <a asp-page="/Index" class="sidebar-nav-item">Dashboard</a>
                    <a asp-page="/Analytics/Index" class="sidebar-nav-item">Analitik</a>
                </div>

                <!-- Klasör: Ekosistem -->
                <div class="sidebar-folder" data-folder-id="ecosystem">
                    <button type="button" class="sidebar-folder-header" aria-expanded="true">
                        <span class="folder-title">Ekosistem</span>
                        <span class="folder-caret" aria-hidden="true"></span>
                    </button>
                    <div class="sidebar-folder-items">
                        <a asp-page="/Users/Index" class="sidebar-nav-item">Kullanıcılar</a>
                        <a asp-page="/Sessions/Index" class="sidebar-nav-item">Seanslar</a>
                        <a asp-page="/StudyRooms/Index" class="sidebar-nav-item">Odalar</a>
                        <a asp-page="/Guestbook/Index" class="sidebar-nav-item">Ziyaretçi Defteri</a>
                    </div>
                </div>

                <!-- Klasör: Ekonomi & Mağaza -->
                <div class="sidebar-folder" data-folder-id="economy">
                    <button type="button" class="sidebar-folder-header" aria-expanded="true">
                        <span class="folder-title">Ekonomi & Mağaza</span>
                        <span class="folder-caret" aria-hidden="true"></span>
                    </button>
                    <div class="sidebar-folder-items">
                        <a asp-page="/Shop/Index" class="sidebar-nav-item">Mağaza Kataloğu</a>
                        <a asp-page="/Economy/Index" class="sidebar-nav-item">Coin Defteri</a>
                    </div>
                </div>

                <!-- Klasör: Yapay Zeka & Sistem -->
                <div class="sidebar-folder" data-folder-id="intelligence">
                    <button type="button" class="sidebar-folder-header" aria-expanded="true">
                        <span class="folder-title">Yapay Zeka & Sistem</span>
                        <span class="folder-caret" aria-hidden="true"></span>
                    </button>
                    <div class="sidebar-folder-items">
                        <a asp-page="/AiCoach/Index" class="sidebar-nav-item">AI Koç & Vektör Bellek</a>
                        <a asp-page="/Jobs/Index" class="sidebar-nav-item">Cron Görevleri</a>
                    </div>
                </div>

                <!-- Klasör: Geliştirici (Folder / Dropdown) -->
                <div class="sidebar-folder" data-folder-id="developer">
                    <button type="button" class="sidebar-folder-header" aria-expanded="true">
                        <span class="folder-title">Geliştirici</span>
                        <span class="folder-caret" aria-hidden="true"></span>
                    </button>
                    <div class="sidebar-folder-items">
                        <a asp-page="/ApiDocs/Index" class="sidebar-nav-item">API Dokümantasyonu</a>
                        <a asp-page="/ApiLab/Index" class="sidebar-nav-item">API Test (Lab)</a>
                        <a href="http://localhost:5000/swagger" target="_blank" class="sidebar-nav-item" id="sidebarSwaggerLink">Swagger UI</a>
                        <a href="/hangfire" target="_blank" class="sidebar-nav-item">Hangfire Panel</a>
                        <a asp-page="/Audit/Index" class="sidebar-nav-item">Oturum Logları</a>
                    </div>
                </div>
            </div>

            <!-- Alt Profil Kutusu -->
            <div class="sidebar-footer">
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">Sistem Yöneticisi</div>
                    <div class="sidebar-user-role">admin@focus.local</div>
                </div>
            </div>
        </aside>

        <!-- ÜST PANEL (Shopify Minimal Header) -->
        <header class="admin-header">
            <div class="d-flex align-items-center flex-grow-1 overflow-hidden me-2">
                <!-- Hamburger Menü Butonu (Mobilde Görünür) -->
                <button type="button" class="sidebar-toggle-btn d-lg-none" id="sidebarToggleBtn" aria-label="Menüyü Aç">
                    Menü
                </button>
                <span class="d-lg-none fw-bold text-dark text-truncate me-2" style="font-size: 14px;">Dashboard</span>

                <!-- Sol: Arama Kutusu (Tablet & Masaüstü) -->
                <div class="header-search-container d-none d-md-flex">
                    <input type="text" class="header-search-input" style="padding-left: 12px;" placeholder="Kullanıcı, IP, oda veya eşya ara..." id="globalSearchInput" />
                    <span class="header-search-shortcut">⌘K</span>
                </div>
            </div>

            <!-- Sağ: Hızlı Bağlantılar -->
            <div class="header-actions-right flex-shrink-0">
                <a asp-page="/ApiDocs/Index" class="polaris-btn polaris-btn-secondary polaris-btn-sm d-none d-sm-inline-flex">
                    API Dokümanı
                </a>
                <a asp-page="/ApiLab/Index" class="polaris-btn polaris-btn-primary polaris-btn-sm">
                    API Lab
                </a>
                <a href="?admin_logout=true" class="polaris-btn polaris-btn-secondary polaris-btn-sm" title="Admin oturumunu sonlandır ve paneli 404 moduna kilitle">
                    Kilitle
                </a>
            </div>
        </header>

        <!-- ANA İÇERİK ALANI (Shopify Kirli Beyaz Canvas) -->
        <main class="admin-main" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Aktif sayfa linkini belirleme
            const currentPath = window.location.pathname.toLowerCase().replace(/\/index$/, '') || '/';
            document.querySelectorAll('.sidebar-nav-item').forEach(link => {
                let href = link.getAttribute('href')?.toLowerCase() || '';
                href = href.split('?')[0].replace(/\/index$/, '') || '/';
                if (href === currentPath || (currentPath !== '/' && href !== '/' && currentPath.startsWith(href))) {
                    link.classList.add('active');
                }
            });

            // Klasör / Dropdown Mantığı (Shopify Polaris Sidebar Folders)
            const folderStorageKey = 'focus_sidebar_folders';
            let folderStates = {};
            try {
                const saved = localStorage.getItem(folderStorageKey);
                if (saved) folderStates = JSON.parse(saved);
            } catch (e) {
                folderStates = {};
            }

            const folders = document.querySelectorAll('.sidebar-folder');
            folders.forEach(folder => {
                const folderId = folder.dataset.folderId;
                const header = folder.querySelector('.sidebar-folder-header');
                const hasActiveChild = !!folder.querySelector('.sidebar-nav-item.active');

                if (hasActiveChild) {
                    folder.classList.add('has-active-child');
                    folder.classList.remove('collapsed');
                    header?.setAttribute('aria-expanded', 'true');
                    folderStates[folderId] = true;
                } else if (folderStates[folderId] === false) {
                    folder.classList.add('collapsed');
                    header?.setAttribute('aria-expanded', 'false');
                } else {
                    folder.classList.remove('collapsed');
                    header?.setAttribute('aria-expanded', 'true');
                }

                header?.addEventListener('click', (e) => {
                    e.preventDefault();
                    const isCollapsed = folder.classList.toggle('collapsed');
                    header.setAttribute('aria-expanded', (!isCollapsed).toString());
                    folderStates[folderId] = !isCollapsed;
                    try {
                        localStorage.setItem(folderStorageKey, JSON.stringify(folderStates));
                    } catch (err) {}
                });
            });

            // Özel API Adresi senkronu
            const customApi = localStorage.getItem('focus_custom_api_base_url');
            if (customApi) {
                const swLink = document.getElementById('sidebarSwaggerLink');
                if (swLink) swLink.href = `${customApi.replace(/\/+$/, '')}/swagger`;
            }

            // Mobil Menü Aç / Kapa Kontrolü
            const sidebar = document.getElementById('adminSidebar');
            const toggleBtn = document.getElementById('sidebarToggleBtn');
            const closeBtn = document.getElementById('sidebarCloseBtn');
            const backdrop = document.getElementById('sidebarBackdrop');

            function openSidebar() {
                sidebar?.classList.add('show');
                backdrop?.classList.add('show');
                document.body.classList.add('sidebar-open');
            }

            function closeSidebar() {
                sidebar?.classList.remove('show');
                backdrop?.classList.remove('show');
                document.body.classList.remove('sidebar-open');
            }

            toggleBtn?.addEventListener('click', openSidebar);
            closeBtn?.addEventListener('click', closeSidebar);
            backdrop?.addEventListener('click', closeSidebar);

            document.querySelectorAll('.sidebar-nav-item').forEach(link => {
                link.addEventListener('click', () => {
                    if (window.innerWidth < 992) {
                        closeSidebar();
                    }
                });
            });

            document.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    document.getElementById('globalSearchInput')?.focus();
                }
                if (e.key === 'Escape') {
                    closeSidebar();
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
