@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">
        <!-- Mobil Karartma Perdesi (Backdrop) -->
        <div class="admin-sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- SOL PANEL (Shopify Dark Charcoal Sidebar) -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Marka Alanı: Sade "FOCUS CONSOLE" Başlığı + Animasyonlu Daraltma İkonu -->
            <div class="sidebar-brand d-flex justify-content-between align-items-center">
                <span class="sidebar-brand-title">FOCUS CONSOLE</span>
                <button type="button" class="sidebar-icon-btn" id="sidebarCloseBtn" aria-label="Gezinme Panelini Daralt" title="Gezinme Panelini Daralt">
                    <span class="animated-toggle-icon" aria-hidden="true">
                        <span class="bar bar-1"></span>
                        <span class="bar bar-2"></span>
                        <span class="bar bar-3"></span>
                    </span>
                </button>
            </div>

            <!-- Menü Grupları & Klasör Hiyerarşisi -->
            <div class="sidebar-nav-container">
                <!-- Sabit Linkler: Genel -->
                <div class="sidebar-nav-group">
                    <div class="sidebar-group-title">GENEL</div>
                    <a asp-page="/Index" class="sidebar-nav-item">Genel Bakış</a>
                    <a asp-page="/Analytics/Index" class="sidebar-nav-item">İstatistikler</a>
                </div>

                <!-- Klasör: Kullanıcılar & Odalar -->
                <div class="sidebar-folder" data-folder-id="workspaces">
                    <button type="button" class="sidebar-folder-header" aria-expanded="true">
                        <span class="folder-title">Kullanıcılar &amp; Odalar</span>
                        <span class="folder-caret" aria-hidden="true"></span>
                    </button>
                    <div class="sidebar-folder-items">
                        <a asp-page="/Users/Index" class="sidebar-nav-item">Kullanıcılar</a>
                        <a asp-page="/Sessions/Index" class="sidebar-nav-item">Seanslar</a>
                        <a asp-page="/StudyRooms/Index" class="sidebar-nav-item">Çalışma Odaları</a>
                        <a asp-page="/Guestbook/Index" class="sidebar-nav-item">Ziyaretçi Defteri</a>
                    </div>
                </div>

                <!-- Klasör: Mağaza & Coin -->
                <div class="sidebar-folder" data-folder-id="catalog_finance">
                    <button type="button" class="sidebar-folder-header" aria-expanded="true">
                        <span class="folder-title">Mağaza &amp; Coin</span>
                        <span class="folder-caret" aria-hidden="true"></span>
                    </button>
                    <div class="sidebar-folder-items">
                        <a asp-page="/Shop/Index" class="sidebar-nav-item">Mağaza</a>
                        <a asp-page="/Economy/Index" class="sidebar-nav-item">Coin Geçmişi</a>
                    </div>
                </div>

                <!-- Klasör: Temalar, Sesler & AI -->
                <div class="sidebar-folder" data-folder-id="ambience_engine">
                    <button type="button" class="sidebar-folder-header" aria-expanded="true">
                        <span class="folder-title">Temalar, Sesler &amp; AI</span>
                        <span class="folder-caret" aria-hidden="true"></span>
                    </button>
                    <div class="sidebar-folder-items">
                        <a asp-page="/Themes/Index" class="sidebar-nav-item">Temalar &amp; Videolar</a>
                        <a asp-page="/Music/Index" class="sidebar-nav-item">Sesler &amp; Müzikler</a>
                        <a asp-page="/AiCoach/Atmosphere" class="sidebar-nav-item">AI ile Atmosfer</a>
                        <a asp-page="/AiCoach/Personal" class="sidebar-nav-item">Kullanıcı AI Hafızası</a>
                        <a asp-page="/AiCoach/Global" class="sidebar-nav-item">Sistem AI Hafızası</a>
                    </div>
                </div>

                <!-- Klasör: Geliştirici & Sistem -->
                <div class="sidebar-folder" data-folder-id="infrastructure">
                    <button type="button" class="sidebar-folder-header" aria-expanded="true">
                        <span class="folder-title">Geliştirici &amp; Sistem</span>
                        <span class="folder-caret" aria-hidden="true"></span>
                    </button>
                    <div class="sidebar-folder-items">
                        <a asp-page="/ApiDocs/Index" class="sidebar-nav-item">API Dokümanı</a>
                        <a asp-page="/ApiLab/Index" class="sidebar-nav-item">API Test (Lab)</a>
                        <a asp-page="/Jobs/Index" class="sidebar-nav-item">Zamanlanmış İşler</a>
                        <a href="@((Configuration["WebApiBaseUrl"] ?? "http://localhost:5000").TrimEnd('/'))/swagger" target="_blank" rel="noopener" class="sidebar-nav-item" id="sidebarSwaggerLink">Swagger UI</a>
                        <a href="/hangfire" target="_blank" class="sidebar-nav-item">Hangfire</a>
                        <a asp-page="/Audit/Index" class="sidebar-nav-item">Sistem Logları</a>
                    </div>
                </div>
            </div>

            <!-- Alt Profil Kutusu -->
            <div class="sidebar-footer">
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">Yönetici</div>
                    <div class="sidebar-user-role">Admin</div>
                </div>
            </div>
        </aside>

        <!-- ÜST PANEL (Shopify Minimal Header) -->
        <header class="admin-header">
            <div class="d-flex align-items-center flex-grow-1 overflow-hidden me-2">
                <!-- Sol Panel Aç / Kapat Butonu (Masaüstü ve Mobil) -->
                <button type="button" class="header-icon-btn" id="sidebarToggleBtn" aria-label="Gezinme Panelini Aç veya Kapat" title="Gezinme Panelini Aç / Kapat (Ctrl+B)">
                    <span class="animated-toggle-icon" aria-hidden="true">
                        <span class="bar bar-1"></span>
                        <span class="bar bar-2"></span>
                        <span class="bar bar-3"></span>
                    </span>
                </button>
                <span class="d-lg-none fw-bold text-dark text-truncate me-2" style="font-size: 14px;">FOCUS CONSOLE</span>

                <!-- Sol: Arama Kutusu (Tablet & Masaüstü) -->
                <div class="header-search-container d-none d-md-flex">
                    <input type="text" class="header-search-input" style="padding-left: 12px;" placeholder="Menüde ara..." id="globalSearchInput" autocomplete="off" />
                    <span class="header-search-shortcut">⌘K</span>
                </div>
            </div>

            <!-- Sağ: Hızlı Bağlantılar -->
            <div class="header-actions-right flex-shrink-0">
                <a asp-page="/ApiDocs/Index" class="polaris-btn polaris-btn-secondary polaris-btn-sm d-none d-sm-inline-flex">
                    API Dokümanı
                </a>
                <a asp-page="/ApiLab/Index" class="polaris-btn polaris-btn-primary polaris-btn-sm">
                    API Lab
                </a>
                <a href="?admin_logout=true" class="polaris-btn polaris-btn-secondary polaris-btn-sm" title="Admin oturumunu sonlandır ve paneli 404 moduna kilitle">
                    Kilitle
                </a>
            </div>
        </header>

        <!-- ANA İÇERİK ALANI (Shopify Kirli Beyaz Canvas) -->
        <main class="admin-main" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Aktif sayfa linkini belirleme
            const currentPath = window.location.pathname.toLowerCase().replace(/\/index$/, '') || '/';
            document.querySelectorAll('.sidebar-nav-item').forEach(link => {
                let href = link.getAttribute('href')?.toLowerCase() || '';
                href = href.split('?')[0].replace(/\/index$/, '') || '/';
                if (href === currentPath || (currentPath !== '/' && href !== '/' && currentPath.startsWith(href))) {
                    link.classList.add('active');
                }
            });

            // Klasör / Dropdown Mantığı (Shopify Polaris Sidebar Folders)
            const folderStorageKey = 'focus_sidebar_folders';
            let folderStates = {};
            try {
                const saved = localStorage.getItem(folderStorageKey);
                if (saved) folderStates = JSON.parse(saved);
            } catch (e) {
                folderStates = {};
            }

            const folders = document.querySelectorAll('.sidebar-folder');
            folders.forEach(folder => {
                const folderId = folder.dataset.folderId;
                const header = folder.querySelector('.sidebar-folder-header');
                const hasActiveChild = !!folder.querySelector('.sidebar-nav-item.active');

                if (hasActiveChild) {
                    folder.classList.add('has-active-child');
                    folder.classList.remove('collapsed');
                    header?.setAttribute('aria-expanded', 'true');
                    folderStates[folderId] = true;
                } else if (folderStates[folderId] === false) {
                    folder.classList.add('collapsed');
                    header?.setAttribute('aria-expanded', 'false');
                } else {
                    folder.classList.remove('collapsed');
                    header?.setAttribute('aria-expanded', 'true');
                }

                header?.addEventListener('click', (e) => {
                    e.preventDefault();
                    const isCollapsed = folder.classList.toggle('collapsed');
                    header.setAttribute('aria-expanded', (!isCollapsed).toString());
                    folderStates[folderId] = !isCollapsed;
                    try {
                        localStorage.setItem(folderStorageKey, JSON.stringify(folderStates));
                    } catch (err) {}
                });
            });

            // Özel API Adresi senkronu
            let customApi = null;
            try {
                customApi = localStorage.getItem('focus_custom_api_base_url');
            } catch (e) {}
            if (customApi) {
                const swLink = document.getElementById('sidebarSwaggerLink');
                if (swLink) swLink.href = `${customApi.replace(/\/+$/, '')}/swagger`;
            }

            // Sol Panel Aç / Kapa & Masaüstü Daraltma Kontrolü
            const sidebar = document.getElementById('adminSidebar');
            const toggleBtn = document.getElementById('sidebarToggleBtn');
            const closeBtn = document.getElementById('sidebarCloseBtn');
            const backdrop = document.getElementById('sidebarBackdrop');
            const sidebarCollapseStorageKey = 'focus_sidebar_collapsed';

            // Sayfa açılışında kayıtlı masaüstü gizlilik durumunu uygula
            if (window.innerWidth >= 992) {
                try {
                    const isCollapsed = localStorage.getItem(sidebarCollapseStorageKey) === 'true';
                    if (isCollapsed) {
                        document.body.classList.add('sidebar-collapsed');
                    }
                } catch (e) {}
            }

            function toggleSidebar() {
                if (window.innerWidth < 992) {
                    const isShown = sidebar?.classList.contains('show');
                    if (isShown) {
                        closeMobileSidebar();
                    } else {
                        openMobileSidebar();
                    }
                } else {
                    const collapsed = document.body.classList.toggle('sidebar-collapsed');
                    try {
                        localStorage.setItem(sidebarCollapseStorageKey, collapsed ? 'true' : 'false');
                    } catch (e) {}
                }
            }

            function openMobileSidebar() {
                document.body.classList.remove('sidebar-collapsed');
                sidebar?.classList.add('show');
                backdrop?.classList.add('show');
                document.body.classList.add('sidebar-open');
            }

            function closeMobileSidebar() {
                sidebar?.classList.remove('show');
                backdrop?.classList.remove('show');
                document.body.classList.remove('sidebar-open');
            }

            toggleBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                toggleSidebar();
            });

            closeBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                if (window.innerWidth < 992) {
                    closeMobileSidebar();
                } else {
                    document.body.classList.add('sidebar-collapsed');
                    try {
                        localStorage.setItem(sidebarCollapseStorageKey, 'true');
                    } catch (e) {}
                }
            });

            backdrop?.addEventListener('click', closeMobileSidebar);

            window.addEventListener('resize', () => {
                if (window.innerWidth >= 992) {
                    closeMobileSidebar();
                }
            });

            // Menü arama: kenar çubuğu bağlantılarını süzer
            const searchInput = document.getElementById('globalSearchInput');
            searchInput?.addEventListener('input', () => {
                const term = searchInput.value.trim().toLowerCase();
                document.querySelectorAll('.sidebar-nav-item').forEach(link => {
                    link.style.display = !term || link.textContent.toLowerCase().includes(term) ? '' : 'none';
                });
                document.querySelectorAll('.sidebar-folder').forEach(folder => {
                    const hasVisible = Array.from(folder.querySelectorAll('.sidebar-nav-item')).some(l => l.style.display !== 'none');
                    folder.style.display = hasVisible ? '' : 'none';
                    if (term && hasVisible) folder.classList.remove('collapsed');
                });
            });

            document.querySelectorAll('.sidebar-nav-item').forEach(link => {
                link.addEventListener('click', () => {
                    if (window.innerWidth < 992) {
                        closeMobileSidebar();
                    }
                });
            });

            document.addEventListener('keydown', (e) => {
                const key = (e.key || '').toLowerCase();
                if ((e.ctrlKey || e.metaKey) && key === 'k') {
                    e.preventDefault();
                    document.getElementById('globalSearchInput')?.focus();
                }
                if ((e.ctrlKey || e.metaKey) && key === 'b') {
                    e.preventDefault();
                    toggleSidebar();
                }
                if (e.key === 'Escape') {
                    if (window.innerWidth < 992) {
                        closeMobileSidebar();
                    }
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
