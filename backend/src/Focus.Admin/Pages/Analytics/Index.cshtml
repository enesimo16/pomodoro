@page
@model Focus.Admin.Pages.Analytics.IndexModel
@{
    ViewData["Title"] = "Analitik & BI Raporları";
}

<!-- Başlık -->
<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Analitik & BI Raporları</h1>
        <p class="admin-page-subtitle">Platform büyüme metrikleri, ekonomi hacmi ve yapay zeka hafıza telemetrisi</p>
    </div>
    <div>
        <a asp-page="/Index" class="polaris-btn polaris-btn-secondary">
            Dashboard'a Dön
        </a>
    </div>
</div>

<!-- PANEL 1: Temel Büyüme & Etkileşim Metrikleri -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="polaris-metric-card">
            <div class="polaris-metric-label">
                <span>Günlük Aktif (DAU)</span>
                <span class="polaris-badge">Bugün</span>
            </div>
            <div class="polaris-metric-value">@Model.Overview.ActiveUsersToday.ToString("N0")</div>
            <div class="polaris-metric-subtext">Platformda seans veya işlem yapanlar</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="polaris-metric-card">
            <div class="polaris-metric-label">
                <span>Haftalık Aktif (WAU)</span>
                <span class="polaris-badge polaris-badge-neutral">7 Gün</span>
            </div>
            <div class="polaris-metric-value">@Model.Overview.ActiveUsersThisWeek.ToString("N0")</div>
            <div class="polaris-metric-subtext">Son 7 gün tekil kullanıcı</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="polaris-metric-card">
            <div class="polaris-metric-label">
                <span>Aylık Aktif (MAU)</span>
                <span class="polaris-badge polaris-badge-neutral">30 Gün</span>
            </div>
            <div class="polaris-metric-value">@Model.Overview.ActiveUsersThisMonth.ToString("N0")</div>
            <div class="polaris-metric-subtext">Aylık elde tutma oranı</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="polaris-metric-card">
            <div class="polaris-metric-label">
                <span>Aktif Piksel Avatarlar</span>
                <span class="polaris-badge">%@((Model.Overview.TotalUsers > 0 ? (Model.UserAnalytics.TotalAvatars * 100.0 / Model.Overview.TotalUsers) : 0).ToString("F0"))</span>
            </div>
            <div class="polaris-metric-value">@Model.UserAnalytics.TotalAvatars.ToString("N0")</div>
            <div class="polaris-metric-subtext">Özelleştirilmiş karakter sayısı</div>
        </div>
    </div>
</div>

<!-- PANEL 2: Ekonomi Analizi & En Çok Satan Eşyalar -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="polaris-card h-100">
            <div class="polaris-card-header">
                <h6>Ekonomi ve Odak Parası (Focus Coin) Dengesi</h6>
                <span class="polaris-badge polaris-badge-neutral">Hacim</span>
            </div>
            <div class="polaris-card-body">
                <div class="row g-3 mb-4">
                    <div class="col-sm-4">
                        <div class="text-muted small">Dolaşımdaki Coin</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@Model.EconomyAnalytics.TotalCirculatingCoins.ToString("N0")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">Kazanılan Coin</div>
                        <div class="fs-4 fw-bold text-dark mt-1">+@Model.EconomyAnalytics.TotalCoinsEarned.ToString("N0")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">Harcanan Coin</div>
                        <div class="fs-4 fw-bold text-dark mt-1">-@Model.EconomyAnalytics.TotalCoinsSpent.ToString("N0")</div>
                    </div>
                </div>

                <h6 class="fw-bold mb-3 small text-uppercase text-muted">Kategori Bazlı Harcama Dağılımı</h6>
                @if (!Model.EconomyAnalytics.CategorySpendBreakdown.Any())
                {
                    <div class="text-muted small">Henüz mağazada harcama kaydı bulunmuyor.</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var cat in Model.EconomyAnalytics.CategorySpendBreakdown)
                        {
                            <div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold">@cat.Key</span>
                                    <span>@cat.Value.ToString("N0") Coin</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-dark" style="width: @(Model.EconomyAnalytics.TotalCoinsSpent > 0 ? (cat.Value * 100.0 / Model.EconomyAnalytics.TotalCoinsSpent) : 0)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="polaris-card h-100">
            <div class="polaris-card-header">
                <h6>En Çok Satın Alınan Mağaza Eşyaları</h6>
                <a asp-page="/Shop/Index" class="polaris-btn polaris-btn-secondary polaris-btn-sm">Mağazayı Gör</a>
            </div>
            @if (!Model.EconomyAnalytics.TopPurchasedItems.Any())
            {
                <div class="p-4 text-center text-muted small">
                    Henüz eşya satışı gerçekleşmedi.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="polaris-table">
                        <thead>
                            <tr>
                                <th>Eşya Adı</th>
                                <th>Kategori</th>
                                <th>Fiyat</th>
                                <th>Toplam Satış</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.EconomyAnalytics.TopPurchasedItems)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Name</td>
                                    <td>
                                        <span class="polaris-badge polaris-badge-neutral">@item.Category</span>
                                    </td>
                                    <td>@item.Price Coin</td>
                                    <td>
                                        <span class="fw-bold text-dark">@item.TotalPurchased Adet</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- PANEL 3: Kullanıcı Liderlik Sıralaması (XP & Günlük Seri) -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="polaris-card h-100">
            <div class="polaris-card-header">
                <h6>En Yüksek Seviye & Deneyim (XP) Sıralaması</h6>
                <span class="polaris-badge polaris-badge-neutral">Top 5</span>
            </div>
            @if (!Model.UserAnalytics.TopUsersByXp.Any())
            {
                <div class="p-4 text-center text-muted small">Kullanıcı bulunmuyor.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="polaris-table">
                        <thead>
                            <tr>
                                <th>Kullanıcı</th>
                                <th>Seviye</th>
                                <th>Toplam XP</th>
                                <th>Bakiye</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.UserAnalytics.TopUsersByXp)
                            {
                                <tr>
                                    <td class="fw-semibold">@u.DisplayName</td>
                                    <td><span class="polaris-badge polaris-badge-dark">Lv.@u.Level</span></td>
                                    <td>@u.CurrentXp.ToString("N0") XP</td>
                                    <td>@u.FocusCoins.ToString("N0") Coin</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="polaris-card h-100">
            <div class="polaris-card-header">
                <h6>En Uzun Günlük Odak Serisi (Streak) Rekorları</h6>
                <span class="polaris-badge polaris-badge-neutral">Top 5</span>
            </div>
            @if (!Model.UserAnalytics.TopUsersByStreak.Any())
            {
                <div class="p-4 text-center text-muted small">Kullanıcı serisi bulunmuyor.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="polaris-table">
                        <thead>
                            <tr>
                                <th>Kullanıcı</th>
                                <th>Günlük Seri</th>
                                <th>Seviye</th>
                                <th>Bakiye</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.UserAnalytics.TopUsersByStreak)
                            {
                                <tr>
                                    <td class="fw-semibold">@u.DisplayName</td>
                                    <td><span class="polaris-badge polaris-badge-dark">@u.CurrentStreak Gün</span></td>
                                    <td>Lv.@u.Level</td>
                                    <td>@u.FocusCoins.ToString("N0") Coin</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- PANEL 4: Sistem & Vektör Telemetrisi -->
<div class="polaris-card">
    <div class="polaris-card-header">
        <h6>Yapay Zeka & Altyapı Telemetrisi</h6>
        <span class="polaris-badge polaris-badge-neutral">Sunucu Saati: @Model.SystemHealth.ServerTimeUtc.ToString("HH:mm:ss") UTC</span>
    </div>
    <div class="polaris-card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="text-muted small">PostgreSQL Veritabanı</div>
                <div class="fw-bold mt-1">@Model.SystemHealth.DatabaseStatus (@Model.SystemHealth.DatabaseLatencyMs ms)</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Redis Önbellek</div>
                <div class="fw-bold mt-1">@Model.SystemHealth.RedisStatus</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">pgvector Toplam Bellek</div>
                <div class="fw-bold mt-1">@Model.SystemHealth.TotalAgentMemories Vektör Kayıt</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Oda Doluluğu</div>
                <div class="fw-bold mt-1">@Model.SystemHealth.ActiveStudyRooms / @Model.SystemHealth.TotalStudyRooms Aktif Oda</div>
            </div>
        </div>
    </div>
</div>
