@page
@model Focus.Admin.Pages.AiCoach.PersonalModel
@{
    ViewData["Title"] = "Kullanıcı AI Hafızası";
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Kullanıcı AI Hafızası</h1>
        <p class="admin-page-subtitle">Kullanıcıların çalışma tercihleri, seans alışkanlıkları ve kayıtlı hafıza parçacıkları</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-page="/AiCoach/Global" class="polaris-btn polaris-btn-secondary">
            Sistem AI Hafızası
        </a>
        <a asp-page="/Index" class="polaris-btn polaris-btn-secondary">
            Genel Bakış
        </a>
    </div>
</div>

<!-- KULLANICI SEÇİCİ BAR (Shopify Polaris Select) -->
<div class="polaris-card mb-4">
    <div class="polaris-card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <label class="text-muted small fw-semibold d-block mb-1">İncelenen Kullanıcı Profili</label>
                <select name="SelectedUserId" class="form-select polaris-select w-100" onchange="this.form.submit()">
                    @foreach (var opt in Model.UserOptions)
                    {
                        <option value="@opt.Id" selected="@(opt.Id == Model.SelectedUserId ? "selected" : null)">
                            @opt.DisplayName (@opt.Email) • Lv.@opt.Level • @opt.MemoryCount Kişisel Bellek
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="text-muted small fw-semibold d-block mb-1">Kişisel Bellekte Ara</label>
                <input type="text" name="Search" value="@Model.Search" class="form-control form-control-sm" placeholder="Alışkanlık, hedef veya tercih ara..." />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-1" style="padding-top: 18px;">
                <button type="submit" class="polaris-btn polaris-btn-primary polaris-btn-sm w-100">Filtrele</button>
                @if (!string.IsNullOrEmpty(Model.Search))
                {
                    <a asp-page="/AiCoach/Personal" asp-route-SelectedUserId="@Model.SelectedUserId" class="polaris-btn polaris-btn-secondary polaris-btn-sm">Sıfırla</a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model.CurrentUser == null)
{
    <div class="polaris-card p-5 text-center text-muted">
        Henüz kayıtlı kullanıcı bulunmuyor.
    </div>
}
else
{
    <!-- PANEL 1: Kişisel AI KPI Metrik Kartları -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="polaris-metric-card">
                <div class="polaris-metric-label">
                    <span>Kişisel Vektör Bellek</span>
                    <span class="polaris-badge polaris-badge-dark">İzole</span>
                </div>
                <div class="polaris-metric-value">@Model.TotalPersonalMemories</div>
                <div class="polaris-metric-subtext">Bu kullanıcıya ait pgvector hafıza girdisi</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="polaris-metric-card">
                <div class="polaris-metric-label">
                    <span>Ortalama Odak Kalitesi</span>
                    <span class="polaris-badge">1 - 5 Puan</span>
                </div>
                <div class="polaris-metric-value">@(Model.AverageFocusQuality > 0 ? Model.AverageFocusQuality.ToString("F1") : "-")</div>
                <div class="polaris-metric-subtext">@Model.TotalReflections seans sonu geri bildirimi</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="polaris-metric-card">
                <div class="polaris-metric-label">
                    <span>Yorgunluk & Tükenmişlik</span>
                    <span class="polaris-badge @(Model.AnomalyStatus?.DailyFatigueScore >= 70 ? "polaris-badge-dark" : "polaris-badge-neutral")">
                        @(Model.AnomalyStatus?.HasAnomaly == true ? "Anomali Var" : "Dengeli")
                    </span>
                </div>
                <div class="polaris-metric-value">@((Model.AnomalyStatus?.DailyFatigueScore ?? 0).ToString("F0")) / 100</div>
                <div class="polaris-metric-subtext">Haftalık: @((Model.AnomalyStatus?.WeeklyFocusMinutes ?? 0)) dk odak</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="polaris-metric-card">
                <div class="polaris-metric-label">
                    <span>Duygu Check-In Takibi</span>
                    <span class="polaris-badge">Seans Başı</span>
                </div>
                <div class="polaris-metric-value">@Model.TotalCheckIns</div>
                <div class="polaris-metric-subtext">Ön niyet ve ruh hali kaydı</div>
            </div>
        </div>
    </div>

    <!-- PANEL 2: AI Koçluk Durumu & Anomali Kalkanı -->
    @if (Model.AnomalyStatus != null)
    {
        <div class="polaris-card mb-4" style="border-left: 3px solid #202223;">
            <div class="polaris-card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-dark fs-6">AI Koç Bilişsel Teşhisi:</span>
                    <span class="polaris-badge polaris-badge-dark">@Model.AnomalyStatus.AnomalyType</span>
                </div>
                <span class="text-muted small">Son seans: @Model.AnomalyStatus.DaysSinceLastSession gün önce</span>
            </div>
            <div class="polaris-card-body p-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <span class="text-muted small d-block">Durum Özeti</span>
                        <div class="fw-semibold text-dark mt-1">@Model.AnomalyStatus.StatusSummary</div>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted small d-block">Önerilen Eylem & Reçete</span>
                        <div class="text-dark mt-1">@Model.AnomalyStatus.RecommendedAction</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- PANEL 3: Kişisel Derin Sentez Çıkarımları (Synthesis Engine) -->
    <div class="polaris-card mb-4">
        <div class="polaris-card-header">
            <h6>Otomatik Sentezlenen Kişisel Örüntüler & Çıkarımlar</h6>
            <span class="polaris-badge">@Model.SynthesizedInsights.Count İçgörü</span>
        </div>
        <div class="polaris-card-body p-3">
            <div class="row g-3">
                @foreach (var insight in Model.SynthesizedInsights)
                {
                    <div class="col-md-6">
                        <div class="p-3 bg-light border rounded h-100">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark">@insight.Title</span>
                                <span class="polaris-badge polaris-badge-dark font-monospace" style="font-size: 10px;">@insight.Tag</span>
                            </div>
                            <p class="text-muted small m-0">@insight.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- PANEL 4: Kişisel pgvector Vektör Belleği Tablosu -->
    <div class="polaris-card mb-4">
        <div class="polaris-card-header">
            <h6>Kullanıcının Özel Vektör Bellek Kayıtları (Private pgvector)</h6>
            <span class="polaris-badge">@Model.Memories.Count Kayıt Gösteriliyor</span>
        </div>
        @if (!Model.Memories.Any())
        {
            <div class="p-4 text-center text-muted small">
                Bu kullanıcıya ait henüz kaydedilmiş kişisel vektör hafızası bulunmuyor.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="polaris-table">
                    <thead>
                        <tr>
                            <th>Kategori</th>
                            <th>Anlamsal Hafıza İçeriği</th>
                            <th>Önem</th>
                            <th>Kullanım</th>
                            <th>Tarih</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mem in Model.Memories)
                        {
                            <tr>
                                <td>
                                    <span class="polaris-badge polaris-badge-dark font-monospace">@mem.Category</span>
                                </td>
                                <td>
                                    <div class="text-dark fw-medium small" style="max-width: 500px; white-space: normal;">
                                        @mem.Content
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold">@mem.Importance / 5</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@mem.UsageCount kez</span>
                                </td>
                                <td class="text-muted font-monospace small">
                                    @mem.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- PANEL 5: Son Seans Sonu Değerlendirmeleri (Reflections) -->
    <div class="polaris-card">
        <div class="polaris-card-header">
            <h6>Seans Sonu Duygu ve Kalite Yansımaları (Reflections)</h6>
            <span class="polaris-badge">Son 10 Seans</span>
        </div>
        @if (!Model.RecentReflections.Any())
        {
            <div class="p-4 text-center text-muted small">
                Henüz seans sonu değerlendirme kaydı girilmemiş.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="polaris-table">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Odak Kalitesi</th>
                            <th>Seans Sonu Ruh Hali</th>
                            <th>Kullanıcı Notu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.RecentReflections)
                        {
                            <tr>
                                <td class="text-muted font-monospace small">
                                    @r.Date.ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    <span class="fw-bold">@r.Quality / 5</span>
                                </td>
                                <td>
                                    <span class="polaris-badge">@r.MoodAfter</span>
                                </td>
                                <td>
                                    <span class="text-dark small">@(string.IsNullOrWhiteSpace(r.DistractionNote) ? "-" : r.DistractionNote)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
