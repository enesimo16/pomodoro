                    <audio id="previewAudioPlayer" controls class="w-100" style="height: 36px;" src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3"></audio>
                </div>
            </div>

            <!-- Canlı Sayaç Kartı -->
            <div class="p-4 bg-white border-top">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-dark fs-6">Odaklanma Durumu</span>
                        <span id="badgeTimerMode" class="badge bg-secondary-subtle text-secondary border">Hazır</span>
                    </div>
                    <span id="lblRoundProgress" class="badge bg-light text-secondary border px-3 py-1">Tur 1 / 4</span>
                </div>

                <div class="text-center py-2 mb-3">
                    <div class="text-muted small text-uppercase fw-semibold mb-1" id="lblTimerSubHeader">Kalan Süre</div>
                    <div id="lblTimerDisplay" class="display-3 fw-bold text-dark font-monospace mb-1">48:00</div>
                    <div class="d-flex justify-content-center align-items-center gap-3 text-secondary small">
                        <span>Durum: <strong id="lblTimerStatus" class="text-dark">Beklemede</strong></span>
                        <span>•</span>
                        <span>Çalışılan: <strong id="lblNetDuration" class="text-dark">0 sn</strong></span>
                    </div>
                </div>

                <!-- İlerleme Çubuğu -->
                <div class="progress" style="height: 6px;">
                    <div id="timerProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 100%;"></div>
                </div>
            </div>
        </div>

        <!-- Oturum ve Karakter Özeti -->
        <div class="card card-custom p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">Aktif Oturum & Karakter Özeti</h6>
                <span id="sessionStatusBadge" class="badge rounded-pill badge-status-guest">Oturum Yok</span>
            </div>

            <div id="sessionEmptyAlert" class="p-3 bg-light rounded text-muted small text-center">
                Henüz oturum açılmadı. Soldaki panelden <strong>Misafir Hesabı Aç</strong> butonuna tıklayabilirsiniz.
            </div>

            <div id="sessionContent" style="display: none;">
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <div class="p-3 rounded bg-light border">
                            <span class="text-muted small d-block mb-1">Kullanıcı & Tür</span>
                            <div id="lblDisplayName" class="fw-bold text-dark fs-6"></div>
                            <span id="lblUserType" class="badge rounded-pill mt-1"></span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded bg-light border">
                            <span class="text-muted small d-block mb-1">Seviye ve Bakiye</span>
                            <div class="fw-bold text-dark fs-6"><span id="lblCoins">0</span> Coin</div>
                            <span id="lblLevel" class="badge rounded-pill badge-status-level mt-1"></span>
                        </div>
                    </div>
                </div>

                <!-- Seri ve Dondurucu (Faz 3) -->
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <div class="p-3 rounded bg-light border">
                            <span class="text-muted small d-block mb-1">Odaklanma Serisi</span>
                            <div class="fw-bold text-danger fs-6" id="lblLiveStreak">0 Gün</div>
                            <span id="lblStreakStatusBadge" class="badge bg-secondary-subtle text-secondary small mt-1">Bugün Yapılmadı</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded bg-light border">
                            <span class="text-muted small d-block mb-1">Seri Dondurucu (Freeze)</span>
                            <div class="fw-bold text-info fs-6" id="lblLiveFreezes">1 / 2 Hak</div>
                            <span class="badge bg-light text-secondary border small mt-1">Oto-Koruma Aktif</span>
                        </div>
                    </div>
                </div>

                <!-- Avatar Detay -->
                <div class="p-3 rounded bg-light border mb-3">
                    <span class="text-muted small fw-semibold d-block mb-1">Avatar Görünümü</span>
                    <div id="lblAvatarSummary" class="small text-secondary"></div>
                </div>

                <!-- Piksel Oda & Mobilyalar -->
                <div class="p-3 rounded bg-light border mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Oda: <strong id="lblRoomName" class="text-dark"></strong> (<span id="lblThemeSummary"></span>)</span>
                        <span id="lblItemCount" class="badge bg-white text-secondary border small">0 Mobilya</span>
                    </div>
                    <div id="listRoomItems" class="d-flex flex-column gap-1 small text-secondary"></div>
                </div>

                <!-- Token -->
                <div class="p-3 rounded bg-light border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">Access Token (JWT)</span>
                        <button id="btnCopyToken" class="btn btn-sm btn-link p-0 text-decoration-none small text-primary">Kopyala</button>
                    </div>
                    <code id="lblTokenPreview" class="d-block text-secondary small text-break"></code>
                </div>
            </div>
        </div>

        <!-- Terminal Log Konsolu -->
        <div class="card card-custom p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small text-uppercase fw-semibold">Canlı İstek & Yanıt Günlüğü</span>
                <button id="btnClearLog" class="btn btn-sm btn-link text-secondary text-decoration-none p-0 small">Temizle</button>
            </div>
            <div id="terminalLog" class="terminal-box">
[Sistem] API Test Konsolu hazır. Faz 0 (Auth), Faz 1 (Avatar, Oda) ve Faz 2 (Sayaç, Pixabay Video, Lo-Fi Müzik & Hava Senkronu) hazır.
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    const apiBase = '@Model.WebApiBaseUrl';

    let currentTokens = {
        accessToken: sessionStorage.getItem('focus_test_at') || null,
        refreshToken: sessionStorage.getItem('focus_test_rt') || null
    };

    let currentUserId = null;
    let currentRoomCode = null;
    let roomHubConn = null;

    let activeSession = null;
    let timerInterval = null;
    let remainingSeconds = 48 * 60;
    let totalPlannedSeconds = 48 * 60;

    // Medya Oynatıcı Referansları
    const videoPlayer = document.getElementById('previewVideoPlayer');
    const audioPlayer = document.getElementById('previewAudioPlayer');

    function saveTokens(accessToken, refreshToken) {
        currentTokens.accessToken = accessToken;
        currentTokens.refreshToken = refreshToken;
        if (accessToken) sessionStorage.setItem('focus_test_at', accessToken);
        else sessionStorage.removeItem('focus_test_at');
        if (refreshToken) sessionStorage.setItem('focus_test_rt', refreshToken);
        else sessionStorage.removeItem('focus_test_rt');
    }

    function getAuthHeaders(includeContentType = true) {
        const headers = {};
        if (includeContentType) headers['Content-Type'] = 'application/json';
        if (currentTokens.accessToken) headers['Authorization'] = `Bearer ${currentTokens.accessToken}`;
        return headers;
    }

    function log(message, type = 'info') {
        const box = document.getElementById('terminalLog');
        const time = new Date().toLocaleTimeString();
        let color = '#202223';
        if (type === 'error') color = '#202223';
        if (type === 'success') color = '#202223';
        if (type === 'warn') color = '#55575a';

        const line = document.createElement('div');
        line.style.color = color;
        line.innerHTML = `<span style="color: #8c9196;">[${time}]</span> ${escapeHtml(message)}`;
        box.appendChild(line);
        box.scrollTop = box.scrollHeight;
    }

    function escapeHtml(text) {
        if (!text) return '';
        return text.toString()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function updateSessionUI(data) {
        document.getElementById('sessionEmptyAlert').style.display = 'none';
        document.getElementById('sessionContent').style.display = 'block';

        if (data.user) {
            currentUserId = data.user.id;
            document.getElementById('lblDisplayName').textContent = data.user.displayName;
            document.getElementById('lblCoins').textContent = data.user.totalCoins;
            document.getElementById('lblLevel').textContent = `Seviye ${data.user.level} (${data.user.currentXp} XP)`;

            const badgeUserType = document.getElementById('lblUserType');
            if (data.user.isGuest) {
                badgeUserType.textContent = 'Misafir Kullanıcı';
                badgeUserType.className = 'badge rounded-pill badge-status-guest mt-1';
            } else {
                badgeUserType.textContent = 'Kayıtlı Kullanıcı';
                badgeUserType.className = 'badge rounded-pill badge-status-registered mt-1';
            }

            const statusBadge = document.getElementById('sessionStatusBadge');
            statusBadge.textContent = 'Aktif Oturum';
            statusBadge.className = 'badge rounded-pill badge-status-active';
        }

        if (data.tokens && data.tokens.accessToken) {
            document.getElementById('lblTokenPreview').textContent =
                data.tokens.accessToken.substring(0, 48) + '... (Uzunluk: ' + data.tokens.accessToken.length + ')';
        } else if (currentTokens.accessToken) {
            document.getElementById('lblTokenPreview').textContent =
                currentTokens.accessToken.substring(0, 48) + '... (Uzunluk: ' + currentTokens.accessToken.length + ')';
        }

        if (data.avatar) {
            document.getElementById('lblAvatarSummary').textContent =
                `Ten: ${data.avatar.skinTone} | Saç: ${data.avatar.hairStyle} (${data.avatar.hairColor}) | Üst: ${data.avatar.topItemId} | Alt: ${data.avatar.bottomItemId} | Şapka: ${data.avatar.hatItemId || 'Yok'}`;
        }

        if (data.room) {
            document.getElementById('lblRoomName').textContent = data.room.name;
            document.getElementById('lblThemeSummary').textContent = `${data.room.wallpaperCatalogId}, ${data.room.floorCatalogId}`;
            document.getElementById('lblItemCount').textContent = `${data.room.items.length} Mobilya`;

            const list = document.getElementById('listRoomItems');
            list.innerHTML = '';
            if (data.room.items.length === 0) {
                list.innerHTML = '<span class="text-muted">Odada eşya yok.</span>';
            } else {
                data.room.items.forEach(item => {
                    const row = document.createElement('div');
                    row.className = 'd-flex justify-content-between align-items-center bg-white p-2 rounded border';
                    row.innerHTML = `
                        <div>
                            <strong class="text-dark">${escapeHtml(item.catalogItemId)}</strong>
                            <span class="text-muted ms-2">(X: ${item.gridX}, Y: ${item.gridY}, Rot: ${item.rotation}°)</span>
                        </div>
                        <div class="d-flex gap-1">
                            <button class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="moveItemPrompt('${item.id}', ${item.gridX}, ${item.gridY}, ${item.rotation})">Taşı</button>
                            <button class="btn btn-outline-danger btn-sm py-0 px-2" onclick="removeItem('${item.id}')">Kaldır</button>
                        </div>
                    `;
                    list.appendChild(row);
                });
            }
        fetchLiveStreak();
    }

    function clearSessionUI() {
        saveTokens(null, null);
        currentUserId = null;
        currentRoomCode = null;
        if (roomHubConn) { try { roomHubConn.stop(); } catch(e){} }
        activeSession = null;
        clearInterval(timerInterval);
        document.getElementById('sessionEmptyAlert').style.display = 'block';
        document.getElementById('sessionContent').style.display = 'none';
        document.getElementById('sessionStatusBadge').textContent = 'Oturum Yok';
        document.getElementById('sessionStatusBadge').className = 'badge rounded-pill badge-status-guest';
        document.getElementById('lblLiveStreak').textContent = '0 Gün';
        document.getElementById('lblLiveFreezes').textContent = '1 / 2 Hak';
        document.getElementById('lblStreakStatusBadge').textContent = 'Bugün Yapılmadı';
        updateTimerDisplay(48 * 60, 48 * 60, 'Beklemede', 'Hazır', 'Tur 1 / 4', false);
    }

    // SAĞDAKİ CANLI TEMA & MÜZİK ÖNİZLEMESİNİ GÜNCELLE
    function setPreviewTheme(videoUrl, title, posterUrl = null) {
        if (!videoUrl) return;
        videoPlayer.src = videoUrl;
        if (posterUrl) videoPlayer.poster = posterUrl;
        videoPlayer.play().catch(e => console.log('Video autoplay:', e));

        document.getElementById('badgeStudioTheme').textContent = title;
        document.getElementById('sessionThemeId').value = title;
        document.getElementById('btnToggleVideoPlay').textContent = 'Durdur';
        log(`Sağdaki stüdyo önizlemesine tema videosu yüklendi: "${title}"`, 'info');
    }

    function setPreviewTrack(audioUrl, title, artist, imgUrl = null) {
        if (!audioUrl) return;
        audioPlayer.src = audioUrl;
        document.getElementById('playerTrackTitle').textContent = title;
        document.getElementById('playerArtistName').textContent = artist;
        if (imgUrl) {
            document.getElementById('playerTrackImg').src = imgUrl;
        }
        audioPlayer.play().catch(e => console.log('Audio autoplay:', e));
        log(`Sağdaki piksel plak çalara müzik yüklendi: "${title}" - ${artist}`, 'info');
    }

    // SAYAÇ VE MASA LAMBASI UI
    function updateTimerUI(session) {
        activeSession = session;
        if (!session) {
            clearInterval(timerInterval);
            updateTimerDisplay(48 * 60, 48 * 60, 'Beklemede', 'Hazır', 'Tur 1 / 4', false);
            return;
        }

        const isFocus = session.kind === 'Focus';
        const isRunning = session.status === 'Running';
        const isPaused = session.status === 'Paused';

        // Masa lambası: Odak ve Çalışıyor/Duraklatıldı durumunda açık
        const isDeskLightOn = isFocus && (isRunning || isPaused);
        const lamp = document.getElementById('deskLampBadge');
        if (isDeskLightOn) {
            lamp.className = 'badge px-3 py-2 border rounded-pill bg-warning-subtle text-warning-emphasis border-warning shadow-sm';
            lamp.innerHTML = 'Masa Lambası: Yanıyor (Karakter Masada)';
        } else {
            lamp.className = 'badge px-3 py-2 border rounded-pill bg-light text-secondary';
            lamp.innerHTML = 'Masa Lambası: Sönük (Dinlenme Modu)';
        }

        const badgeMode = document.getElementById('badgeTimerMode');
        badgeMode.textContent = isFocus ? 'Odaklanma Modu' : 'Mola Modu';
        badgeMode.className = isFocus
            ? 'badge bg-primary-subtle text-primary border border-primary-subtle'
            : 'badge bg-success-subtle text-success border border-success-subtle';

        const roundText = `Tur ${session.currentRound} / ${session.targetRounds}`;
        document.getElementById('lblRoundProgress').textContent = roundText;
        document.getElementById('lblTimerStatus').textContent = session.status;
        document.getElementById('lblNetDuration').textContent = `${Math.floor(session.netDurationSeconds / 60)} dk ${session.netDurationSeconds % 60} sn`;

        totalPlannedSeconds = session.plannedMinutes * 60;
        remainingSeconds = session.remainingSeconds;

        clearInterval(timerInterval);
        renderTimerDisplay();

        if (isRunning && remainingSeconds > 0) {
            timerInterval = setInterval(() => {
                if (remainingSeconds > 0) {
                    remainingSeconds--;
                    renderTimerDisplay();
                } else {
                    clearInterval(timerInterval);
                    log(`Süre doldu! Seansı tamamlayabilirsiniz.`, 'warn');
                }
            }, 1000);
        }
    }

    function renderTimerDisplay() {
        const mins = Math.floor(remainingSeconds / 60);
        const secs = remainingSeconds % 60;
        document.getElementById('lblTimerDisplay').textContent =
            `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

        const progressPercent = totalPlannedSeconds > 0
            ? Math.max(0, Math.min(100, ((totalPlannedSeconds - remainingSeconds) / totalPlannedSeconds) * 100))
            : 0;
        document.getElementById('timerProgressBar').style.width = `${progressPercent}%`;
    }

    function updateTimerDisplay(remaining, total, statusText, modeText, roundText, lampOn) {
        remainingSeconds = remaining;
        totalPlannedSeconds = total;
        renderTimerDisplay();
        document.getElementById('lblTimerStatus').textContent = statusText;
        document.getElementById('badgeTimerMode').textContent = modeText;
        document.getElementById('lblRoundProgress').textContent = roundText;
        const lamp = document.getElementById('deskLampBadge');
        if (lampOn) {
            lamp.className = 'badge px-3 py-2 border rounded-pill bg-warning-subtle text-warning-emphasis border-warning shadow-sm';
            lamp.innerHTML = 'Masa Lambası: Yanıyor';
        } else {
            lamp.className = 'badge px-3 py-2 border rounded-pill bg-light text-secondary';
            lamp.innerHTML = 'Masa Lambası: Sönük';
        }
    }

    // Video Kontrolleri
    document.getElementById('btnToggleVideoPlay').addEventListener('click', () => {
        const btn = document.getElementById('btnToggleVideoPlay');
        if (videoPlayer.paused) {
            videoPlayer.play();
            btn.textContent = 'Durdur';
        } else {
            videoPlayer.pause();
            btn.textContent = 'Oynat';
        }
    });

    document.getElementById('btnToggleVideoMute').addEventListener('click', () => {
        const btn = document.getElementById('btnToggleVideoMute');
        if (videoPlayer.muted) {
            videoPlayer.muted = false;
            btn.textContent = 'Sessize Al';
        } else {
            videoPlayer.muted = true;
            btn.textContent = 'Ses Aç';
        }
    });

    // 1. AUTH
    document.getElementById('btnCreateGuest').addEventListener('click', async () => {
        const displayName = document.getElementById('guestDisplayName').value.trim();
        log(`POST ${apiBase}/api/v1/auth/guest gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/auth/guest`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ displayName: displayName || null })
            });
            if (res.ok) {
                const data = await res.json();
                log(`HTTP 201 Created: Misafir hesabı açıldı! ID: ${data.user.id}`, 'success');
                saveTokens(data.accessToken, data.refreshToken);
                updateSessionUI(data);
                document.getElementById('btnGetActiveSession').click();
            } else {
                log(`HTTP ${res.status}: Misafir hesabı açılamadı.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnGetMe').addEventListener('click', async () => {
        log(`GET ${apiBase}/api/v1/auth/me gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/auth/me`, {
                method: 'GET',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
                const user = await res.json();
                log(`HTTP 200 OK: Kullanıcı profili alındı! (${user.displayName})`, 'success');
                updateSessionUI({ user: user });
                document.getElementById('btnGetAvatar').click();
                document.getElementById('btnGetRoom').click();
                document.getElementById('btnGetActiveSession').click();
            } else {
                log(`HTTP ${res.status}: Profil getirilemedi.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnRefreshToken').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/auth/refresh gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/auth/refresh`, {
                method: 'POST',
                headers: getAuthHeaders(true),
                credentials: 'include',
                body: JSON.stringify({ refreshToken: currentTokens.refreshToken })
            });
            if (res.ok) {
                const tokens = await res.json();
                log(`HTTP 200 OK: Yeni token çifti alındı!`, 'success');
                saveTokens(tokens.accessToken, tokens.refreshToken);
                updateSessionUI({ tokens: tokens });
            } else {
                log(`HTTP ${res.status}: Token yenilenemedi.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnLogout').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/auth/logout gönderiliyor...`);
        try {
            await fetch(`${apiBase}/api/v1/auth/logout`, {
                method: 'POST',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            log(`HTTP 200 OK: Oturum güvenle kapatıldı.`, 'success');
            clearSessionUI();
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnTestReplay').addEventListener('click', async () => {
        if (!currentTokens.refreshToken) {
            log(`Replay testi için önce bir oturum açmalısınız!`, 'warn');
            return;
        }
        const stolenToken = currentTokens.refreshToken;
        log(`[Test] 1. İstek: Token yenileniyor...`);
        const res1 = await fetch(`${apiBase}/api/v1/auth/refresh`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ refreshToken: stolenToken })
        });
        if (res1.ok) {
            const newTokens = await res1.json();
            saveTokens(newTokens.accessToken, newTokens.refreshToken);
            log(`[Test] 1. İstek başarılı. Eski token ile 2. istek (Replay) yapılıyor...`, 'warn');
            const res2 = await fetch(`${apiBase}/api/v1/auth/refresh`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ refreshToken: stolenToken })
            });
            if (res2.status === 401) {
                log(`[Test Başarılı!] HTTP 401: Eski token tespit edildi ve zincirleme iptal edildi!`, 'success');
                clearSessionUI();
            } else {
                log(`[Uyarı] HTTP ${res2.status}: Beklenmedik yanıt.`, 'error');
            }
        }
    });

    // 2. AVATAR
    document.getElementById('btnGetAvatar').addEventListener('click', async () => {
        log(`GET ${apiBase}/api/v1/avatar gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/avatar`, {
                method: 'GET',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
                const avatar = await res.json();
                log(`HTTP 200 OK: Avatar bilgisi alındı!`, 'success');
                updateSessionUI({ avatar: avatar });
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnUpdateAvatar').addEventListener('click', async () => {
        const payload = {
            skinTone: document.getElementById('avSkinTone').value,
            hairStyle: document.getElementById('avHairStyle').value,
            hairColor: document.getElementById('avHairColor').value,
            topItemId: document.getElementById('avTopItem').value,
            bottomItemId: document.getElementById('avBottomItem').value,
            hatItemId: document.getElementById('avHatItem').value || null,
            clearHat: !document.getElementById('avHatItem').value
        };

        log(`PATCH ${apiBase}/api/v1/avatar gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/avatar`, {
                method: 'PATCH',
                headers: getAuthHeaders(true),
                credentials: 'include',
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                const avatar = await res.json();
                log(`HTTP 200 OK: Avatar güncellendi!`, 'success');
                updateSessionUI({ avatar: avatar });
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // 3. PIXEL ROOM
    document.getElementById('btnGetRoom').addEventListener('click', async () => {
        log(`GET ${apiBase}/api/v1/room gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/room`, {
                method: 'GET',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
