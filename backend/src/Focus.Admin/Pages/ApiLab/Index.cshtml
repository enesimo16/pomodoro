            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnAbandonSession').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/sessions/abandon (Masadan Kalk) gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/sessions/abandon`, {
                method: 'POST',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
                const session = await res.json();
                log(`HTTP 200 OK: Seans iptal edildi, karakter masadan kalktı. Lamba söndü.`, 'warn');
                updateTimerUI(session);
            } else {
                log(`HTTP ${res.status}: Masadan kalkılamadı.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnGetActiveSession').addEventListener('click', async () => {
        log(`GET ${apiBase}/api/v1/sessions/active gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/sessions/active`, {
                method: 'GET',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.status === 204) {
                log(`HTTP 204 No Content: Aktif bir seans bulunmuyor.`, 'info');
                updateTimerUI(null);
            } else if (res.ok) {
                const session = await res.json();
                log(`HTTP 200 OK: Aktif seans bulundu: ${session.kind}, ${session.status}, Kalan: ${session.remainingSeconds} sn`, 'success');
                updateTimerUI(session);
            } else {
                log(`HTTP ${res.status}: Seans bilgisi alınamadı.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // 5. MEDYA & DIŞ API TESTLERİ (FAZ 2)
    // Pixabay Video Arama
    document.getElementById('btnSearchThemes').addEventListener('click', async () => {
        const query = document.getElementById('pixabayQuery').value.trim() || 'rain window';
        log(`GET ${apiBase}/api/v1/media/themes?query=${encodeURIComponent(query)}&perPage=6 gönderiliyor...`);
        const container = document.getElementById('themesContainer');
        container.innerHTML = '<div class="text-center p-3 text-muted">Pixabay aranıyor...</div>';

        try {
            const res = await fetch(`${apiBase}/api/v1/media/themes?query=${encodeURIComponent(query)}&perPage=6`, {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' }
            });
            if (res.ok) {
                const videos = await res.json();
                log(`HTTP 200 OK: ${videos.length} adet tema videosu getirildi!`, 'success');
                container.innerHTML = '';
                videos.forEach(v => {
                    const card = document.createElement('div');
                    card.className = 'p-2 bg-light rounded border';
                    card.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-dark text-truncate" style="max-width: 200px;">${escapeHtml(v.tags)}</span>
                            <span class="badge bg-secondary-subtle text-secondary small">${v.duration} sn</span>
                        </div>
                        <video src="${v.mediumVideoUrl}" controls preload="none" poster="${v.thumbnailUrl}" style="width: 100%; max-height: 140px; border-radius: 4px; object-fit: cover;"></video>
                        <div class="mt-1 d-flex justify-content-between align-items-center">
                            <a href="${v.pageUrl}" target="_blank" class="small text-muted text-decoration-none">Pixabay Sayfası ↗</a>
                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" onclick="selectTheme('${escapeHtml(v.tags.split(',')[0].trim())}')">Temayı Seç</button>
                        </div>
                    `;
                    container.appendChild(card);
                });
            } else {
                container.innerHTML = `<div class="text-danger small p-2">HTTP ${res.status}: Video getirilemedi.</div>`;
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
            container.innerHTML = `<div class="text-danger small p-2">${err.message}</div>`;
        }
    });

    window.selectTheme = function(themeTag) {
        document.getElementById('sessionThemeId').value = themeTag;
        log(`Tema seçildi: ${themeTag}. Sayaç formuna aktarıldı.`, 'info');
        document.getElementById('tab-session-btn').click();
    };

    // Jamendo Lo-Fi Parçalar
    document.getElementById('btnGetLofiTracks').addEventListener('click', async () => {
        log(`GET ${apiBase}/api/v1/media/tracks?limit=6 gönderiliyor...`);
        const container = document.getElementById('tracksContainer');
        container.innerHTML = '<div class="text-center p-3 text-muted">Parçalar yükleniyor...</div>';

        try {
            const res = await fetch(`${apiBase}/api/v1/media/tracks?limit=6`, {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' }
            });
            if (res.ok) {
                const tracks = await res.json();
                log(`HTTP 200 OK: ${tracks.length} adet Lo-Fi parça listelendi!`, 'success');
                container.innerHTML = '';
                tracks.forEach(t => {
                    const card = document.createElement('div');
                    card.className = 'p-2 bg-light rounded border d-flex flex-column gap-1';
                    card.innerHTML = `
                        <div class="d-flex align-items-center gap-2">
                            ${t.imageUrl ? `<img src="${t.imageUrl}" style="width: 40px; height: 40px; border-radius: 4px; object-fit: cover;" />` : ''}
                            <div class="flex-grow-1 text-truncate">
                                <strong class="text-dark small d-block text-truncate">${escapeHtml(t.name)}</strong>
                                <span class="text-muted small">${escapeHtml(t.artistName)} (${t.duration} sn)</span>
                            </div>
                        </div>
                        <audio src="${t.audioUrl}" controls preload="none" class="w-100 mt-1" style="height: 32px;"></audio>
                    `;
                    container.appendChild(card);
                });
            } else {
                container.innerHTML = `<div class="text-danger small p-2">HTTP ${res.status}: Müzik parçaları getirilemedi.</div>`;
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
            container.innerHTML = `<div class="text-danger small p-2">${err.message}</div>`;
        }
    });

    // Open-Meteo Canlı Hava Durumu
    document.querySelectorAll('.btn-city').forEach(btn => {
        btn.addEventListener('click', (e) => {
            document.getElementById('weatherLat').value = e.target.getAttribute('data-lat');
            document.getElementById('weatherLon').value = e.target.getAttribute('data-lon');
            document.getElementById('btnGetWeather').click();
        });
    });

    document.getElementById('btnGetWeather').addEventListener('click', async () => {
        const lat = document.getElementById('weatherLat').value;
        const lon = document.getElementById('weatherLon').value;
        log(`GET ${apiBase}/api/v1/media/weather?latitude=${lat}&longitude=${lon} gönderiliyor...`);
        const container = document.getElementById('weatherReportContainer');
        container.innerHTML = 'Hava durumu çekiliyor...';

        try {
            const res = await fetch(`${apiBase}/api/v1/media/weather?latitude=${lat}&longitude=${lon}`, {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' }
            });
            if (res.ok) {
                const w = await res.json();
                log(`HTTP 200 OK: Canlı hava durumu alındı: ${w.temperature}°C, ${w.weatherCondition}, Önerilen Tema: ${w.suggestedTheme}`, 'success');
                container.className = 'p-3 bg-white rounded border text-start shadow-sm';
                container.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fs-4 fw-bold text-dark">${w.temperature}°C</span>
                        <span class="badge ${w.isDay ? 'bg-warning-subtle text-warning-emphasis' : 'bg-dark text-white'} border">
                            ${w.isDay ? '☀️ Gündüz' : '🌙 Gece'}
                        </span>
                    </div>
                    <div class="text-secondary small mb-1">Durum: <strong class="text-dark">${escapeHtml(w.weatherCondition)}</strong> (WMO: ${w.weatherCode})</div>
                    <div class="text-secondary small mb-2">Rüzgar Hızı: <strong class="text-dark">${w.windSpeed} km/s</strong></div>
                    <div class="p-2 bg-light rounded border d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Önerilen Piksel Tema: <strong class="text-primary">${escapeHtml(w.suggestedTheme)}</strong></span>
                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" onclick="selectTheme('${escapeHtml(w.suggestedTheme)}')">Temayı Bağla</button>
                    </div>
                `;
            } else {
                container.innerHTML = `<span class="text-danger">HTTP ${res.status}: Hava durumu alınamadı.</span>`;
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
            container.innerHTML = `<span class="text-danger">${err.message}</span>`;
        }
    });

    // Kopyalama & Genel Butonlar
    document.getElementById('btnCopyToken').addEventListener('click', () => {
        if (currentTokens.accessToken) {
            navigator.clipboard.writeText(currentTokens.accessToken).then(() => {
                log(`Access Token panoya kopyalandı.`, 'info');
            });
        }
    });

    document.getElementById('btnResetAll').addEventListener('click', () => {
        clearSessionUI();
        log(`Tüm yerel oturum verileri temizlendi.`, 'info');
    });

    document.getElementById('btnClearLog').addEventListener('click', () => {
        document.getElementById('terminalLog').innerHTML = '';
    });

    if (currentTokens.accessToken) {
        log(`Kayıtlı oturum tespit edildi. Profil sorgulanıyor...`, 'info');
        document.getElementById('btnGetMe').click();
    }
</script>
}
