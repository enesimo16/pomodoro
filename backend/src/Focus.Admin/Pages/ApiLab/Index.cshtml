@page
@model Focus.Admin.Pages.ApiLab.IndexModel
@{
    ViewData["Title"] = "API Test";
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">API Test Konsolu</h1>
        <p class="admin-page-subtitle">Tüm fazların uçtan uca interaktif test ve simülasyon laboratuvarı</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="polaris-badge polaris-badge-neutral px-3 py-2">
            Hedef API: <strong class="text-dark">@Model.WebApiBaseUrl</strong>
        </span>
        <button id="btnResetAll" class="polaris-btn polaris-btn-secondary polaris-btn-sm" title="Tüm yerel oturum verilerini temizle">
            Sıfırla
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- Sol Kolon: Kontroller ve Arama Sekmeleri -->
    <div class="col-lg-5">
        <!-- Sekme Başlıkları -->
        <ul class="nav nav-pills mb-3 gap-1 polaris-nav-pills" id="pills-tab" role="tablist">
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link active w-100 text-center py-2 small" id="tab-auth-btn" data-bs-toggle="pill" data-bs-target="#tab-auth" type="button" role="tab">1. Kimlik</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-avatar-btn" data-bs-toggle="pill" data-bs-target="#tab-avatar" type="button" role="tab">2. Avatar</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-room-btn" data-bs-toggle="pill" data-bs-target="#tab-room" type="button" role="tab">3. Oda</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-session-btn" data-bs-toggle="pill" data-bs-target="#tab-session" type="button" role="tab">4. Sayaç</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-media-btn" data-bs-toggle="pill" data-bs-target="#tab-media" type="button" role="tab">5. Medya</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-shop-btn" data-bs-toggle="pill" data-bs-target="#tab-shop" type="button" role="tab">6. Mağaza</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-stats-btn" data-bs-toggle="pill" data-bs-target="#tab-stats" type="button" role="tab">7. İstatistik</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-social-btn" data-bs-toggle="pill" data-bs-target="#tab-social" type="button" role="tab">8. Sosyal</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-coach-btn" data-bs-toggle="pill" data-bs-target="#tab-coach" type="button" role="tab">9. AI Koc</button>
            </li>
        </ul>

        <div class="tab-content" id="pills-tabContent">
            <!-- TAB 1: AUTH -->
            <div class="tab-pane fade show active" id="tab-auth" role="tabpanel">
                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Misafir Hesabı Aç</h6>
                    <div class="mb-2">
                        <input type="text" id="guestDisplayName" class="form-control" placeholder="Kullanıcı adı (İsteğe bağlı)" />
                    </div>
                    <button id="btnCreateGuest" class="btn btn-primary w-100">
                        Misafir Hesabı Aç (POST /auth/guest)
                    </button>
                </div>

                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Oturum & Token</h6>
                    <div class="d-grid gap-2">
                        <button id="btnGetMe" class="btn btn-outline-primary">
                            Profil Bilgisi Getir (GET /auth/me)
                        </button>
                        <button id="btnRefreshToken" class="btn btn-outline-secondary">
                            Token Yenile (POST /auth/refresh)
                        </button>
                        <button id="btnLogout" class="btn btn-outline-danger">
                            Çıkış Yap (POST /auth/logout)
                        </button>
                    </div>
                </div>

                <div class="card card-custom p-3">
                    <h6 class="fw-bold text-dark mb-2">Güvenlik Savunması</h6>
                    <button id="btnTestReplay" class="btn btn-outline-secondary w-100">
                        Replay Attack Simülasyonu
                    </button>
                </div>
            </div>

            <!-- TAB 2: AVATAR -->
            <div class="tab-pane fade" id="tab-avatar" role="tabpanel">
                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Avatar Bilgisi</h6>
                    <button id="btnGetAvatar" class="btn btn-outline-primary w-100">
                        Avatarımı Getir (GET /avatar)
                    </button>
                </div>

                <div class="card card-custom p-3">
                    <h6 class="fw-bold text-dark mb-2">Avatar Özelleştir (PATCH /avatar)</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Ten Rengi</label>
                            <select id="avSkinTone" class="form-select">
                                <option value="tone_1">Açık (Tone 1)</option>
                                <option value="tone_2">Buğday (Tone 2)</option>
                                <option value="tone_3">Esmer (Tone 3)</option>
                                <option value="tone_4">Koyu (Tone 4)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Saç Modeli</label>
                            <select id="avHairStyle" class="form-select">
                                <option value="messy_short">Kısa Dağınık</option>
                                <option value="buzz_cut">Asker Traşı</option>
                                <option value="ponytail">At Kuyruğu</option>
                                <option value="wavy_long">Uzun Dalgalı</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Saç Rengi</label>
                            <select id="avHairColor" class="form-select">
                                <option value="#1A1A1A">Siyah (#1A1A1A)</option>
                                <option value="#4A2E1B">Kahve (#4A2E1B)</option>
                                <option value="#C68642">Sarı (#C68642)</option>
                                <option value="#B22222">Kızıl (#B22222)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Üst Kıyafet</label>
                            <select id="avTopItem" class="form-select">
                                <option value="hoodie_gray">Gri Kapüşonlu</option>
                                <option value="tshirt_white">Beyaz Tişört</option>
                                <option value="sweater_warm">Sıcak Kazak</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Alt Kıyafet</label>
                            <select id="avBottomItem" class="form-select">
                                <option value="jeans_dark">Koyu Kot Pantolon</option>
                                <option value="jogger_black">Siyah Eşofman</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Şapka / Aksesuar</label>
                            <select id="avHatItem" class="form-select">
                                <option value="">(Şapka Yok)</option>
                                <option value="beanie_orange">Turuncu Bere</option>
                                <option value="cap_black">Siyah Kep</option>
                            </select>
                        </div>
                    </div>
                    <button id="btnUpdateAvatar" class="btn btn-outline-secondary w-100">
                        Görünümü Güncelle
                    </button>
                </div>
            </div>

            <!-- TAB 3: PIXEL ROOM -->
            <div class="tab-pane fade" id="tab-room" role="tabpanel">
                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Piksel Oda Bilgisi</h6>
                    <button id="btnGetRoom" class="btn btn-outline-primary w-100">
                        Odamı Getir (GET /room)
                    </button>
                </div>

                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Odaya Eşya Ekle (POST /room/items)</h6>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Katalog Eşyası</label>
                        <select id="roomCatalogItem" class="form-select">
                            <option value="plant_bonsai">Bonsai Bitkisi (1x1)</option>
                            <option value="neon_sign_focus">Neon "FOCUS" Tabelası (2x1)</option>
                            <option value="record_player_vintage">Retro Plak Çalar (1x1)</option>
                            <option value="bookshelf_wood">Ahşap Kitaplık (2x1)</option>
                            <option value="coffee_machine">Espresso Kahve Makinesi (1x1)</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small text-muted mb-1">Grid X</label>
                            <input type="number" id="roomGridX" class="form-control" value="3" min="0" max="10" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted mb-1">Grid Y</label>
                            <input type="number" id="roomGridY" class="form-control" value="3" min="0" max="10" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted mb-1">Yön (Rot)</label>
                            <select id="roomRotation" class="form-select">
                                <option value="0">0°</option>
                                <option value="90">90°</option>
                                <option value="180">180°</option>
                                <option value="270">270°</option>
                            </select>
                        </div>
                    </div>
                    <button id="btnAddRoomItem" class="btn btn-outline-secondary w-100">
                        Eşyayı Yerleştir
                    </button>
                </div>

                <div class="card card-custom p-3">
                    <h6 class="fw-bold text-dark mb-2">Oda Temasını Değiştir (PATCH /room/theme)</h6>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Duvar Kağıdı</label>
                            <select id="roomWallpaper" class="form-select">
                                <option value="wallpaper_brick_loft">Loft Tuğla</option>
                                <option value="wallpaper_slate_dark">Koyu Arduvaz</option>
                                <option value="wallpaper_wood_cozy">Sıcak Ahşap</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Zemin</label>
                            <select id="roomFloor" class="form-select">
                                <option value="floor_parquet_oak">Meşe Parke</option>
                                <option value="floor_tatami_japanese">Japon Tatami</option>
                                <option value="floor_marble_white">Beyaz Mermer</option>
                            </select>
                        </div>
                    </div>
                    <button id="btnUpdateTheme" class="btn btn-outline-secondary w-100">
                        Temayı Uygula
                    </button>
                </div>
            </div>

            <!-- TAB 4: SAYAÇ & DÖNGÜ (FAZ 2) -->
            <div class="tab-pane fade" id="tab-session" role="tabpanel">
                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Özelleştirilebilir Seans Başlat</h6>
                    <div class="text-muted small mb-3">İstediğiniz çalışma & mola dakikasını girin (Örn: 48 dk odak / 17 dk mola).</div>
                    
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Odaklanma Süresi (Dk)</label>
                            <input type="number" id="sessionFocusMin" class="form-control" value="48" min="1" max="180" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Mola Süresi (Dk)</label>
                            <input type="number" id="sessionBreakMin" class="form-control" value="17" min="1" max="60" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Hedef Tur Sayısı</label>
                            <input type="number" id="sessionTargetRounds" class="form-control" value="4" min="1" max="20" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Başlangıç Modu</label>
                            <select id="sessionKind" class="form-select">
                                <option value="Focus">Odaklanma (Focus)</option>
                                <option value="Break">Mola (Break)</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Seçili Tema</label>
                        <input type="text" id="sessionThemeId" class="form-control" value="rainy_window" placeholder="Örn: rainy_window, cozy_cloudy" />
                    </div>

                    <button id="btnStartSession" class="btn btn-primary w-100 fw-semibold">
                        Seansı Başlat (POST /api/v1/sessions)
                    </button>
                </div>

                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Aktif Seans Kontrolleri</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <button id="btnPauseSession" class="btn btn-outline-warning w-100">
                                Duraklat (POST /pause)
                            </button>
                        </div>
                        <div class="col-6">
                            <button id="btnResumeSession" class="btn btn-outline-success w-100">
                                Devam Et (POST /resume)
                            </button>
                        </div>
                    </div>
                    <div class="mb-2">
                        <button id="btnExtendSession" class="btn btn-outline-info w-100 text-dark">
                            +10 Dk Uzat (Flow Shield)
                        </button>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <button id="btnCompleteSession" class="btn btn-outline-primary w-100">
                                Bitir & Ödül Al
                            </button>
                        </div>
                        <div class="col-6">
                            <button id="btnAbandonSession" class="btn btn-outline-danger w-100">
                                Masadan Kalk
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card card-custom p-3">
                    <button id="btnGetActiveSession" class="btn btn-outline-secondary w-100">
                        Aktif Seansı Sorgula (GET /api/v1/sessions/active)
                    </button>
                </div>
            </div>

            <!-- TAB 5: MEDYA & DIŞ API'LER (FAZ 2) -->
            <div class="tab-pane fade" id="tab-media" role="tabpanel">
                <!-- 1. Pixabay Video Arama -->
                <div class="card card-custom p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0">Pixabay HD Arka Plan Temaları</h6>
                        <span class="badge bg-success-subtle text-success border">Video API</span>
                    </div>
                    <div class="input-group mb-2">
                        <input type="text" id="pixabayQuery" class="form-control" value="rain window" placeholder="İstediğiniz temayı yazın..." />
                        <button id="btnSearchThemes" class="btn btn-primary px-3">Ara</button>
                    </div>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-theme-chip" data-q="rain window">Yağmur</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-theme-chip" data-q="cozy cafe coffee">Sıcak Kafe</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-theme-chip" data-q="fireplace burning">Şömine</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-theme-chip" data-q="night city tokyo">Gece Şehri</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-theme-chip" data-q="forest nature calm">Doğa & Orman</button>
                    </div>
                    <div id="themesContainer" class="d-flex flex-column gap-2" style="max-height: 250px; overflow-y: auto;">
                        <span class="text-muted small text-center p-3 bg-light rounded">Aramak için yukarıdan "Ara" butonuna tıklayınız.</span>
                    </div>
                </div>

                <!-- 2. Jamendo & Lo-Fi Müzik Arama -->
                <div class="card card-custom p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0">Jamendo & Lo-Fi Plak Çalar</h6>
                        <span class="badge bg-info-subtle text-info border">Müzik API</span>
                    </div>
                    <div class="input-group mb-2">
                        <input type="text" id="musicQuery" class="form-control" value="lofi" placeholder="Parça, sanatçı veya müzik türü..." />
                        <button id="btnSearchMusic" class="btn btn-outline-primary px-3">Parça Ara</button>
                    </div>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-music-chip" data-q="lofi">Lo-Fi</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-music-chip" data-q="piano">Piyano</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-music-chip" data-q="chillhop">Chillhop</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-music-chip" data-q="ambient">Ambiyans</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-music-chip" data-q="jazz">Caz</button>
                    </div>
                    <div id="tracksContainer" class="d-flex flex-column gap-2" style="max-height: 250px; overflow-y: auto;">
                        <span class="text-muted small text-center p-3 bg-light rounded">Parçaları listelemek için "Parça Ara"ya basınız.</span>
                    </div>
                </div>

                <!-- 3. Open-Meteo & Hava Durumu Simülatörü -->
                <div class="card card-custom p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0">Hava Durumu Senkronu & Simülatörü</h6>
                        <span class="badge bg-secondary-subtle text-secondary border">Hava Senkronu</span>
                    </div>
                    
                    <!-- Canlı Şehirler -->
                    <label class="form-label small text-muted mb-1">Canlı Şehir Seçimi:</label>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill btn-city py-1" data-lat="41.0082" data-lon="28.9784">İstanbul</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill btn-city py-1" data-lat="39.9334" data-lon="32.8597">Ankara</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill btn-city py-1" data-lat="38.4237" data-lon="27.1428">İzmir</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill btn-city py-1" data-lat="51.5074" data-lon="-0.1278">Londra</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill btn-city py-1" data-lat="35.6762" data-lon="139.6503">Tokyo</button>
                    </div>

                    <!-- Farklı Hava Durumu Tepkisi Simülatörü -->
                    <label class="form-label small text-muted mb-1">Tüm Hava Durumu Tepkilerini Canlı Test Edin:</label>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-warning btn-weather-sim" data-code="0">Güneşli</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-weather-sim" data-code="2">Parçalı</button>
                        <button type="button" class="btn btn-sm btn-outline-dark btn-weather-sim" data-code="3">Kapalı</button>
                        <button type="button" class="btn btn-sm btn-outline-primary btn-weather-sim" data-code="61">Yağmurlu</button>
                        <button type="button" class="btn btn-sm btn-outline-danger btn-weather-sim" data-code="95">Fırtınalı</button>
                        <button type="button" class="btn btn-sm btn-outline-info btn-weather-sim" data-code="71">Karlı</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-weather-sim" data-code="45">Sisli</button>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <input type="text" id="weatherLat" class="form-control form-control-sm" value="41.0082" placeholder="Enlem" />
                        </div>
                        <div class="col-6">
                            <input type="text" id="weatherLon" class="form-control form-control-sm" value="28.9784" placeholder="Boylam" />
                        </div>
                    </div>
                    <button id="btnGetWeather" class="btn btn-outline-secondary btn-sm w-100">
                        Canlı Koordinattan Çek (GET /api/v1/media/weather)
                    </button>
                </div>
            </div>

            <!-- TAB 6: MAĞAZA & ENVANTER (FAZ 3) -->
            <div class="tab-pane fade" id="tab-shop" role="tabpanel">
                <div class="card card-custom p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0">Focus Mağazası & Katalog</h6>
                        <span class="badge bg-primary-subtle text-primary border">Faz 3 Ekonomi</span>
                    </div>

                    <!-- Kategori ve Filtreler -->
                    <div class="row g-2 mb-2">
                        <div class="col-7">
                            <select id="shopCategoryFilter" class="form-select form-select-sm">
                                <option value="">Tüm Kategoriler (35+ Eşya)</option>
                                <option value="Desk">Çalışma Masaları</option>
                                <option value="Chair">Koltuk & Sandalyeler</option>
                                <option value="Furniture">Mobilya, Bitki & Lambalar</option>
                                <option value="Clothing">Kıyafetler</option>
                                <option value="Accessory">Aksesuarlar & Şapkalar</option>
                                <option value="Wallpaper">Duvar Kağıtları</option>
                                <option value="Floor">Zemin Kaplamaları</option>
                            </select>
                        </div>
                        <div class="col-5">
                            <input type="text" id="shopSearchFilter" class="form-control form-control-sm" placeholder="Eşya ara..." />
                        </div>
                    </div>

                    <div class="d-flex gap-2 mb-2">
                        <button id="btnGetCatalog" class="btn btn-primary btn-sm flex-fill">
                            Kataloğu Getir (GET /shop/catalog)
                        </button>
                        <button id="btnGetInventory" class="btn btn-outline-secondary btn-sm flex-fill">
                            Envanterimi Getir (GET /shop/inventory)
                        </button>
                    </div>

                    <!-- Dondurucu Satın Alma Kartı -->
                    <div class="p-2 border rounded bg-light d-flex justify-content-between align-items-center mt-2">
                        <div>
