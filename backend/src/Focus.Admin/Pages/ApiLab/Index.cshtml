    async function fetchLiveStreak() {
        if (!currentTokens.accessToken) return;
        try {
            const res = await fetch(`${apiBase}/api/v1/streak`, {
                headers: getAuthHeaders(false)
            });
            if (res.ok) {
                const s = await res.json();
                document.getElementById('lblLiveStreak').textContent = `${s.currentStreak} Gün`;
                document.getElementById('lblLiveFreezes').textContent = `${s.freezesAvailable} / 2 Hak`;
                const badge = document.getElementById('lblStreakStatusBadge');
                if (s.isActiveToday) {
                    badge.textContent = 'Bugün Tamamlandı';
                    badge.className = 'badge bg-success-subtle text-success small mt-1';
                } else if (s.isStreakAtRisk) {
                    badge.textContent = 'Seri Tehlikede!';
                    badge.className = 'badge bg-danger-subtle text-danger small mt-1';
                } else {
                    badge.textContent = 'Bugün Yapılmadı';
                    badge.className = 'badge bg-secondary-subtle text-secondary small mt-1';
                }
                return s;
            }
        } catch (e) {
            console.error('Streak fetch error:', e);
        }
    }

