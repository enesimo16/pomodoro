    // 6. HAVA DURUMU SENKRONU & SİMÜLASYONU
    async function fetchWeather(lat, lon, simCode = null) {
        let url = `${apiBase}/api/v1/media/weather?latitude=${lat}&longitude=${lon}`;
        if (simCode !== null) {
            url += `&weatherCode=${simCode}`;
            log(`[Simülasyon] WMO Kodu ${simCode} ile hava durumu sorgulanıyor...`);
        } else {
            log(`GET ${url} gönderiliyor...`);
        }

        try {
            const res = await fetch(url);
            if (res.ok) {
                const w = await res.json();
                log(`HTTP 200 OK: Hava Durumu: ${w.temperature}°C, ${w.weatherCondition} • Önerilen Tema: ${w.suggestedTheme}`, 'success');

                // Sağdaki Önizleme Stüdyosunu Güncelle
                document.getElementById('previewWeatherBadge').textContent = `${w.weatherCondition} • ${w.temperature}°C`;
                document.getElementById('previewWindowEffectBadge').textContent = w.windowEffect;
                document.getElementById('previewAtmosphereDesc').textContent = w.description;
                document.getElementById('previewSoundscapeDesc').textContent = `Ambiyans Tavsiyesi: ${w.soundscapeRecommendation}`;

                // Odanın aydınlatma rengini uygula (border glow)
                const studioCard = document.getElementById('studioPreviewCard');
                studioCard.style.borderTopColor = '#202223';
                studioCard.style.boxShadow = 'var(--p-shadow-card)';

                // Otomatik olarak uygun temayı arat
                if (w.suggestedTheme === 'rainy_window') {
                    document.getElementById('pixabayQuery').value = 'rain window';
                } else if (w.suggestedTheme === 'snowy_cabin') {
                    document.getElementById('pixabayQuery').value = 'snow winter';
                } else if (w.suggestedTheme === 'thunder_room') {
                    document.getElementById('pixabayQuery').value = 'storm rain lightning';
                } else if (w.suggestedTheme === 'sunny_loft') {
                    document.getElementById('pixabayQuery').value = 'sunny morning';
                } else if (w.suggestedTheme === 'foggy_morning') {
                    document.getElementById('pixabayQuery').value = 'fog morning nature';
                }
            } else {
                log(`HTTP ${res.status}: Hava durumu alınamadı.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    }

