    // 8. SOSYAL ÇALIŞMA & ORTAK ODALAR (FAZ 4)
    async function connectToRoomHub(roomCode) {
        if (typeof signalR === 'undefined') {
            log(`SignalR kütüphanesi yüklenemedi.`, 'warn');
            return;
        }

        if (roomHubConn) {
            try {
                await roomHubConn.stop();
            } catch (e) { }
        }

        roomHubConn = new signalR.HubConnectionBuilder()
            .withUrl(`${apiBase}/hubs/room`, {
                accessTokenFactory: () => currentTokens.accessToken || ''
            })
            .withAutomaticReconnect()
            .build();

        roomHubConn.on("UserJoinedRoom", (member) => {
            log(`SignalR: ${member.displayName} odaya katıldı. (Seviye ${member.level})`, 'info');
            if (member.seatIndex) {
                markSeat(member.seatIndex, member.userId === currentUserId, member.displayName);
            }
        });

        roomHubConn.on("UserLeftRoom", (userId) => {
            log(`SignalR: Bir kullanıcı odadan ayrıldı.`, 'info');
            document.querySelectorAll('.btn-seat').forEach(btn => {
                if (btn.dataset.userId === userId) {
                    resetSeatBtn(btn);
                }
            });
        });

        roomHubConn.on("SeatOccupied", (userId, seatIndex) => {
            log(`SignalR: Masa ${seatIndex} tutuldu.`, 'info');
            markSeat(seatIndex, userId === currentUserId, userId === currentUserId ? 'Siz' : 'Kullanıcı');
        });

        roomHubConn.on("SeatVacated", (userId, seatIndex) => {
            log(`SignalR: Masa ${seatIndex} boşaldı.`, 'info');
            const btn = document.querySelector(`.btn-seat[data-seat="${seatIndex}"]`);
            if (btn) resetSeatBtn(btn);
        });

        roomHubConn.on("CoWorkingBonusUpdated", (bonusPercent) => {
            log(`SignalR: Ortak çalışma odak bonusu güncellendi: %${bonusPercent}`, 'success');
            const badge = document.getElementById('lblCoWorkingBonusBadge');
            badge.textContent = `Ortak Bonus: %${bonusPercent}`;
            badge.className = bonusPercent > 0 ? 'badge bg-success text-white border' : 'badge bg-warning-subtle text-dark border';
        });

        roomHubConn.on("ReactionBroadcasted", (r) => {
            log(`SignalR Reaksiyon: ${r.displayName} -> ${r.reaction}`, 'info');
            const banner = document.getElementById('liveReactionBanner');
            const bannerText = document.getElementById('lblLiveReactionText');
            bannerText.textContent = `${r.displayName}: ${r.reaction}`;
            banner.style.display = 'block';
            setTimeout(() => { banner.style.display = 'none'; }, 4000);
        });

        try {
            await roomHubConn.start();
            await roomHubConn.invoke("JoinRoomGroup", roomCode);
            log(`SignalR: '${roomCode}' odası canlı akışına bağlandı.`, 'success');
        } catch (err) {
            log(`SignalR Bağlantı Hatası: ${err.message}`, 'error');
        }
    }

    function resetSeatBtn(btn) {
        const s = btn.dataset.seat;
        btn.className = 'btn btn-outline-secondary btn-sm w-100 py-2 btn-seat';
