    window.joinStudyRoom = async function(roomCode, inviteCode = null) {
        if (!currentTokens.accessToken) {
            log(`Odaya katılmak için oturum açmalısınız.`, 'warning');
            return;
        }

        log(`POST ${apiBase}/api/v1/study-rooms/join (${roomCode})...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/study-rooms/join`, {
                method: 'POST',
                headers: getAuthHeaders(true),
                body: JSON.stringify({ roomCode, inviteCode })
            });

            const data = await res.json();
            if (res.ok && data.success) {
                currentRoomCode = data.room.code;
                log(`HTTP 200 OK: '${data.room.name}' (${data.room.code}) odasına girildi!`, 'success');

                document.getElementById('lblCurrentRoomName').textContent = `Oda: ${data.room.name} (${data.room.code})`;
                const bonusBadge = document.getElementById('lblCoWorkingBonusBadge');
                bonusBadge.textContent = `Ortak Bonus: %${data.room.coWorkingBonusPercent}`;
                bonusBadge.className = data.room.coWorkingBonusPercent > 0 ? 'badge bg-success text-white border' : 'badge bg-warning-subtle text-dark border';

                // Masaları temizle ve mevcut oturanları işaretle
                document.querySelectorAll('.btn-seat').forEach(btn => resetSeatBtn(btn));
                if (data.room.members) {
                    data.room.members.forEach(m => {
                        if (m.seatIndex) {
                            markSeat(m.seatIndex, m.userId === currentUserId, m.displayName);
                        }
                    });
                }

                // Canlı SignalR bağlantısı kur
                await connectToRoomHub(currentRoomCode);
            } else {
                log(`Odaya Giriş Başarısız: ${data.message || 'Hata'}`, 'error');
                if (data.message && data.message.includes('Pro')) {
                    alert(`Oda Kapasite Uyarısı: ${data.message}`);
                }
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    };

