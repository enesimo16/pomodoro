                updateTimerUI(session);
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnCompleteSession').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/sessions/complete gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/sessions/complete`, {
                method: 'POST',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
                const data = await res.json();
                log(`HTTP 200 OK: Seans tamamlandı! +${data.xpEarned} XP, +${data.coinsEarned} Focus Coin kazanıldı! Sıradaki: ${data.nextKind} (Tur ${data.nextRound})`, 'success');
                updateTimerUI(data.session);
                document.getElementById('btnGetMe').click();
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnAbandonSession').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/sessions/abandon gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/sessions/abandon`, {
                method: 'POST',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
                const session = await res.json();
                log(`HTTP 200 OK: Seans iptal edildi, karakter masadan kalktı, lamba söndü.`, 'warn');
                updateTimerUI(session);
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnGetActiveSession').addEventListener('click', async () => {
        log(`GET ${apiBase}/api/v1/sessions/active gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/sessions/active`, {
                method: 'GET',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.status === 204) {
                log(`HTTP 204 No Content: Aktif seans yok.`, 'info');
                updateTimerUI(null);
            } else if (res.ok) {
                const session = await res.json();
                log(`HTTP 200 OK: Aktif seans bulundu: ${session.kind}, ${session.status}, Kalan: ${session.remainingSeconds} sn`, 'success');
                updateTimerUI(session);
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // 5. MEDYA ARAMALARI VE SAĞDAKİ ÖNİZLEMEYE AKTARIM
    // Hızlı Tema Chip'leri
    document.querySelectorAll('.btn-theme-chip').forEach(btn => {
        btn.addEventListener('click', (e) => {
            document.getElementById('pixabayQuery').value = e.target.getAttribute('data-q');
            document.getElementById('btnSearchThemes').click();
        });
    });

    document.getElementById('btnSearchThemes').addEventListener('click', async () => {
        const query = document.getElementById('pixabayQuery').value.trim() || 'rain window';
        log(`GET ${apiBase}/api/v1/media/themes?query=${encodeURIComponent(query)}&perPage=6 aranıyor...`);
        const container = document.getElementById('themesContainer');
        container.innerHTML = '<div class="text-center p-3 text-muted">Pixabay HD videoları aranıyor...</div>';

        try {
            const res = await fetch(`${apiBase}/api/v1/media/themes?query=${encodeURIComponent(query)}&perPage=6`);
            if (res.ok) {
                const videos = await res.json();
                log(`HTTP 200 OK: ${videos.length} adet tema videosu bulundu!`, 'success');
                container.innerHTML = '';
                videos.forEach((v, idx) => {
                    const card = document.createElement('div');
                    card.className = 'p-2 bg-light rounded border';
                    const safeTag = escapeHtml(v.tags.split(',')[0].trim());
                    card.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-dark text-truncate" style="max-width: 220px;">${escapeHtml(v.tags)}</span>
                            <span class="badge bg-secondary-subtle text-secondary small">${v.duration} sn</span>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <img src="${v.thumbnailUrl || 'https://images.unsplash.com/photo-1519692933481-e162a57d6721?w=200'}" style="width: 80px; height: 50px; border-radius: 4px; object-fit: cover;" />
                            <div class="flex-grow-1">
                                <button type="button" class="btn btn-sm btn-primary w-100 py-1" onclick="setPreviewTheme('${v.mediumVideoUrl}', '${safeTag}', '${v.thumbnailUrl}')">
                                    ▶ Sağda Oynat & Seç
                                </button>
                            </div>
                        </div>
                    `;
                    container.appendChild(card);

                    // Ilk sonucu otomatik sağdaki önizlemeye koy
                    if (idx === 0) {
                        setPreviewTheme(v.mediumVideoUrl, safeTag, v.thumbnailUrl);
                    }
                });
            } else {
                container.innerHTML = `<div class="text-danger small p-2">HTTP ${res.status}: Video getirilemedi.</div>`;
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
            container.innerHTML = `<div class="text-danger small p-2">${err.message}</div>`;
        }
    });

    // Hızlı Müzik Chip'leri
    document.querySelectorAll('.btn-music-chip').forEach(btn => {
        btn.addEventListener('click', (e) => {
            document.getElementById('musicQuery').value = e.target.getAttribute('data-q');
            document.getElementById('btnSearchMusic').click();
        });
    });

    document.getElementById('btnSearchMusic').addEventListener('click', async () => {
        const query = document.getElementById('musicQuery').value.trim() || 'lofi';
        log(`GET ${apiBase}/api/v1/media/tracks?query=${encodeURIComponent(query)}&limit=6 aranıyor...`);
        const container = document.getElementById('tracksContainer');
        container.innerHTML = '<div class="text-center p-3 text-muted">Parçalar aranıyor...</div>';

        try {
            const res = await fetch(`${apiBase}/api/v1/media/tracks?query=${encodeURIComponent(query)}&limit=6`);
            if (res.ok) {
                const tracks = await res.json();
                log(`HTTP 200 OK: "${query}" için ${tracks.length} parça listelendi!`, 'success');
                container.innerHTML = '';
                tracks.forEach((t, idx) => {
                    const card = document.createElement('div');
                    card.className = 'p-2 bg-light rounded border d-flex align-items-center justify-content-between gap-2';
                    const trackImg = t.imageUrl || 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=120';
                    card.innerHTML = `
                        <div class="d-flex align-items-center gap-2 text-truncate" style="max-width: 220px;">
                            <img src="${trackImg}" style="width: 36px; height: 36px; border-radius: 4px; object-fit: cover;" />
                            <div class="text-truncate">
                                <strong class="text-dark small d-block text-truncate">${escapeHtml(t.name)}</strong>
                                <span class="text-muted small">${escapeHtml(t.artistName)}</span>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-success py-1 px-2" onclick="setPreviewTrack('${t.audioUrl}', '${escapeHtml(t.name)}', '${escapeHtml(t.artistName)}', '${trackImg}')">
                            ▶ Çal
                        </button>
                    `;
                    container.appendChild(card);

                    // Ilk parçayı sağdaki plak çalara yükle
                    if (idx === 0) {
                        setPreviewTrack(t.audioUrl, t.name, t.artistName, trackImg);
                    }
                });
            } else {
                container.innerHTML = `<div class="text-danger small p-2">HTTP ${res.status}: Müzik parçaları getirilemedi.</div>`;
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
            container.innerHTML = `<div class="text-danger small p-2">${err.message}</div>`;
        }
    });

    // 6. HAVA DURUMU SENKRONU & SİMÜLASYONU
    async function fetchWeather(lat, lon, simCode = null) {
        let url = `${apiBase}/api/v1/media/weather?latitude=${lat}&longitude=${lon}`;
        if (simCode !== null) {
            url += `&weatherCode=${simCode}`;
            log(`[Simülasyon] WMO Kodu ${simCode} ile hava durumu sorgulanıyor...`);
        } else {
            log(`GET ${url} gönderiliyor...`);
        }

        try {
            const res = await fetch(url);
            if (res.ok) {
                const w = await res.json();
                log(`HTTP 200 OK: Hava Durumu: ${w.temperature}°C, ${w.weatherCondition} • Önerilen Tema: ${w.suggestedTheme}`, 'success');

                // Sağdaki Önizleme Stüdyosunu Güncelle
                document.getElementById('previewWeatherBadge').textContent = `${w.isDay ? '☀️' : '🌙'} ${w.weatherCondition} • ${w.temperature}°C`;
                document.getElementById('previewWindowEffectBadge').textContent = w.windowEffect;
                document.getElementById('previewAtmosphereDesc').textContent = w.description;
                document.getElementById('previewSoundscapeDesc').textContent = `🎵 Ambiyans Tavsiyesi: ${w.soundscapeRecommendation}`;

                // Odanın aydınlatma rengini uygula (border glow)
                const studioCard = document.getElementById('studioPreviewCard');
                studioCard.style.borderTopColor = w.roomLightingColor || '#2563eb';
                studioCard.style.boxShadow = `0 10px 25px -5px ${w.roomLightingColor}40`;

                // Otomatik olarak uygun temayı arat
                if (w.suggestedTheme === 'rainy_window') {
                    document.getElementById('pixabayQuery').value = 'rain window';
                } else if (w.suggestedTheme === 'snowy_cabin') {
                    document.getElementById('pixabayQuery').value = 'snow winter';
                } else if (w.suggestedTheme === 'thunder_room') {
                    document.getElementById('pixabayQuery').value = 'storm rain lightning';
                } else if (w.suggestedTheme === 'sunny_loft') {
                    document.getElementById('pixabayQuery').value = 'sunny morning';
                } else if (w.suggestedTheme === 'foggy_morning') {
                    document.getElementById('pixabayQuery').value = 'fog morning nature';
                }
            } else {
                log(`HTTP ${res.status}: Hava durumu alınamadı.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    }

    // Şehir Butonları
    document.querySelectorAll('.btn-city').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const lat = e.target.getAttribute('data-lat');
            const lon = e.target.getAttribute('data-lon');
            document.getElementById('weatherLat').value = lat;
            document.getElementById('weatherLon').value = lon;
            fetchWeather(lat, lon, null);
        });
    });

    // Hava Durumu Simülatör Butonları (Farklı tepkileri test etmek için)
    document.querySelectorAll('.btn-weather-sim').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const code = parseInt(e.target.getAttribute('data-code'));
            const lat = document.getElementById('weatherLat').value;
            const lon = document.getElementById('weatherLon').value;
            fetchWeather(lat, lon, code);
        });
    });

    document.getElementById('btnGetWeather').addEventListener('click', () => {
        const lat = document.getElementById('weatherLat').value;
        const lon = document.getElementById('weatherLon').value;
        fetchWeather(lat, lon, null);
    });

    // Kopyalama & Sıfırlama
    document.getElementById('btnCopyToken').addEventListener('click', () => {
        if (currentTokens.accessToken) {
            navigator.clipboard.writeText(currentTokens.accessToken).then(() => {
                log(`Access Token panoya kopyalandı.`, 'info');
            });
        }
    });

    document.getElementById('btnResetAll').addEventListener('click', () => {
        clearSessionUI();
        log(`Tüm yerel oturum verileri temizlendi.`, 'info');
    });

    document.getElementById('btnClearLog').addEventListener('click', () => {
        document.getElementById('terminalLog').innerHTML = '';
    });

    // Açılışta oturum varsa bilgileri çek
    if (currentTokens.accessToken) {
        log(`Kayıtlı oturum tespit edildi. Profil sorgulanıyor...`, 'info');
        document.getElementById('btnGetMe').click();
    }
</script>
}
