                            : '<span class="badge bg-primary-subtle text-primary border me-1">Kişisel</span>';
                        li.innerHTML = `
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div>${badgeType}<strong class="text-white">${escapeHtml(m.category)}</strong></div>
                                <span class="badge bg-secondary">Önem: ${m.importance}</span>
                            </div>
                            <div class="text-light" style="font-size: 11px;">${escapeHtml(m.content)}</div>
                        `;
                        usedList.appendChild(li);
                    });
                } else {
                    usedList.innerHTML = '<li class="list-group-item list-group-item-dark text-muted small p-2">RAG bağlamında ek hafıza çağrılmadı.</li>';
                }
            } else {
                appendCoachTerminalMessage('Sistem', `Hata: ${res.status} yanıt alınamadı.`, true);
                log(`HTTP ${res.status}: Koç servisi hata verdi.`, 'error');
            }
        } catch (err) {
            appendCoachTerminalMessage('Sistem', `Bağlantı Hatası: ${err.message}`, true);
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('txtCoachMessage').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
            document.getElementById('btnSendCoachChat').click();
        }
    });

    // Seans Başı Check-In Gönder
    document.getElementById('btnSubmitCheckIn').addEventListener('click', async () => {
        if (!currentTokens.accessToken) {
            log(`Check-In yapmak için oturum açmalısınız.`, 'warning');
            return;
        }

        const mood = document.getElementById('checkInMood').value;
        const energy = parseInt(document.getElementById('checkInEnergy').value);
        const target = document.getElementById('checkInTarget').value.trim();

        log(`POST ${apiBase}/api/v1/coach/check-in (${mood}, Enerji: ${energy})...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/coach/check-in`, {
                method: 'POST',
                headers: getAuthHeaders(true),
                body: JSON.stringify({
                    sessionId: activeSession ? activeSession.id : null,
                    mood: mood,
                    energyLevel: energy,
                    targetIntent: target || null
                })
            });

            if (res.ok) {
                const data = await res.json();
                log(`HTTP 200 OK: Check-In kaydedildi (ID: ${data.id})`, 'success');
                appendCoachTerminalMessage('Masa Asistanı', `Seans başı niyetin alındı (${mood}, Enerji: ${energy}/5). İyi odaklanmalar!`, true);
                document.getElementById('checkInTarget').value = '';
            } else {
                log(`HTTP ${res.status}: Check-In kaydedilemedi.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // Seans Sonu Değerlendirme (Reflection) Gönder
    document.getElementById('btnSubmitReflection').addEventListener('click', async () => {
        if (!currentTokens.accessToken) {
            log(`Değerlendirme göndermek için oturum açmalısınız.`, 'warning');
            return;
        }

        const quality = parseInt(document.getElementById('refFocusQuality').value);
        const moodAfter = document.getElementById('refMoodAfter').value;
        const note = document.getElementById('refNote').value.trim();

        log(`POST ${apiBase}/api/v1/coach/reflection (Kalite: ${quality}, ${moodAfter})...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/coach/reflection`, {
                method: 'POST',
                headers: getAuthHeaders(true),
                body: JSON.stringify({
                    sessionId: activeSession ? activeSession.id : null,
                    focusQuality: quality,
                    moodAfter: moodAfter,
                    distractionOrLearningNotes: note || null
                })
            });

            if (res.ok) {
                const data = await res.json();
                log(`HTTP 200 OK: Değerlendirme kaydedildi, kişisel hafızaya işlendi.`, 'success');
                appendCoachTerminalMessage('Masa Asistanı', `Seans tamamlandı! Notların kişisel hafızana ve anonimleştirilerek kolektif deneyim havuzuna işlendi.`, true);
                document.getElementById('refNote').value = '';
                // Hafızayı otomatik yenile
                document.getElementById('btnListMemories').click();
            } else {
                log(`HTTP ${res.status}: Değerlendirme kaydedilemedi.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // Anomali ve Yorgunluk Durumu Sorgula
    document.getElementById('btnCheckAnomaly').addEventListener('click', async () => {
        if (!currentTokens.accessToken) {
            log(`Anomali tanısı için oturum açmalısınız.`, 'warning');
            return;
        }

        log(`GET ${apiBase}/api/v1/coach/anomaly-status...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/coach/anomaly-status`, { headers: getAuthHeaders(false) });
            if (res.ok) {
                const s = await res.json();
                log(`HTTP 200 OK: Yorgunluk: ${s.dailyFatigueScore}/100, Haftalık: ${(s.weeklyFocusMinutes / 60).toFixed(1)} saat, Anomali: ${s.hasAnomaly}`, 'success');

                document.getElementById('lblDailyFatigueScore').textContent = `${s.dailyFatigueScore} / 100`;
                document.getElementById('lblWeeklyFocusHours').textContent = `${(s.weeklyFocusMinutes / 60).toFixed(1)} Saat`;
                document.getElementById('lblDaysSinceLastSession').textContent = `${s.daysSinceLastSession} Gün`;

                const box = document.getElementById('boxAnomalyNotice');
                if (s.hasAnomaly) {
                    box.className = 'alert alert-warning py-2 px-3 small mb-0';
                    box.innerHTML = `<strong>Anomali Tespit Edildi (${escapeHtml(s.anomalyType)}):</strong> ${escapeHtml(s.guidancePrompt || s.recommendedAction || '')}`;
                } else {
                    box.className = 'alert alert-success py-2 px-3 small mb-0';
                    box.innerHTML = '<strong>Ritim Dengeli:</strong> Çalışma yükü ve dinlenme periyotları optimal seviyede.';
                }
            } else {
                log(`HTTP ${res.status}: Anomali durumu alınamadı.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // Çift Katmanlı Vektör Hafızasını Listele
    document.getElementById('btnListMemories').addEventListener('click', async () => {
        if (!currentTokens.accessToken) {
            log(`Hafıza kayıtlarını görmek için oturum açmalısınız.`, 'warning');
            return;
        }

        log(`GET ${apiBase}/api/v1/coach/memories?limit=15...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/coach/memories?limit=15`, { headers: getAuthHeaders(false) });
            if (res.ok) {
                const list = await res.json();
                log(`HTTP 200 OK: ${list.length} adet hafıza girdisi listelendi.`, 'success');

                const container = document.getElementById('memoriesContainer');
                container.innerHTML = '';
                if (list.length === 0) {
                    container.innerHTML = '<div class="text-center py-3 text-muted small">Henüz hafıza kaydı bulunmuyor.</div>';
                    return;
                }

                list.forEach(m => {
                    const card = document.createElement('div');
                    card.className = 'p-2 bg-light rounded border';
                    const badgeLayer = m.isGlobal
                        ? '<span class="badge bg-success-subtle text-success border me-1">Kolektif Global</span>'
                        : '<span class="badge bg-primary-subtle text-primary border me-1">Kişisel</span>';

                    card.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div>
                                ${badgeLayer}
                                <strong class="small text-dark">${escapeHtml(m.category)}</strong>
                            </div>
                            <span class="badge bg-secondary small">Önem: ${m.importance}/10</span>
                        </div>
                        <div class="small text-secondary mb-1" style="font-size: 12px;">${escapeHtml(m.content)}</div>
                        <div class="text-muted text-end" style="font-size: 10px;">${new Date(m.createdAt).toLocaleString()}</div>
                    `;
                    container.appendChild(card);
                });
            } else {
                log(`HTTP ${res.status}: Hafıza listesi alınamadı.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // Kopyalama & Sıfırlama
    document.getElementById('btnCopyToken').addEventListener('click', () => {
        if (currentTokens.accessToken) {
            navigator.clipboard.writeText(currentTokens.accessToken).then(() => {
                log(`Access Token panoya kopyalandı.`, 'info');
            });
        }
    });

    document.getElementById('btnResetAll').addEventListener('click', () => {
        clearSessionUI();
        log(`Tüm yerel oturum verileri temizlendi.`, 'info');
    });

    document.getElementById('btnClearLog').addEventListener('click', () => {
        document.getElementById('terminalLog').innerHTML = '';
    });

    // Açılışta oturum varsa bilgileri çek
    if (currentTokens.accessToken) {
        log(`Kayıtlı oturum tespit edildi. Profil sorgulanıyor...`, 'info');
        document.getElementById('btnGetMe').click();
    }
</script>
}
