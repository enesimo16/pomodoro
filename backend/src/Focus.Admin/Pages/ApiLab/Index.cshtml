    window.removeItem = async function(itemId) {
        log(`DELETE ${apiBase}/api/v1/room/items/${itemId} gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/room/items/${itemId}`, {
                method: 'DELETE',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
                log(`HTTP 204 No Content: Eşya kaldırıldı.`, 'warn');
                document.getElementById('btnGetRoom').click();
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    };

    window.moveItemPrompt = async function(itemId, currX, currY, currRot) {
        const newX = prompt("Yeni Grid X (0-10):", currX);
        if (newX === null) return;
        const newY = prompt("Yeni Grid Y (0-10):", currY);
        if (newY === null) return;
        const newRot = prompt("Yeni Yön (0, 90, 180, 270):", currRot);
        if (newRot === null) return;

        const payload = {
            gridX: parseInt(newX) || 0,
            gridY: parseInt(newY) || 0,
            rotation: parseInt(newRot) || 0
        };

        log(`PUT ${apiBase}/api/v1/room/items/${itemId} gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/room/items/${itemId}`, {
                method: 'PUT',
                headers: getAuthHeaders(true),
                credentials: 'include',
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                log(`HTTP 200 OK: Eşya konumu güncellendi!`, 'success');
                document.getElementById('btnGetRoom').click();
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    };

    // 4. SAYAÇ & DÖNGÜ (FAZ 2)
    document.getElementById('btnStartSession').addEventListener('click', async () => {
        const payload = {
            kind: document.getElementById('sessionKind').value,
            focusMinutes: parseInt(document.getElementById('sessionFocusMin').value) || 48,
            breakMinutes: parseInt(document.getElementById('sessionBreakMin').value) || 17,
            currentRound: 1,
            targetRounds: parseInt(document.getElementById('sessionTargetRounds').value) || 4,
            themeId: document.getElementById('sessionThemeId').value || 'rainy_window'
        };

        log(`POST ${apiBase}/api/v1/sessions gönderiliyor: (${payload.focusMinutes} dk odak / ${payload.breakMinutes} dk mola, ${payload.targetRounds} Tur)...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/sessions`, {
                method: 'POST',
                headers: getAuthHeaders(true),
                credentials: 'include',
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                const session = await res.json();
                log(`HTTP 201 Created: Seans başladı! Kalan: ${session.remainingSeconds} sn. Masa lambası yandı.`, 'success');
                updateTimerUI(session);
            } else {
                log(`HTTP ${res.status}: Seans başlatılamadı. Oturum açık mı?`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnPauseSession').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/sessions/pause gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/sessions/pause`, {
                method: 'POST',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
                const session = await res.json();
                log(`HTTP 200 OK: Seans duraklatıldı!`, 'warn');
                updateTimerUI(session);
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnResumeSession').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/sessions/resume gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/sessions/resume`, {
                method: 'POST',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
                const session = await res.json();
                log(`HTTP 200 OK: Seans devam ettiriliyor!`, 'success');
                updateTimerUI(session);
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnExtendSession').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/sessions/extend (+10 Dk) gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/sessions/extend`, {
                method: 'POST',
                headers: getAuthHeaders(true),
                credentials: 'include',
                body: JSON.stringify({ extraMinutes: 10 })
            });
            if (res.ok) {
                const session = await res.json();
