        if (res1.ok) {
            const newTokens = await res1.json();
            saveTokens(newTokens.accessToken, newTokens.refreshToken);
            log(`[Test] 1. İstek başarılı, token döndü. Şimdi ESKİ token ile 2. istek (Replay) yapılıyor...`, 'warn');
            const res2 = await fetch(`${apiBase}/api/v1/auth/refresh`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ refreshToken: stolenToken })
            });
            if (res2.status === 401) {
