    function getItemIcon(category) {
        const c = String(category).toLowerCase();
        if (c.includes('desk') || c === '1') return '[Masa]';
        if (c.includes('chair') || c === '2') return '[Koltuk]';
        if (c.includes('furniture') || c === '3') return '[Mobilya]';
        if (c.includes('clothing') || c === '4') return '[Kıyafet]';
        if (c.includes('accessory') || c === '5') return '[Aksesuar]';
        if (c.includes('wallpaper') || c === '6') return '[Duvar]';
        if (c.includes('floor') || c === '7') return '[Zemin]';
        return '[Eşya]';
