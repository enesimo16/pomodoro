@page
@model Focus.Admin.Pages.ApiLab.IndexModel
@{
    ViewData["Title"] = "API Test";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">API Test</h3>
    <span class="text-muted small">@Model.WebApiBaseUrl</span>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card card-custom p-4 mb-4">
            <h6 class="fw-bold text-dark mb-3">Misafir Girişi</h6>
            <div class="mb-3">
                <input type="text" id="guestDisplayName" class="form-control" placeholder="Kullanıcı Adı (İsteğe bağlı)" />
            </div>
            <button id="btnCreateGuest" class="btn btn-primary w-100">
                Misafir Hesabı Aç
            </button>
        </div>

        <div class="card card-custom p-4 mb-4">
            <h6 class="fw-bold text-dark mb-3">Profil ve Token</h6>
            <button id="btnGetMe" class="btn btn-outline-primary w-100 mb-2">
                Kullanıcı Bilgisini Getir (/me)
            </button>
            <button id="btnRefreshToken" class="btn btn-outline-secondary w-100">
                Token Yenile
            </button>
        </div>

        <div class="card card-custom p-4">
            <h6 class="fw-bold text-dark mb-3">Oturum</h6>
            <div class="d-flex gap-2">
                <button id="btnLogout" class="btn btn-outline-danger w-50">
                    Çıkış Yap
                </button>
                <button id="btnTestReplay" class="btn btn-outline-secondary w-50">
                    Replay Testi
                </button>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card card-custom p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">Aktif Oturum</h6>
                <span id="sessionStatusBadge" class="badge bg-light text-secondary border">Yok</span>
            </div>

            <div id="sessionEmptyAlert" class="text-muted small py-2">
                Aktif bir oturum bulunmuyor.
            </div>

            <div id="sessionContent" style="display: none;">
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <div class="p-2 rounded bg-light border">
                            <span class="small text-muted d-block">Kullanıcı</span>
                            <div id="lblDisplayName" class="fw-bold text-dark"></div>
                            <span id="lblUserType" class="badge bg-light text-secondary border mt-1"></span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded bg-light border">
                            <span class="small text-muted d-block">Seviye & Coin</span>
                            <div class="fw-bold text-dark"><span id="lblCoins"></span> Coin</div>
                            <span id="lblLevel" class="badge bg-light text-primary border mt-1"></span>
                        </div>
                    </div>
                </div>

                <div class="p-3 rounded bg-light border mb-3">
                    <span class="small text-muted d-block mb-1">Oda: <strong id="lblRoomName" class="text-dark"></strong></span>
                    <ul id="listRoomItems" class="small text-secondary mb-0 ps-3"></ul>
                </div>

                <div class="p-2 rounded bg-light border small text-truncate">
                    <span class="text-muted d-block">Access Token:</span>
                    <code id="lblTokenPreview" class="d-block text-secondary mt-1"></code>
                </div>
            </div>
        </div>

        <div class="card card-custom p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-uppercase fw-semibold text-muted">İstek Günlüğü</span>
                <button id="btnClearLog" class="btn btn-sm btn-link text-secondary text-decoration-none p-0">Temizle</button>
            </div>
            <div id="terminalLog" class="terminal-box">
[Sistem] API Test Alanı hazır. WebAPI: @Model.WebApiBaseUrl
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const apiBase = '@Model.WebApiBaseUrl';
    let currentTokens = {
        accessToken: null,
        refreshToken: null
    };

    function log(message, type = 'info') {
        const box = document.getElementById('terminalLog');
        const time = new Date().toLocaleTimeString();
        let color = '#0f172a';
        if (type === 'success') color = '#16a34a';
        if (type === 'error') color = '#dc2626';
        if (type === 'warn') color = '#d97706';

        const line = document.createElement('div');
        line.style.color = color;
        line.innerText = `[${time}] ${message}`;
        box.appendChild(line);
        box.scrollTop = box.scrollHeight;
    }

    function updateSessionUI(authData) {
        document.getElementById('sessionEmptyAlert').style.display = 'none';
        document.getElementById('sessionContent').style.display = 'block';

        const user = authData.user;
        const room = authData.room;

        document.getElementById('sessionStatusBadge').className = 'badge bg-success text-white';
        document.getElementById('sessionStatusBadge').innerText = 'Aktif';

        document.getElementById('lblDisplayName').innerText = user.displayName;
        document.getElementById('lblUserType').innerText = user.isGuest ? 'Misafir' : 'Kayıtlı';

        document.getElementById('lblLevel').innerText = `Seviye ${user.level} (${user.currentXp} XP)`;
        document.getElementById('lblCoins').innerText = authData.totalCoins !== undefined ? authData.totalCoins : (user.currentXp >= 0 ? '50' : '0');

        if (room) {
            document.getElementById('lblRoomName').innerText = room.name;
            const itemsList = document.getElementById('listRoomItems');
            itemsList.innerHTML = '';
            (room.items || []).forEach(item => {
                const li = document.createElement('li');
                li.innerText = `${item.catalogItemId} (${item.gridX}, ${item.gridY})`;
                itemsList.appendChild(li);
            });
        }

        if (authData.accessToken) {
            document.getElementById('lblTokenPreview').innerText = authData.accessToken.substring(0, 45) + '...';
        }
    }

    // 1. Misafir Girisi Testi
    document.getElementById('btnCreateGuest').addEventListener('click', async () => {
        const name = document.getElementById('guestDisplayName').value.trim();
        log(`POST ${apiBase}/api/v1/auth/guest çağrılıyor...`);

        try {
            const res = await fetch(`${apiBase}/api/v1/auth/guest`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ displayName: name || null })
            });

            const data = await res.json();
            if (res.ok) {
                log(`HTTP 200 OK: Misafir hesabı oluşturuldu. ID: ${data.user.id}`, 'success');
                currentTokens.accessToken = data.accessToken;
                currentTokens.refreshToken = data.refreshToken;
                updateSessionUI(data);
            } else {
                log(`Hata (${res.status}): ${JSON.stringify(data)}`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // 2. Profilimi Getir (/me) Testi
    document.getElementById('btnGetMe').addEventListener('click', async () => {
        log(`GET ${apiBase}/api/v1/auth/me çağrılıyor...`);

        const headers = {};
        if (currentTokens.accessToken) {
            headers['Authorization'] = `Bearer ${currentTokens.accessToken}`;
        }

        try {
            const res = await fetch(`${apiBase}/api/v1/auth/me`, {
                method: 'GET',
                headers: headers,
                credentials: 'include'
            });

            if (res.ok) {
                const data = await res.json();
                log(`HTTP 200 OK: Kullanıcı bilgisi doğrulandı: ${data.user.displayName}`, 'success');
                updateSessionUI(data);
            } else {
                log(`HTTP ${res.status}: Yetkisiz veya geçersiz token.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // 3. Token Refresh Testi
    document.getElementById('btnRefreshToken').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/auth/refresh çağrılıyor...`);

        try {
            const res = await fetch(`${apiBase}/api/v1/auth/refresh`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ refreshToken: currentTokens.refreshToken })
            });

            const data = await res.json();
            if (res.ok) {
                log(`HTTP 200 OK: Token başarıyla yenilendi.`, 'success');
                currentTokens.accessToken = data.accessToken;
                currentTokens.refreshToken = data.refreshToken;
                updateSessionUI(data);
            } else {
                log(`HTTP ${res.status}: ${JSON.stringify(data)}`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // 4. Logout Testi
    document.getElementById('btnLogout').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/auth/logout çağrılıyor...`);

        try {
            const res = await fetch(`${apiBase}/api/v1/auth/logout`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ refreshToken: currentTokens.refreshToken })
            });

            if (res.ok) {
                log(`HTTP 204 No Content: Çıkış yapıldı.`, 'warn');
                currentTokens.accessToken = null;
                currentTokens.refreshToken = null;
                document.getElementById('sessionStatusBadge').className = 'badge bg-light text-secondary border';
                document.getElementById('sessionStatusBadge').innerText = 'Yok';
                document.getElementById('sessionContent').style.display = 'none';
                document.getElementById('sessionEmptyAlert').style.display = 'block';
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // 5. Replay Attack Simülasyonu
    document.getElementById('btnTestReplay').addEventListener('click', async () => {
        const dummyStolenToken = "stolen_compromised_token_xyz_999";
        log(`Replay Testi: Geçersiz token gönderiliyor...`, 'warn');

        try {
            const res = await fetch(`${apiBase}/api/v1/auth/refresh`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ refreshToken: dummyStolenToken })
            });

            const data = await res.json();
            log(`HTTP ${res.status}: ${data.message || 'Yetkisiz erişim engellendi.'}`, res.status === 401 ? 'success' : 'error');
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnClearLog').addEventListener('click', () => {
        document.getElementById('terminalLog').innerHTML = '';
    });
</script>
}
