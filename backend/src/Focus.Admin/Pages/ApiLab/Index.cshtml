@page
@model Focus.Admin.Pages.ApiLab.IndexModel
@{
    ViewData["Title"] = "API Test";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="fw-bold mb-0 text-dark">API Test Konsolu</h4>
        <span class="text-muted small">Faz 0 (Auth), Faz 1 (Avatar & Piksel Oda) ve Faz 2 (Sayaç, Atmosferik Video, Lo-Fi Müzik & Hava Durumu)</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-secondary border px-3 py-2">
            Hedef API: <strong class="text-dark">@Model.WebApiBaseUrl</strong>
        </span>
        <button id="btnResetAll" class="btn btn-outline-secondary btn-sm" title="Tüm yerel oturum verilerini temizle">
            Sıfırla
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- Sol Kolon: Kontroller ve Arama Sekmeleri -->
    <div class="col-lg-5">
        <!-- Sekme Başlıkları -->
        <ul class="nav nav-pills mb-3 gap-1 bg-white p-1 rounded border" id="pills-tab" role="tablist">
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link active w-100 text-center py-2 small" id="tab-auth-btn" data-bs-toggle="pill" data-bs-target="#tab-auth" type="button" role="tab">1. Kimlik</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-avatar-btn" data-bs-toggle="pill" data-bs-target="#tab-avatar" type="button" role="tab">2. Avatar</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-room-btn" data-bs-toggle="pill" data-bs-target="#tab-room" type="button" role="tab">3. Oda</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-session-btn" data-bs-toggle="pill" data-bs-target="#tab-session" type="button" role="tab">4. Sayaç</button>
            </li>
            <li class="nav-item flex-fill" role="presentation">
                <button class="nav-link w-100 text-center py-2 small" id="tab-media-btn" data-bs-toggle="pill" data-bs-target="#tab-media" type="button" role="tab">5. Medya & API</button>
            </li>
        </ul>

        <div class="tab-content" id="pills-tabContent">
            <!-- TAB 1: AUTH -->
            <div class="tab-pane fade show active" id="tab-auth" role="tabpanel">
                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Misafir Hesabı Aç</h6>
                    <div class="mb-2">
                        <input type="text" id="guestDisplayName" class="form-control" placeholder="Kullanıcı adı (İsteğe bağlı)" />
                    </div>
                    <button id="btnCreateGuest" class="btn btn-primary w-100">
                        Misafir Hesabı Aç (POST /auth/guest)
                    </button>
                </div>

                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Oturum & Token</h6>
                    <div class="d-grid gap-2">
                        <button id="btnGetMe" class="btn btn-outline-primary">
                            Profil Bilgisi Getir (GET /auth/me)
                        </button>
                        <button id="btnRefreshToken" class="btn btn-outline-secondary">
                            Token Yenile (POST /auth/refresh)
                        </button>
                        <button id="btnLogout" class="btn btn-outline-danger">
                            Çıkış Yap (POST /auth/logout)
                        </button>
                    </div>
                </div>

                <div class="card card-custom p-3">
                    <h6 class="fw-bold text-dark mb-2">Güvenlik Savunması</h6>
                    <button id="btnTestReplay" class="btn btn-outline-secondary w-100">
                        Replay Attack Simülasyonu
                    </button>
                </div>
            </div>

            <!-- TAB 2: AVATAR -->
            <div class="tab-pane fade" id="tab-avatar" role="tabpanel">
                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Avatar Bilgisi</h6>
                    <button id="btnGetAvatar" class="btn btn-outline-primary w-100">
                        Avatarımı Getir (GET /avatar)
                    </button>
                </div>

                <div class="card card-custom p-3">
                    <h6 class="fw-bold text-dark mb-2">Avatar Özelleştir (PATCH /avatar)</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Ten Rengi</label>
                            <select id="avSkinTone" class="form-select">
                                <option value="tone_1">Açık (Tone 1)</option>
                                <option value="tone_2">Buğday (Tone 2)</option>
                                <option value="tone_3">Esmer (Tone 3)</option>
                                <option value="tone_4">Koyu (Tone 4)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Saç Modeli</label>
                            <select id="avHairStyle" class="form-select">
                                <option value="messy_short">Kısa Dağınık</option>
                                <option value="buzz_cut">Asker Traşı</option>
                                <option value="ponytail">At Kuyruğu</option>
                                <option value="wavy_long">Uzun Dalgalı</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Saç Rengi</label>
                            <select id="avHairColor" class="form-select">
                                <option value="#1A1A1A">Siyah (#1A1A1A)</option>
                                <option value="#4A2E1B">Kahve (#4A2E1B)</option>
                                <option value="#C68642">Sarı (#C68642)</option>
                                <option value="#B22222">Kızıl (#B22222)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Üst Kıyafet</label>
                            <select id="avTopItem" class="form-select">
                                <option value="hoodie_gray">Gri Kapüşonlu</option>
                                <option value="tshirt_white">Beyaz Tişört</option>
                                <option value="sweater_warm">Sıcak Kazak</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Alt Kıyafet</label>
                            <select id="avBottomItem" class="form-select">
                                <option value="jeans_dark">Koyu Kot Pantolon</option>
                                <option value="jogger_black">Siyah Eşofman</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Şapka / Aksesuar</label>
                            <select id="avHatItem" class="form-select">
                                <option value="">(Şapka Yok)</option>
                                <option value="beanie_orange">Turuncu Bere</option>
                                <option value="cap_black">Siyah Kep</option>
                            </select>
                        </div>
                    </div>
                    <button id="btnUpdateAvatar" class="btn btn-outline-secondary w-100">
                        Görünümü Güncelle
                    </button>
                </div>
            </div>

            <!-- TAB 3: PIXEL ROOM -->
            <div class="tab-pane fade" id="tab-room" role="tabpanel">
                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Piksel Oda Bilgisi</h6>
                    <button id="btnGetRoom" class="btn btn-outline-primary w-100">
                        Odamı Getir (GET /room)
                    </button>
                </div>

                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Odaya Eşya Ekle (POST /room/items)</h6>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Katalog Eşyası</label>
                        <select id="roomCatalogItem" class="form-select">
                            <option value="plant_bonsai">Bonsai Bitkisi (1x1)</option>
                            <option value="neon_sign_focus">Neon "FOCUS" Tabelası (2x1)</option>
                            <option value="record_player_vintage">Retro Plak Çalar (1x1)</option>
                            <option value="bookshelf_wood">Ahşap Kitaplık (2x1)</option>
                            <option value="coffee_machine">Espresso Kahve Makinesi (1x1)</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small text-muted mb-1">Grid X</label>
                            <input type="number" id="roomGridX" class="form-control" value="3" min="0" max="10" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted mb-1">Grid Y</label>
                            <input type="number" id="roomGridY" class="form-control" value="3" min="0" max="10" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted mb-1">Yön (Rot)</label>
                            <select id="roomRotation" class="form-select">
                                <option value="0">0°</option>
                                <option value="90">90°</option>
                                <option value="180">180°</option>
                                <option value="270">270°</option>
                            </select>
                        </div>
                    </div>
                    <button id="btnAddRoomItem" class="btn btn-outline-secondary w-100">
                        Eşyayı Yerleştir
                    </button>
                </div>

                <div class="card card-custom p-3">
                    <h6 class="fw-bold text-dark mb-2">Oda Temasını Değiştir (PATCH /room/theme)</h6>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Duvar Kağıdı</label>
                            <select id="roomWallpaper" class="form-select">
                                <option value="wallpaper_brick_loft">Loft Tuğla</option>
                                <option value="wallpaper_slate_dark">Koyu Arduvaz</option>
                                <option value="wallpaper_wood_cozy">Sıcak Ahşap</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Zemin</label>
                            <select id="roomFloor" class="form-select">
                                <option value="floor_parquet_oak">Meşe Parke</option>
                                <option value="floor_tatami_japanese">Japon Tatami</option>
                                <option value="floor_marble_white">Beyaz Mermer</option>
                            </select>
                        </div>
                    </div>
                    <button id="btnUpdateTheme" class="btn btn-outline-secondary w-100">
                        Temayı Uygula
                    </button>
                </div>
            </div>

            <!-- TAB 4: SAYAÇ & DÖNGÜ (FAZ 2) -->
            <div class="tab-pane fade" id="tab-session" role="tabpanel">
                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Özelleştirilebilir Seans Başlat</h6>
                    <div class="text-muted small mb-3">İstediğiniz çalışma & mola dakikasını girin (Örn: 48 dk odak / 17 dk mola).</div>
                    
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Odaklanma Süresi (Dk)</label>
                            <input type="number" id="sessionFocusMin" class="form-control" value="48" min="1" max="180" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Mola Süresi (Dk)</label>
                            <input type="number" id="sessionBreakMin" class="form-control" value="17" min="1" max="60" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Hedef Tur Sayısı</label>
                            <input type="number" id="sessionTargetRounds" class="form-control" value="4" min="1" max="20" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted mb-1">Başlangıç Modu</label>
                            <select id="sessionKind" class="form-select">
                                <option value="Focus">Odaklanma (Focus)</option>
                                <option value="Break">Mola (Break)</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Seçili Tema</label>
                        <input type="text" id="sessionThemeId" class="form-control" value="rainy_window" placeholder="Örn: rainy_window, cozy_cloudy" />
                    </div>

                    <button id="btnStartSession" class="btn btn-primary w-100 fw-semibold">
                        Seansı Başlat (POST /api/v1/sessions)
                    </button>
                </div>

                <div class="card card-custom p-3 mb-3">
                    <h6 class="fw-bold text-dark mb-2">Aktif Seans Kontrolleri</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <button id="btnPauseSession" class="btn btn-outline-warning w-100">
                                Duraklat (POST /pause)
                            </button>
                        </div>
                        <div class="col-6">
                            <button id="btnResumeSession" class="btn btn-outline-success w-100">
                                Devam Et (POST /resume)
                            </button>
                        </div>
                    </div>
                    <div class="mb-2">
                        <button id="btnExtendSession" class="btn btn-outline-info w-100 text-dark">
                            +10 Dk Uzat (Flow Shield)
                        </button>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <button id="btnCompleteSession" class="btn btn-outline-primary w-100">
                                Bitir & Ödül Al
                            </button>
                        </div>
                        <div class="col-6">
                            <button id="btnAbandonSession" class="btn btn-outline-danger w-100">
                                Masadan Kalk
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card card-custom p-3">
                    <button id="btnGetActiveSession" class="btn btn-outline-secondary w-100">
                        Aktif Seansı Sorgula (GET /api/v1/sessions/active)
                    </button>
                </div>
            </div>

            <!-- TAB 5: MEDYA & DIŞ API'LER (FAZ 2) -->
            <div class="tab-pane fade" id="tab-media" role="tabpanel">
                <!-- 1. Pixabay Video Arama -->
                <div class="card card-custom p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0">Pixabay HD Arka Plan Temaları</h6>
                        <span class="badge bg-success-subtle text-success border">Video API</span>
                    </div>
                    <div class="input-group mb-2">
                        <input type="text" id="pixabayQuery" class="form-control" value="rain window" placeholder="İstediğiniz temayı yazın..." />
                        <button id="btnSearchThemes" class="btn btn-primary px-3">Ara</button>
                    </div>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-theme-chip" data-q="rain window">🌧️ Yağmur</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-theme-chip" data-q="cozy cafe coffee">☕ Sıcak Kafe</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-theme-chip" data-q="fireplace burning">🔥 Şömine</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-theme-chip" data-q="night city tokyo">🌃 Gece Şehri</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-theme-chip" data-q="forest nature calm">🌲 Doğa & Orman</button>
                    </div>
                    <div id="themesContainer" class="d-flex flex-column gap-2" style="max-height: 250px; overflow-y: auto;">
                        <span class="text-muted small text-center p-3 bg-light rounded">Aramak için yukarıdan "Ara" butonuna tıklayınız.</span>
                    </div>
                </div>

                <!-- 2. Jamendo & Lo-Fi Müzik Arama -->
                <div class="card card-custom p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0">Jamendo & Lo-Fi Plak Çalar</h6>
                        <span class="badge bg-info-subtle text-info border">Müzik API</span>
                    </div>
                    <div class="input-group mb-2">
                        <input type="text" id="musicQuery" class="form-control" value="lofi" placeholder="Parça, sanatçı veya müzik türü..." />
                        <button id="btnSearchMusic" class="btn btn-outline-primary px-3">Parça Ara</button>
                    </div>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-music-chip" data-q="lofi">🎧 Lo-Fi</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-music-chip" data-q="piano">🎹 Piyano</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-music-chip" data-q="chillhop">☕ Chillhop</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-music-chip" data-q="ambient">🌿 Ambiyans</button>
                        <button type="button" class="btn btn-sm btn-light border text-secondary px-2 py-0 btn-music-chip" data-q="jazz">🎷 Caz</button>
                    </div>
                    <div id="tracksContainer" class="d-flex flex-column gap-2" style="max-height: 250px; overflow-y: auto;">
                        <span class="text-muted small text-center p-3 bg-light rounded">Parçaları listelemek için "Parça Ara"ya basınız.</span>
                    </div>
                </div>

                <!-- 3. Open-Meteo & Hava Durumu Simülatörü -->
                <div class="card card-custom p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0">Hava Durumu Senkronu & Simülatörü</h6>
                        <span class="badge bg-secondary-subtle text-secondary border">Hava Senkronu</span>
                    </div>
                    
                    <!-- Canlı Şehirler -->
                    <label class="form-label small text-muted mb-1">Canlı Şehir Seçimi:</label>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill btn-city py-1" data-lat="41.0082" data-lon="28.9784">İstanbul</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill btn-city py-1" data-lat="39.9334" data-lon="32.8597">Ankara</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill btn-city py-1" data-lat="38.4237" data-lon="27.1428">İzmir</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill btn-city py-1" data-lat="51.5074" data-lon="-0.1278">Londra</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill btn-city py-1" data-lat="35.6762" data-lon="139.6503">Tokyo</button>
                    </div>

                    <!-- Farklı Hava Durumu Tepkisi Simülatörü -->
                    <label class="form-label small text-muted mb-1">Tüm Hava Durumu Tepkilerini Canlı Test Edin:</label>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-warning btn-weather-sim" data-code="0">☀️ Güneşli</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-weather-sim" data-code="2">⛅ Parçalı</button>
                        <button type="button" class="btn btn-sm btn-outline-dark btn-weather-sim" data-code="3">☁️ Kapalı</button>
                        <button type="button" class="btn btn-sm btn-outline-primary btn-weather-sim" data-code="61">🌧️ Yağmurlu</button>
                        <button type="button" class="btn btn-sm btn-outline-danger btn-weather-sim" data-code="95">⛈️ Fırtınalı</button>
                        <button type="button" class="btn btn-sm btn-outline-info btn-weather-sim" data-code="71">❄️ Karlı</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-weather-sim" data-code="45">🌫️ Sisli</button>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <input type="text" id="weatherLat" class="form-control form-control-sm" value="41.0082" placeholder="Enlem" />
                        </div>
                        <div class="col-6">
                            <input type="text" id="weatherLon" class="form-control form-control-sm" value="28.9784" placeholder="Boylam" />
                        </div>
                    </div>
                    <button id="btnGetWeather" class="btn btn-outline-secondary btn-sm w-100">
                        Canlı Koordinattan Çek (GET /api/v1/media/weather)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Sağ Kolon: Canlı Stüdyo & Atmosfer Önizleme, Sayaç, Karakter ve Log Konsolu -->
    <div class="col-lg-7">
        <!-- CANLI STÜDYO VE ATMOSFER ÖNİZLEME ALANI (FAZ 2) -->
        <div class="card card-custom mb-4 overflow-hidden border shadow-sm" id="studioPreviewCard" style="border-top: 4px solid #2563eb; transition: all 0.3s ease;">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-6 fw-bold text-dark mb-0">Canlı Atmosfer & Önizleme Stüdyosu</span>
                    <span id="badgeStudioTheme" class="badge bg-primary-subtle text-primary border border-primary-subtle">Yağmurlu Pencere</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span id="deskLampBadge" class="badge px-3 py-2 border rounded-pill bg-light text-secondary">
                        🌙 Masa Lambası Sönük
                    </span>
                </div>
            </div>

            <!-- Video Arka Plan Ekranı (Canlı Döngü) -->
            <div class="position-relative bg-dark" style="height: 240px; overflow: hidden;">
                <video id="previewVideoPlayer"
                       style="width: 100%; height: 100%; object-fit: cover; filter: brightness(0.85);"
                       autoplay loop muted playsinline
                       poster="https://images.unsplash.com/photo-1519692933481-e162a57d6721?w=640"
                       src="https://cdn.pixabay.com/video/2017/08/30/11722-231759069_medium.mp4">
                </video>

                <!-- Video Üzeri Atmosfer & Hava Durumu Overlay'i -->
                <div class="position-absolute top-0 start-0 p-3 text-white" style="background: linear-gradient(180deg, rgba(0,0,0,0.6) 0%, transparent 100%); width: 100%;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span id="previewWeatherBadge" class="badge bg-dark bg-opacity-75 border border-secondary px-2 py-1">🌧️ Yağmurlu • 18.5°C</span>
                            <span id="previewWindowEffectBadge" class="badge bg-primary bg-opacity-75 border px-2 py-1">💧 Camda Yağmur Damlaları</span>
                        </div>
                        <div class="d-flex gap-1">
                            <button id="btnToggleVideoPlay" class="btn btn-sm btn-dark bg-opacity-75 border text-white py-0 px-2">Durdur</button>
                            <button id="btnToggleVideoMute" class="btn btn-sm btn-dark bg-opacity-75 border text-white py-0 px-2">Ses Aç</button>
                        </div>
                    </div>
                </div>

                <!-- Video Üzeri Alt Bilgi: Atmosfer Açıklaması -->
                <div class="position-absolute bottom-0 start-0 p-3 text-white" style="background: linear-gradient(0deg, rgba(0,0,0,0.7) 0%, transparent 100%); width: 100%;">
                    <div id="previewAtmosphereDesc" class="small fw-light text-white-50">Dışarıda sağanak yağmur var. Masa lambasının altında çalışmak harika hissettiriyor.</div>
                    <div id="previewSoundscapeDesc" class="small fw-semibold text-warning mt-1">🎵 Önerilen Ambiyans: Pencereye Vuran Yağmur & Lo-Fi Piyano</div>
                </div>
            </div>

            <!-- Müzik & Plak Çalar Barı -->
            <div class="p-3 bg-light border-top d-flex flex-wrap align-items-center justify-content-between gap-3" id="musicPlayerBar">
                <div class="d-flex align-items-center gap-2">
                    <img id="playerTrackImg" src="https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=120" style="width: 44px; height: 44px; border-radius: 6px; object-fit: cover; border: 1px solid #cbd5e1;" />
                    <div style="max-width: 200px;">
                        <strong id="playerTrackTitle" class="d-block text-dark small text-truncate">Midnight Lofi Study</strong>
                        <span id="playerArtistName" class="text-muted small text-truncate d-block">Focus Chill Lab</span>
                    </div>
                </div>
                <!-- Dahili Ses Oynatıcı -->
                <div class="flex-grow-1" style="min-width: 220px;">
                    <audio id="previewAudioPlayer" controls class="w-100" style="height: 36px;" src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3"></audio>
                </div>
            </div>

            <!-- Canlı Sayaç Kartı -->
            <div class="p-4 bg-white border-top">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-dark fs-6">Odaklanma Durumu</span>
                        <span id="badgeTimerMode" class="badge bg-secondary-subtle text-secondary border">Hazır</span>
                    </div>
                    <span id="lblRoundProgress" class="badge bg-light text-secondary border px-3 py-1">Tur 1 / 4</span>
                </div>

                <div class="text-center py-2 mb-3">
                    <div class="text-muted small text-uppercase fw-semibold mb-1" id="lblTimerSubHeader">Kalan Süre</div>
                    <div id="lblTimerDisplay" class="display-3 fw-bold text-dark font-monospace mb-1">48:00</div>
                    <div class="d-flex justify-content-center align-items-center gap-3 text-secondary small">
                        <span>Durum: <strong id="lblTimerStatus" class="text-dark">Beklemede</strong></span>
                        <span>•</span>
                        <span>Çalışılan: <strong id="lblNetDuration" class="text-dark">0 sn</strong></span>
                    </div>
                </div>

                <!-- İlerleme Çubuğu -->
                <div class="progress" style="height: 6px;">
                    <div id="timerProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 100%;"></div>
                </div>
            </div>
        </div>

        <!-- Oturum ve Karakter Özeti -->
        <div class="card card-custom p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">Aktif Oturum & Karakter Özeti</h6>
                <span id="sessionStatusBadge" class="badge rounded-pill badge-status-guest">Oturum Yok</span>
            </div>

            <div id="sessionEmptyAlert" class="p-3 bg-light rounded text-muted small text-center">
                Henüz oturum açılmadı. Soldaki panelden <strong>Misafir Hesabı Aç</strong> butonuna tıklayabilirsiniz.
            </div>

            <div id="sessionContent" style="display: none;">
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <div class="p-3 rounded bg-light border">
                            <span class="text-muted small d-block mb-1">Kullanıcı & Tür</span>
                            <div id="lblDisplayName" class="fw-bold text-dark fs-6"></div>
                            <span id="lblUserType" class="badge rounded-pill mt-1"></span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded bg-light border">
                            <span class="text-muted small d-block mb-1">Seviye ve Bakiye</span>
                            <div class="fw-bold text-dark fs-6"><span id="lblCoins">0</span> Coin</div>
                            <span id="lblLevel" class="badge rounded-pill badge-status-level mt-1"></span>
                        </div>
                    </div>
                </div>

                <!-- Avatar Detay -->
                <div class="p-3 rounded bg-light border mb-3">
                    <span class="text-muted small fw-semibold d-block mb-1">Avatar Görünümü</span>
                    <div id="lblAvatarSummary" class="small text-secondary"></div>
                </div>

                <!-- Piksel Oda & Mobilyalar -->
                <div class="p-3 rounded bg-light border mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Oda: <strong id="lblRoomName" class="text-dark"></strong> (<span id="lblThemeSummary"></span>)</span>
                        <span id="lblItemCount" class="badge bg-white text-secondary border small">0 Mobilya</span>
                    </div>
                    <div id="listRoomItems" class="d-flex flex-column gap-1 small text-secondary"></div>
                </div>

                <!-- Token -->
                <div class="p-3 rounded bg-light border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">Access Token (JWT)</span>
                        <button id="btnCopyToken" class="btn btn-sm btn-link p-0 text-decoration-none small text-primary">Kopyala</button>
                    </div>
                    <code id="lblTokenPreview" class="d-block text-secondary small text-break"></code>
                </div>
            </div>
        </div>

        <!-- Terminal Log Konsolu -->
        <div class="card card-custom p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small text-uppercase fw-semibold">Canlı İstek & Yanıt Günlüğü</span>
                <button id="btnClearLog" class="btn btn-sm btn-link text-secondary text-decoration-none p-0 small">Temizle</button>
            </div>
            <div id="terminalLog" class="terminal-box">
[Sistem] API Test Konsolu hazır. Faz 0 (Auth), Faz 1 (Avatar, Oda) ve Faz 2 (Sayaç, Pixabay Video, Lo-Fi Müzik & Hava Senkronu) hazır.
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const apiBase = '@Model.WebApiBaseUrl';

    let currentTokens = {
        accessToken: sessionStorage.getItem('focus_test_at') || null,
        refreshToken: sessionStorage.getItem('focus_test_rt') || null
    };

    let activeSession = null;
    let timerInterval = null;
    let remainingSeconds = 48 * 60;
    let totalPlannedSeconds = 48 * 60;

    // Medya Oynatıcı Referansları
    const videoPlayer = document.getElementById('previewVideoPlayer');
    const audioPlayer = document.getElementById('previewAudioPlayer');

    function saveTokens(accessToken, refreshToken) {
        currentTokens.accessToken = accessToken;
        currentTokens.refreshToken = refreshToken;
        if (accessToken) sessionStorage.setItem('focus_test_at', accessToken);
        else sessionStorage.removeItem('focus_test_at');
        if (refreshToken) sessionStorage.setItem('focus_test_rt', refreshToken);
        else sessionStorage.removeItem('focus_test_rt');
    }

    function getAuthHeaders(includeContentType = true) {
        const headers = {};
        if (includeContentType) headers['Content-Type'] = 'application/json';
        if (currentTokens.accessToken) headers['Authorization'] = `Bearer ${currentTokens.accessToken}`;
        return headers;
    }

    function log(message, type = 'info') {
        const box = document.getElementById('terminalLog');
        const time = new Date().toLocaleTimeString();
        let color = '#0f172a';
        if (type === 'error') color = '#dc2626';
        if (type === 'success') color = '#16a34a';
        if (type === 'warn') color = '#d97706';

        const line = document.createElement('div');
        line.style.color = color;
        line.innerHTML = `<span style="color: #64748b;">[${time}]</span> ${escapeHtml(message)}`;
        box.appendChild(line);
        box.scrollTop = box.scrollHeight;
    }

    function escapeHtml(text) {
        if (!text) return '';
        return text.toString()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function updateSessionUI(data) {
        document.getElementById('sessionEmptyAlert').style.display = 'none';
        document.getElementById('sessionContent').style.display = 'block';

        if (data.user) {
            document.getElementById('lblDisplayName').textContent = data.user.displayName;
            document.getElementById('lblCoins').textContent = data.user.totalCoins;
            document.getElementById('lblLevel').textContent = `Seviye ${data.user.level} (${data.user.currentXp} XP)`;

            const badgeUserType = document.getElementById('lblUserType');
            if (data.user.isGuest) {
                badgeUserType.textContent = 'Misafir Kullanıcı';
                badgeUserType.className = 'badge rounded-pill badge-status-guest mt-1';
            } else {
                badgeUserType.textContent = 'Kayıtlı Kullanıcı';
                badgeUserType.className = 'badge rounded-pill badge-status-registered mt-1';
            }

            const statusBadge = document.getElementById('sessionStatusBadge');
            statusBadge.textContent = 'Aktif Oturum';
            statusBadge.className = 'badge rounded-pill badge-status-active';
        }

        if (data.tokens && data.tokens.accessToken) {
            document.getElementById('lblTokenPreview').textContent =
                data.tokens.accessToken.substring(0, 48) + '... (Uzunluk: ' + data.tokens.accessToken.length + ')';
        } else if (currentTokens.accessToken) {
            document.getElementById('lblTokenPreview').textContent =
                currentTokens.accessToken.substring(0, 48) + '... (Uzunluk: ' + currentTokens.accessToken.length + ')';
        }

        if (data.avatar) {
            document.getElementById('lblAvatarSummary').textContent =
                `Ten: ${data.avatar.skinTone} | Saç: ${data.avatar.hairStyle} (${data.avatar.hairColor}) | Üst: ${data.avatar.topItemId} | Alt: ${data.avatar.bottomItemId} | Şapka: ${data.avatar.hatItemId || 'Yok'}`;
        }

        if (data.room) {
            document.getElementById('lblRoomName').textContent = data.room.name;
            document.getElementById('lblThemeSummary').textContent = `${data.room.wallpaperCatalogId}, ${data.room.floorCatalogId}`;
            document.getElementById('lblItemCount').textContent = `${data.room.items.length} Mobilya`;

            const list = document.getElementById('listRoomItems');
            list.innerHTML = '';
            if (data.room.items.length === 0) {
                list.innerHTML = '<span class="text-muted">Odada eşya yok.</span>';
            } else {
                data.room.items.forEach(item => {
                    const row = document.createElement('div');
                    row.className = 'd-flex justify-content-between align-items-center bg-white p-2 rounded border';
                    row.innerHTML = `
                        <div>
                            <strong class="text-dark">${escapeHtml(item.catalogItemId)}</strong>
                            <span class="text-muted ms-2">(X: ${item.gridX}, Y: ${item.gridY}, Rot: ${item.rotation}°)</span>
                        </div>
                        <div class="d-flex gap-1">
                            <button class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="moveItemPrompt('${item.id}', ${item.gridX}, ${item.gridY}, ${item.rotation})">Taşı</button>
                            <button class="btn btn-outline-danger btn-sm py-0 px-2" onclick="removeItem('${item.id}')">Kaldır</button>
                        </div>
                    `;
                    list.appendChild(row);
                });
            }
        }
    }

    function clearSessionUI() {
        saveTokens(null, null);
        activeSession = null;
        clearInterval(timerInterval);
        document.getElementById('sessionEmptyAlert').style.display = 'block';
        document.getElementById('sessionContent').style.display = 'none';
        document.getElementById('sessionStatusBadge').textContent = 'Oturum Yok';
        document.getElementById('sessionStatusBadge').className = 'badge rounded-pill badge-status-guest';
        updateTimerDisplay(48 * 60, 48 * 60, 'Beklemede', 'Hazır', 'Tur 1 / 4', false);
    }

    // SAĞDAKİ CANLI TEMA & MÜZİK ÖNİZLEMESİNİ GÜNCELLE
    function setPreviewTheme(videoUrl, title, posterUrl = null) {
        if (!videoUrl) return;
        videoPlayer.src = videoUrl;
        if (posterUrl) videoPlayer.poster = posterUrl;
        videoPlayer.play().catch(e => console.log('Video autoplay:', e));

        document.getElementById('badgeStudioTheme').textContent = title;
        document.getElementById('sessionThemeId').value = title;
        document.getElementById('btnToggleVideoPlay').textContent = 'Durdur';
        log(`Sağdaki stüdyo önizlemesine tema videosu yüklendi: "${title}"`, 'info');
    }

    function setPreviewTrack(audioUrl, title, artist, imgUrl = null) {
        if (!audioUrl) return;
        audioPlayer.src = audioUrl;
        document.getElementById('playerTrackTitle').textContent = title;
        document.getElementById('playerArtistName').textContent = artist;
        if (imgUrl) {
            document.getElementById('playerTrackImg').src = imgUrl;
        }
        audioPlayer.play().catch(e => console.log('Audio autoplay:', e));
        log(`Sağdaki piksel plak çalara müzik yüklendi: "${title}" - ${artist}`, 'info');
    }

    // SAYAÇ VE MASA LAMBASI UI
    function updateTimerUI(session) {
        activeSession = session;
        if (!session) {
            clearInterval(timerInterval);
            updateTimerDisplay(48 * 60, 48 * 60, 'Beklemede', 'Hazır', 'Tur 1 / 4', false);
            return;
        }

        const isFocus = session.kind === 'Focus';
        const isRunning = session.status === 'Running';
        const isPaused = session.status === 'Paused';

        // Masa lambası: Odak ve Çalışıyor/Duraklatıldı durumunda açık
        const isDeskLightOn = isFocus && (isRunning || isPaused);
        const lamp = document.getElementById('deskLampBadge');
        if (isDeskLightOn) {
            lamp.className = 'badge px-3 py-2 border rounded-pill bg-warning-subtle text-warning-emphasis border-warning shadow-sm';
            lamp.innerHTML = '💡 Masa Lambası Yanıyor (Karakter Masada)';
        } else {
            lamp.className = 'badge px-3 py-2 border rounded-pill bg-light text-secondary';
            lamp.innerHTML = '🌙 Masa Lambası Sönük (Dinlenme Modu)';
        }

        const badgeMode = document.getElementById('badgeTimerMode');
        badgeMode.textContent = isFocus ? '🎯 Odaklanma Modu' : '☕ Mola Modu';
        badgeMode.className = isFocus
            ? 'badge bg-primary-subtle text-primary border border-primary-subtle'
            : 'badge bg-success-subtle text-success border border-success-subtle';

        const roundText = `Tur ${session.currentRound} / ${session.targetRounds}`;
        document.getElementById('lblRoundProgress').textContent = roundText;
        document.getElementById('lblTimerStatus').textContent = session.status;
        document.getElementById('lblNetDuration').textContent = `${Math.floor(session.netDurationSeconds / 60)} dk ${session.netDurationSeconds % 60} sn`;

        totalPlannedSeconds = session.plannedMinutes * 60;
        remainingSeconds = session.remainingSeconds;

        clearInterval(timerInterval);
        renderTimerDisplay();

        if (isRunning && remainingSeconds > 0) {
            timerInterval = setInterval(() => {
                if (remainingSeconds > 0) {
                    remainingSeconds--;
                    renderTimerDisplay();
                } else {
                    clearInterval(timerInterval);
                    log(`Süre doldu! Seansı tamamlayabilirsiniz.`, 'warn');
                }
            }, 1000);
        }
    }

    function renderTimerDisplay() {
        const mins = Math.floor(remainingSeconds / 60);
        const secs = remainingSeconds % 60;
        document.getElementById('lblTimerDisplay').textContent =
            `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

        const progressPercent = totalPlannedSeconds > 0
            ? Math.max(0, Math.min(100, ((totalPlannedSeconds - remainingSeconds) / totalPlannedSeconds) * 100))
            : 0;
        document.getElementById('timerProgressBar').style.width = `${progressPercent}%`;
    }

    function updateTimerDisplay(remaining, total, statusText, modeText, roundText, lampOn) {
        remainingSeconds = remaining;
        totalPlannedSeconds = total;
        renderTimerDisplay();
        document.getElementById('lblTimerStatus').textContent = statusText;
        document.getElementById('badgeTimerMode').textContent = modeText;
        document.getElementById('lblRoundProgress').textContent = roundText;
        const lamp = document.getElementById('deskLampBadge');
        if (lampOn) {
            lamp.className = 'badge px-3 py-2 border rounded-pill bg-warning-subtle text-warning-emphasis border-warning shadow-sm';
            lamp.innerHTML = '💡 Masa Lambası Yanıyor';
        } else {
            lamp.className = 'badge px-3 py-2 border rounded-pill bg-light text-secondary';
            lamp.innerHTML = '🌙 Masa Lambası Sönük';
        }
    }

    // Video Kontrolleri
    document.getElementById('btnToggleVideoPlay').addEventListener('click', () => {
        const btn = document.getElementById('btnToggleVideoPlay');
        if (videoPlayer.paused) {
            videoPlayer.play();
            btn.textContent = 'Durdur';
        } else {
            videoPlayer.pause();
            btn.textContent = 'Oynat';
        }
    });

    document.getElementById('btnToggleVideoMute').addEventListener('click', () => {
        const btn = document.getElementById('btnToggleVideoMute');
        if (videoPlayer.muted) {
            videoPlayer.muted = false;
            btn.textContent = 'Sessize Al';
        } else {
            videoPlayer.muted = true;
            btn.textContent = 'Ses Aç';
        }
    });

    // 1. AUTH
    document.getElementById('btnCreateGuest').addEventListener('click', async () => {
        const displayName = document.getElementById('guestDisplayName').value.trim();
        log(`POST ${apiBase}/api/v1/auth/guest gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/auth/guest`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ displayName: displayName || null })
            });
            if (res.ok) {
                const data = await res.json();
                log(`HTTP 201 Created: Misafir hesabı açıldı! ID: ${data.user.id}`, 'success');
                saveTokens(data.accessToken, data.refreshToken);
                updateSessionUI(data);
                document.getElementById('btnGetActiveSession').click();
            } else {
                log(`HTTP ${res.status}: Misafir hesabı açılamadı.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnGetMe').addEventListener('click', async () => {
        log(`GET ${apiBase}/api/v1/auth/me gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/auth/me`, {
                method: 'GET',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
                const user = await res.json();
                log(`HTTP 200 OK: Kullanıcı profili alındı! (${user.displayName})`, 'success');
                updateSessionUI({ user: user });
                document.getElementById('btnGetAvatar').click();
                document.getElementById('btnGetRoom').click();
                document.getElementById('btnGetActiveSession').click();
            } else {
                log(`HTTP ${res.status}: Profil getirilemedi.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnRefreshToken').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/auth/refresh gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/auth/refresh`, {
                method: 'POST',
                headers: getAuthHeaders(true),
                credentials: 'include',
                body: JSON.stringify({ refreshToken: currentTokens.refreshToken })
            });
            if (res.ok) {
                const tokens = await res.json();
                log(`HTTP 200 OK: Yeni token çifti alındı!`, 'success');
                saveTokens(tokens.accessToken, tokens.refreshToken);
                updateSessionUI({ tokens: tokens });
            } else {
                log(`HTTP ${res.status}: Token yenilenemedi.`, 'error');
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnLogout').addEventListener('click', async () => {
        log(`POST ${apiBase}/api/v1/auth/logout gönderiliyor...`);
        try {
            await fetch(`${apiBase}/api/v1/auth/logout`, {
                method: 'POST',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            log(`HTTP 200 OK: Oturum güvenle kapatıldı.`, 'success');
            clearSessionUI();
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnTestReplay').addEventListener('click', async () => {
        if (!currentTokens.refreshToken) {
            log(`Replay testi için önce bir oturum açmalısınız!`, 'warn');
            return;
        }
        const stolenToken = currentTokens.refreshToken;
        log(`[Test] 1. İstek: Token yenileniyor...`);
        const res1 = await fetch(`${apiBase}/api/v1/auth/refresh`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ refreshToken: stolenToken })
        });
        if (res1.ok) {
            const newTokens = await res1.json();
            saveTokens(newTokens.accessToken, newTokens.refreshToken);
            log(`[Test] 1. İstek başarılı. Eski token ile 2. istek (Replay) yapılıyor...`, 'warn');
            const res2 = await fetch(`${apiBase}/api/v1/auth/refresh`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ refreshToken: stolenToken })
            });
            if (res2.status === 401) {
                log(`[Test Başarılı!] HTTP 401: Eski token tespit edildi ve zincirleme iptal edildi!`, 'success');
                clearSessionUI();
            } else {
                log(`[Uyarı] HTTP ${res2.status}: Beklenmedik yanıt.`, 'error');
            }
        }
    });

    // 2. AVATAR
    document.getElementById('btnGetAvatar').addEventListener('click', async () => {
        log(`GET ${apiBase}/api/v1/avatar gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/avatar`, {
                method: 'GET',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
                const avatar = await res.json();
                log(`HTTP 200 OK: Avatar bilgisi alındı!`, 'success');
                updateSessionUI({ avatar: avatar });
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnUpdateAvatar').addEventListener('click', async () => {
        const payload = {
            skinTone: document.getElementById('avSkinTone').value,
            hairStyle: document.getElementById('avHairStyle').value,
            hairColor: document.getElementById('avHairColor').value,
            topItemId: document.getElementById('avTopItem').value,
            bottomItemId: document.getElementById('avBottomItem').value,
            hatItemId: document.getElementById('avHatItem').value || null,
            clearHat: !document.getElementById('avHatItem').value
        };

        log(`PATCH ${apiBase}/api/v1/avatar gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/avatar`, {
                method: 'PATCH',
                headers: getAuthHeaders(true),
                credentials: 'include',
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                const avatar = await res.json();
                log(`HTTP 200 OK: Avatar güncellendi!`, 'success');
                updateSessionUI({ avatar: avatar });
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    // 3. PIXEL ROOM
    document.getElementById('btnGetRoom').addEventListener('click', async () => {
        log(`GET ${apiBase}/api/v1/room gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/room`, {
                method: 'GET',
                headers: getAuthHeaders(false),
                credentials: 'include'
            });
            if (res.ok) {
                const room = await res.json();
                log(`HTTP 200 OK: Oda bilgisi alındı! Eşya: ${room.items.length}`, 'success');
                updateSessionUI({ room: room });
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnAddRoomItem').addEventListener('click', async () => {
        const payload = {
            catalogItemId: document.getElementById('roomCatalogItem').value,
            gridX: parseInt(document.getElementById('roomGridX').value) || 0,
            gridY: parseInt(document.getElementById('roomGridY').value) || 0,
            rotation: parseInt(document.getElementById('roomRotation').value) || 0
        };

        log(`POST ${apiBase}/api/v1/room/items gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/room/items`, {
                method: 'POST',
                headers: getAuthHeaders(true),
                credentials: 'include',
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                const item = await res.json();
                log(`HTTP 201 Created: Eşya yerleştirildi! ID: ${item.id}`, 'success');
                document.getElementById('btnGetRoom').click();
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
        }
    });

    document.getElementById('btnUpdateTheme').addEventListener('click', async () => {
        const payload = {
            wallpaperCatalogId: document.getElementById('roomWallpaper').value,
            floorCatalogId: document.getElementById('roomFloor').value
        };

        log(`PATCH ${apiBase}/api/v1/room/theme gönderiliyor...`);
        try {
            const res = await fetch(`${apiBase}/api/v1/room/theme`, {
                method: 'PATCH',
                headers: getAuthHeaders(true),
                credentials: 'include',
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                const room = await res.json();
                log(`HTTP 200 OK: Oda teması güncellendi!`, 'success');
                updateSessionUI({ room: room });
            }
        } catch (err) {
            log(`Bağlantı Hatası: ${err.message}`, 'error');
