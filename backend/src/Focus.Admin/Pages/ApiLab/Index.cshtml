            btn.innerHTML = `<span class="d-block small fw-bold">Masa ${seatIndex}</span><span class="small">Siz</span>`;
        } else {
            btn.className = 'btn btn-secondary btn-sm w-100 py-2 btn-seat';
            btn.innerHTML = `<span class="d-block small fw-bold">Masa ${seatIndex}</span><span class="small">${label}</span>`;
