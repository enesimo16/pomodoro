@page
@model Focus.Admin.Pages.ApiDocs.IndexModel
@{
    ViewData["Title"] = "API Dokümantasyonu";
}

<!-- ÜST BAŞLIK -->
<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">API Dokümantasyonu & Frontend Sözleşmesi</h1>
        <p class="admin-page-subtitle">Next.js geliştiricisi için hazır REST uçları, TypeScript tipleri ve SignalR canlı olayları</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-page="/ApiLab/Index" class="polaris-btn polaris-btn-primary">
            Canlı API Test Konsolu (Lab)
        </a>
        <a href="@Model.WebApiBaseUrl/swagger" id="btnSwaggerLink" target="_blank" class="polaris-btn polaris-btn-secondary">
            Ham Swagger UI
        </a>
    </div>
</div>

<!-- GLOBAL AYARLAR & TABAN BİLGİ KARTI -->
<div class="polaris-card mb-4">
    <div class="polaris-card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-5">
                <span class="text-muted small d-block">WebAPI Taban Adresi (Değiştirilebilir)</span>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <input type="text" id="txtApiBaseUrl" class="form-control form-control-sm font-monospace fw-bold" 
                           placeholder="http://localhost:5000 veya https://api.domain.com" 
                           value="@Model.WebApiBaseUrl" 
                           oninput="onApiBaseUrlChanged(this.value)" style="max-width: 280px;" />
                    <button type="button" class="polaris-btn polaris-btn-secondary polaris-btn-sm" onclick="copyApiBaseUrl(this)">
                        Kopyala
                    </button>
                    <button type="button" class="polaris-btn polaris-btn-secondary polaris-btn-sm" onclick="resetApiBaseUrl()" title="Varsayılan localhost adresine sıfırla">
                        Sıfırla
                    </button>
                </div>
            </div>
            <div class="col-md-4">
                <span class="text-muted small d-block">Kimlik Doğrulama Standardı</span>
                <span class="badge bg-dark text-white mt-1">Bearer &lt;AccessToken&gt;</span>
                <span class="text-muted small ms-1">(Header: Authorization)</span>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">İçerik & Hata Formatı</span>
                <span class="fw-semibold text-dark small mt-1 d-block">application/json • RFC 9457</span>
            </div>
        </div>
    </div>
</div>

<!-- FRONTEND HIZLI BAŞLANGIÇ & ENTEGRASYON REHBERİ (QUICKSTART) -->
<div class="polaris-card mb-4" id="quickstartCard">
    <div class="polaris-card-header d-flex justify-content-between align-items-center py-2 px-3 bg-light border-bottom">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold text-dark fs-6">Frontend Entegrasyon Rehberi & Ortam Değişkenleri</span>
            <span class="polaris-badge polaris-badge-dark">Next.js & TypeScript</span>
        </div>
        <button type="button" class="polaris-btn polaris-btn-secondary polaris-btn-sm" id="btnToggleQuickstart" onclick="toggleQuickstart()">
            Gizle / Göster
        </button>
    </div>
    <div class="polaris-card-body p-3" id="quickstartContent">
        <!-- Rehber Alt Sekmeleri -->
        <ul class="nav nav-tabs polaris-tabs border-bottom mb-3" id="quickstartTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active polaris-tab-btn" data-bs-toggle="tab" data-bs-target="#qs-env" type="button">
                    .env.local Şablonu
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link polaris-tab-btn" data-bs-toggle="tab" data-bs-target="#qs-keys" type="button">
                    Güvenlik & Admin Key'leri
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link polaris-tab-btn" data-bs-toggle="tab" data-bs-target="#qs-auth" type="button">
                    Token & Refresh Döngüsü
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link polaris-tab-btn" data-bs-toggle="tab" data-bs-target="#qs-signalr" type="button">
                    SignalR WebSocket İstemcisi
                </button>
            </li>
        </ul>

        <div class="tab-content" id="quickstartTabContent">
            <!-- TAB 1: .env.local -->
            <div class="tab-pane fade show active" id="qs-env">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">Next.js projenizin kök dizinindeki <code>.env.local</code> dosyasına yapıştırın:</span>
                    <button type="button" class="polaris-btn polaris-btn-secondary polaris-btn-sm" onclick="copyText(document.getElementById('envSnippet').textContent.trim(), this)">
                        Tümünü Kopyala
                    </button>
                </div>
                <pre class="bg-light p-3 border rounded text-dark font-monospace small m-0" id="envSnippet"><code># Focus WebAPI Taban Adresi
NEXT_PUBLIC_API_URL=@Model.WebApiBaseUrl/api/v1

# SignalR Gerçek Zamanlı Hub Adresleri
NEXT_PUBLIC_SIGNALR_TIMER_URL=@Model.WebApiBaseUrl/hubs/timer
NEXT_PUBLIC_SIGNALR_ROOM_URL=@Model.WebApiBaseUrl/hubs/room

# Admin Paneli Stealth Passkey (Yerel Geliştirici Erişimi)
FOCUS_ADMIN_PASSKEY=focus_master_key_9971x</code></pre>
            </div>

            <!-- TAB 2: Güvenlik & Admin Key'leri -->
            <div class="tab-pane fade" id="qs-keys">
                <p class="small text-muted mb-2">Admin paneline yetkisiz kişilerin erişimini engellemek için tanımlanan anahtarlar (Stealth 404 Kalkanı):</p>
                <div class="table-responsive mb-3">
                    <table class="table table-bordered table-sm m-0 bg-white" style="font-size: 12px;">
                        <thead class="bg-light">
                            <tr>
                                <th>Tanımlı Anahtar (Passkey)</th>
                                <th>Yetki Seviyesi</th>
                                <th>Hızlı Kullanım Bağlantısı</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var key in Model.AdminKeys)
                            {
                                <tr>
                                    <td><code class="fw-bold text-dark">@key</code></td>
                                    <td><span class="badge bg-dark text-white">Yönetici / Geliştirici</span></td>
                                    <td><code>?admin_key=@key</code></td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-outline-dark btn-sm py-0 px-2" style="font-size: 11px;" onclick="copyText('@key', this)">
                                            Kopyala
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-secondary py-2 px-3 small m-0" style="font-size: 11.5px;">
                    <strong>Nasıl Kullanılır?</strong><br/>
                    • <strong>Tarayıcı:</strong> <code>http://localhost:5001/?admin_key=focus_master_key_9971x</code> (Otomatik HttpOnly çerez atanır ve temiz URL'e yönlenir).<br/>
                    • <strong>HTTP Header:</strong> İstek başlığına <code>X-Admin-Key: focus_master_key_9971x</code> eklenebilir.<br/>
                    • <strong>Oturumu Kilitle:</strong> <code>http://localhost:5001/?admin_logout=true</code> tıklandığında çerez silinir ve panel tekrar <strong>404 Not Found</strong> görünümüne kilitlenir.
                </div>
            </div>

            <!-- TAB 3: Token & Refresh Döngüsü -->
            <div class="tab-pane fade" id="qs-auth">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">Next.js için 401 Unauthorized durumunda otomatik token yenileyen istemci fonksiyonu:</span>
                    <button type="button" class="polaris-btn polaris-btn-secondary polaris-btn-sm" onclick="copyText(document.getElementById('authSnippet').textContent.trim(), this)">
                        Kodu Kopyala
                    </button>
                </div>
                <pre class="bg-light p-3 border rounded text-dark font-monospace small m-0" style="max-height: 240px; overflow-y: auto;" id="authSnippet"><code>// lib/apiClient.ts
export async function fetchWithAuth(endpoint: string, options: RequestInit = {}) {
  let token = typeof window !== 'undefined' ? localStorage.getItem('focus_at') : null;

  const headers = {
    'Content-Type': 'application/json',
    ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
    ...options.headers,
  };

  const baseUrl = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:5000/api/v1';
  let response = await fetch(`${baseUrl}${endpoint}`, { ...options, headers });

  // Access Token süresi dolmuşsa (401), Refresh Token ile otomatik yenile
  if (response.status === 401 && typeof window !== 'undefined') {
    const refreshToken = localStorage.getItem('focus_rt');
    if (refreshToken) {
      const refreshRes = await fetch(`${baseUrl}/auth/refresh`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ refreshToken }),
      });

      if (refreshRes.ok) {
        const { data } = await refreshRes.json();
        localStorage.setItem('focus_at', data.accessToken);
        localStorage.setItem('focus_rt', data.refreshToken);

        // İsteği yeni Access Token ile tekrarla
        headers['Authorization'] = `Bearer ${data.accessToken}`;
        return fetch(`${baseUrl}${endpoint}`, { ...options, headers });
      }
    }
  }

  return response;
}</code></pre>
            </div>

            <!-- TAB 4: SignalR WebSocket İstemcisi -->
            <div class="tab-pane fade" id="qs-signalr">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted"><code>npm install @@microsoft/signalr</code> sonrası canlı sayaç ve oda dinleme şablonu:</span>
                    <button type="button" class="polaris-btn polaris-btn-secondary polaris-btn-sm" onclick="copyText(document.getElementById('signalrSnippet').textContent.trim(), this)">
                        Kodu Kopyala
                    </button>
                </div>
                <pre class="bg-light p-3 border rounded text-dark font-monospace small m-0" style="max-height: 240px; overflow-y: auto;" id="signalrSnippet"><code>// lib/timerHub.ts
import * as signalR from '@@microsoft/signalr';

export function createTimerHubConnection(accessToken: string) {
  const hubUrl = process.env.NEXT_PUBLIC_SIGNALR_TIMER_URL || 'http://localhost:5000/hubs/timer';

  const connection = new signalR.HubConnectionBuilder()
    .withUrl(hubUrl, {
      accessTokenFactory: () => accessToken,
      skipNegotiation: false,
      transport: signalR.HttpTransportType.WebSockets | signalR.HttpTransportType.LongPolling
    })
    .withAutomaticReconnect()
    .build();

  // Canlı Saniye Tiklerini Dinle
  connection.on('ReceiveTick', ({ remainingSeconds, elapsedSeconds }) => {
    console.log('Kalan Saniye:', remainingSeconds);
  });

  // Seans Durum Değişikliklerini Dinle (Running, Paused, FlowShieldBroken)
  connection.on('ReceiveStateChanged', ({ status }) => {
    console.log('Seans Durumu:', status);
  });

  return connection;
}</code></pre>
            </div>
        </div>
    </div>
</div>

<!-- ARAMA VE KATEGORİ FİLTRELEME ÇUBUĞU -->
<div class="polaris-card mb-4">
    <div class="p-3 border-bottom d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 380px;">
            <input type="text" id="docSearchInput" class="form-control form-control-sm" placeholder="Uç nokta, yol veya başlık ara... (örn: avatar, token)" oninput="filterEndpoints()" />
        </div>
        <div class="d-flex gap-1 flex-wrap">
            <button type="button" class="polaris-btn polaris-btn-secondary polaris-btn-sm filter-pill active" onclick="setCategoryFilter('all', this)">
                Tümü
            </button>
            @foreach (var cat in Model.Categories)
            {
                <button type="button" class="polaris-btn polaris-btn-secondary polaris-btn-sm filter-pill" onclick="setCategoryFilter('@cat.Id', this)">
                    @cat.Title.Split('(')[0].Trim()
                </button>
            }
            <button type="button" class="polaris-btn polaris-btn-secondary polaris-btn-sm filter-pill" onclick="setCategoryFilter('signalr', this)">
                SignalR Hub'lar
            </button>
        </div>
    </div>
</div>

<!-- REST ENDPOINT KATEGORİLERİ -->
<div id="endpointSections">
    @foreach (var cat in Model.Categories)
    {
        <div class="mb-4 category-section" data-cat-id="@cat.Id">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="fw-bold text-dark m-0">@cat.Title</h6>
                <span class="text-muted small">@cat.Endpoints.Count Uç Nokta</span>
            </div>
            <p class="text-muted small mb-3">@cat.Description</p>

            <div class="d-flex flex-column gap-3">
                @foreach (var ep in cat.Endpoints)
                {
                    <div class="polaris-card endpoint-card" data-cat="@cat.Id" data-search="@(ep.Method + " " + ep.Path + " " + ep.Title + " " + ep.Description)">
                        <div class="polaris-card-header py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2 bg-light border-bottom">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                @if (ep.Method == "POST")
                                {
                                    <span class="badge bg-dark text-white font-monospace px-2 py-1">POST</span>
                                }
                                else if (ep.Method == "GET")
                                {
                                    <span class="badge border border-dark text-dark bg-white font-monospace px-2 py-1">GET</span>
                                }
                                else if (ep.Method == "PUT")
                                {
                                    <span class="badge bg-secondary text-white font-monospace px-2 py-1">PUT</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger text-white font-monospace px-2 py-1">@ep.Method</span>
                                }

                                <span class="font-monospace fw-bold text-dark" style="font-size: 13.5px;"><span class="dynamic-api-base text-muted font-monospace" style="font-weight: 500;">@Model.WebApiBaseUrl</span>@ep.Path</span>
                                <span class="text-muted small">— @ep.Title</span>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                @if (ep.RequiresAuth)
                                {
                                    <span class="polaris-badge" title="Bearer Token Gönderilmesi Zorunludur">Token Gerekli</span>
                                }
                                else
                                {
                                    <span class="polaris-badge polaris-badge-neutral">Herkese Açık</span>
                                }

                                <button type="button" class="polaris-btn polaris-btn-secondary polaris-btn-sm" onclick="copyEndpointUrl('@ep.Path', this)" title="Tam uç nokta URL'ini kopyala">
                                    URL Kopyala
                                </button>

                                @if (!string.IsNullOrEmpty(ep.TestLabTab))
                                {
                                    <a asp-page="/ApiLab/Index" class="polaris-btn polaris-btn-secondary polaris-btn-sm" title="Bu ucu API Test Konsolunda canlı dene">
                                        Test Et
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="polaris-card-body p-3">
                            <p class="text-secondary small mb-3">@ep.Description</p>

                            <div class="row g-3">
                                <!-- TypeScript Tipi -->
                                <div class="col-lg-6">
                                    <div class="border rounded p-2 bg-white h-100">
                                        <div class="d-flex justify-content-between align-items-center mb-1 pb-1 border-bottom">
                                            <span class="fw-bold text-muted small" style="font-size: 11px;">TypeScript Gövde Modeli</span>
                                            @if (!string.IsNullOrEmpty(ep.TypeScriptRequest))
                                            {
                                                <button type="button" class="btn btn-link btn-sm text-dark p-0 text-decoration-none" style="font-size: 11px;" onclick="copyCode(this)">
                                                    Kopyala
                                                </button>
                                            }
                                        </div>
                                        <pre class="m-0 p-2 text-dark font-monospace small bg-light rounded" style="font-size: 11.5px; max-height: 160px; overflow-y: auto; white-space: pre-wrap;"><code>@(ep.TypeScriptRequest ?? "// İstek gövdesi bulunmuyor")</code></pre>
                                    </div>
                                </div>

                                <!-- JSON Yanıt Örneği -->
                                <div class="col-lg-6">
                                    <div class="border rounded p-2 bg-white h-100">
                                        <div class="d-flex justify-content-between align-items-center mb-1 pb-1 border-bottom">
                                            <span class="fw-bold text-muted small" style="font-size: 11px;">Başarılı Yanıt (200 OK)</span>
                                            @if (!string.IsNullOrEmpty(ep.JsonSuccessResponse))
                                            {
                                                <button type="button" class="btn btn-link btn-sm text-dark p-0 text-decoration-none" style="font-size: 11px;" onclick="copyCode(this)">
                                                    Kopyala
                                                </button>
                                            }
                                        </div>
                                        <pre class="m-0 p-2 text-dark font-monospace small bg-light rounded" style="font-size: 11.5px; max-height: 160px; overflow-y: auto; white-space: pre-wrap;"><code>@(ep.JsonSuccessResponse ?? "{\n  \"success\": true\n}")</code></pre>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- SIGNALR REAL-TIME HUBS SÖZLEŞMESİ (SWAGGER'DA BULUNMAYAN ÖZEL REHBER) -->
<div class="mb-5 category-section" data-cat-id="signalr" id="signalrSection">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h6 class="fw-bold text-dark m-0">SignalR Canlı WebSocket Hub Sözleşmesi</h6>
        <span class="badge bg-dark text-white">Canlı Etkileşim</span>
    </div>
    <p class="text-muted small mb-3">
        Next.js tarafında <code>@@microsoft/signalr</code> paketi ile bağlanılan sunucu olayları ve istemci metodları.
    </p>

    <div class="row g-4">
        @foreach (var hub in Model.Hubs)
        {
            <div class="col-lg-6">
                <div class="polaris-card h-100">
                    <div class="polaris-card-header d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold text-dark fs-6">@hub.HubName</span>
                            <code class="ms-2 text-muted font-monospace"><span class="dynamic-api-base">@Model.WebApiBaseUrl</span>@hub.Path</code>
                            <button type="button" class="btn btn-link btn-sm text-dark p-0 text-decoration-none ms-2" style="font-size: 11px;" onclick="copyEndpointUrl('@hub.Path', this)">
                                URL Kopyala
                            </button>
                        </div>
                        <span class="polaris-badge">WebSocket / SSE</span>
                    </div>
                    <div class="polaris-card-body p-3">
                        <p class="text-secondary small mb-3">@hub.Description</p>

                        <!-- İstemcinin Dinlediği Olaylar -->
                        <h6 class="small fw-bold text-dark mb-2">İstemcinin Dinlediği Olaylar (hubConn.on)</h6>
                        <div class="d-flex flex-column gap-2 mb-3">
                            @foreach (var ev in hub.ClientEvents)
                            {
                                <div class="border rounded p-2 bg-light">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-dark font-monospace small">@ev.EventName</span>
                                        <button type="button" class="btn btn-link btn-sm text-dark p-0 text-decoration-none" style="font-size: 11px;" onclick="copyCode(this)">
                                            Kopyala
                                        </button>
                                    </div>
                                    <p class="text-muted small m-0 mb-1" style="font-size: 11px;">@ev.Description</p>
                                    <pre class="m-0 p-1 bg-white border rounded font-monospace small" style="font-size: 11px;"><code>@ev.TypeScriptPayload</code></pre>
                                </div>
                            }
                        </div>

                        <!-- İstemcinin Çağırdığı Metotlar -->
                        <h6 class="small fw-bold text-dark mb-2">İstemcinin Tetiklediği Metotlar (hubConn.invoke)</h6>
                        <div class="d-flex flex-column gap-2">
                            @foreach (var m in hub.ServerMethods)
                            {
                                <div class="border rounded p-2 bg-white">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-semibold text-dark font-monospace small">@m.MethodName</span>
                                        <button type="button" class="btn btn-link btn-sm text-dark p-0 text-decoration-none" style="font-size: 11px;" onclick="copyText('@m.TypeScriptParameters', this)">
                                            Kopyala
                                        </button>
                                    </div>
                                    <p class="text-muted small m-0 mb-1" style="font-size: 11px;">@m.Description</p>
                                    <code class="text-dark small font-monospace d-block bg-light p-1 rounded">@m.TypeScriptParameters</code>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    let activeFilter = 'all';
    const defaultApiBaseUrl = '@Model.WebApiBaseUrl';

    function getActiveBaseUrl() {
        return (localStorage.getItem('focus_custom_api_base_url') || defaultApiBaseUrl).trim().replace(/\/+$/, '');
    }

    function onApiBaseUrlChanged(newVal) {
        const cleaned = (newVal || defaultApiBaseUrl).trim().replace(/\/+$/, '');
        if (newVal && newVal.trim() !== '') {
            localStorage.setItem('focus_custom_api_base_url', cleaned);
        } else {
            localStorage.removeItem('focus_custom_api_base_url');
        }
        updateDynamicUrls(cleaned);
    }

    function resetApiBaseUrl() {
        localStorage.removeItem('focus_custom_api_base_url');
        const input = document.getElementById('txtApiBaseUrl');
        if (input) input.value = defaultApiBaseUrl;
        updateDynamicUrls(defaultApiBaseUrl);
    }

    function copyApiBaseUrl(btn) {
        const url = getActiveBaseUrl();
        copyText(url, btn);
    }

    function copyEndpointUrl(path, btn) {
        const fullUrl = `${getActiveBaseUrl()}${path}`;
        copyText(fullUrl, btn);
    }

    function updateDynamicUrls(baseUrl) {
        // 1. Tüm dinamik base URL metinlerini güncelle
        document.querySelectorAll('.dynamic-api-base').forEach(el => {
            el.textContent = baseUrl;
        });

        // 2. .env.local kod bloğunu güncelle
        const envEl = document.getElementById('envSnippet');
        if (envEl) {
            envEl.textContent = `# Focus WebAPI Taban Adresi\nNEXT_PUBLIC_API_URL=${baseUrl}/api/v1\n\n# SignalR Gerçek Zamanlı Hub Adresleri\nNEXT_PUBLIC_SIGNALR_TIMER_URL=${baseUrl}/hubs/timer\nNEXT_PUBLIC_SIGNALR_ROOM_URL=${baseUrl}/hubs/room\n\n# Admin Paneli Stealth Passkey (Yerel Geliştirici Erişimi)\nFOCUS_ADMIN_PASSKEY=focus_master_key_9971x`;
        }

        // 3. Token Refresh kod bloğunu güncelle
        const authEl = document.getElementById('authSnippet');
        if (authEl) {
            authEl.textContent = `// lib/apiClient.ts\nexport async function fetchWithAuth(endpoint: string, options: RequestInit = {}) {\n  let token = typeof window !== 'undefined' ? localStorage.getItem('focus_at') : null;\n\n  const headers = {\n    'Content-Type': 'application/json',\n    ...(token ? { 'Authorization': \`Bearer \${token}\` } : {}),\n    ...options.headers,\n  };\n\n  const baseUrl = process.env.NEXT_PUBLIC_API_URL || '${baseUrl}/api/v1';\n  let response = await fetch(\`\${baseUrl}\${endpoint}\`, { ...options, headers });\n\n  // Access Token süresi dolmuşsa (401), Refresh Token ile otomatik yenile\n  if (response.status === 401 && typeof window !== 'undefined') {\n    const refreshToken = localStorage.getItem('focus_rt');\n    if (refreshToken) {\n      const refreshRes = await fetch(\`\${baseUrl}/auth/refresh\`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ refreshToken }),\n      });\n\n      if (refreshRes.ok) {\n        const { data } = await refreshRes.json();\n        localStorage.setItem('focus_at', data.accessToken);\n        localStorage.setItem('focus_rt', data.refreshToken);\n\n        // İsteği yeni Access Token ile tekrarla\n        headers['Authorization'] = \`Bearer \${data.accessToken}\`;\n        return fetch(\`\${baseUrl}\${endpoint}\`, { ...options, headers });\n      }\n    }\n  }\n\n  return response;\n}`;
        }

        // 4. SignalR istemci kod bloğunu güncelle
        const signalrEl = document.getElementById('signalrSnippet');
        if (signalrEl) {
            signalrEl.textContent = `// lib/timerHub.ts\nimport * as signalR from '@@microsoft/signalr';\n\nexport function createTimerHubConnection(accessToken: string) {\n  const hubUrl = process.env.NEXT_PUBLIC_SIGNALR_TIMER_URL || '${baseUrl}/hubs/timer';\n\n  const connection = new signalR.HubConnectionBuilder()\n    .withUrl(hubUrl, {\n      accessTokenFactory: () => accessToken,\n      skipNegotiation: false,\n      transport: signalR.HttpTransportType.WebSockets | signalR.HttpTransportType.LongPolling\n    })\n    .withAutomaticReconnect()\n    .build();\n\n  // Canlı Saniye Tiklerini Dinle\n  connection.on('ReceiveTick', ({ remainingSeconds, elapsedSeconds }) => {\n    console.log('Kalan Saniye:', remainingSeconds);\n  });\n\n  // Seans Durum Değişikliklerini Dinle (Running, Paused, FlowShieldBroken)\n  connection.on('ReceiveStateChanged', ({ status }) => {\n    console.log('Seans Durumu:', status);\n  });\n\n  return connection;\n}`;
        }

        // 5. Üstteki Swagger linkini güncelle
        const swBtn = document.getElementById('btnSwaggerLink');
        if (swBtn) swBtn.href = `${baseUrl}/swagger`;

        // 6. Sol menüdeki Swagger linkini güncelle
        const sideSw = document.getElementById('sidebarSwaggerLink');
        if (sideSw) sideSw.href = `${baseUrl}/swagger`;
    }

    // Sayfa açıldığında önceden kaydedilmiş özel URL varsa yükle
    document.addEventListener('DOMContentLoaded', () => {
        const saved = localStorage.getItem('focus_custom_api_base_url');
        if (saved) {
            const input = document.getElementById('txtApiBaseUrl');
            if (input) input.value = saved;
            updateDynamicUrls(saved);
        }
    });

    function setCategoryFilter(catId, btnElement) {
        activeFilter = catId;
        document.querySelectorAll('.filter-pill').forEach(btn => {
            btn.classList.remove('polaris-btn-primary');
            btn.classList.add('polaris-btn-secondary');
        });
        if (btnElement) {
            btnElement.classList.remove('polaris-btn-secondary');
            btnElement.classList.add('polaris-btn-primary');
        }
        applyFilters();
    }

    function filterEndpoints() {
        applyFilters();
    }

    function applyFilters() {
        const query = (document.getElementById('docSearchInput')?.value || '').toLowerCase().trim();
        const sections = document.querySelectorAll('.category-section');

        sections.forEach(sec => {
            const secCatId = sec.getAttribute('data-cat-id');
            const matchesCat = (activeFilter === 'all') || (activeFilter === secCatId);

            if (!matchesCat) {
                sec.style.display = 'none';
                return;
            }

            if (secCatId === 'signalr') {
                sec.style.display = 'block';
                return;
            }

            let visibleInSec = 0;
            const cards = sec.querySelectorAll('.endpoint-card');
            cards.forEach(card => {
                const searchData = (card.getAttribute('data-search') || '').toLowerCase();
                const matchesSearch = !query || searchData.includes(query);

                if (matchesSearch) {
                    card.style.display = 'block';
                    visibleInSec++;
                } else {
                    card.style.display = 'none';
                }
            });

            sec.style.display = (visibleInSec > 0 || !query) ? 'block' : 'none';
        });
    }

    function copyText(text, btn) {
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
            const orig = btn.textContent;
            btn.textContent = 'Kopyalandı!';
            setTimeout(() => { btn.textContent = orig; }, 1500);
        });
    }

    function copyCode(btn) {
        const parent = btn.closest('.border, .polaris-card-body');
        const codeEl = parent ? parent.querySelector('code') : null;
        if (codeEl) {
            copyText(codeEl.textContent.trim(), btn);
        }
    }

    function toggleQuickstart() {
        const content = document.getElementById('quickstartContent');
        if (!content) return;
        if (content.style.display === 'none') {
            content.style.display = 'block';
        } else {
            content.style.display = 'none';
        }
    }
</script>
}
