# Calisma ortami: Development | Staging | Production
# Yerel docker compose icin Development kalabilir; canli ortamda MUTLAKA Production olmali
# (Production: Secure cookie, HSTS, tam eslesen CORS, Swagger kapali, admin anahtari zorunlu).
ASPNETCORE_ENVIRONMENT=Development

# Disariya acilan portlar
API_PORT=5000
ADMIN_PORT=5001
WEB_PORT=3000

# Frontend (build sirasinda gomulur)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# PostgreSQL
POSTGRES_DB=focus_db
POSTGRES_USER=focus_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=focus_db;Username=focus_user;Password=

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379
ConnectionStrings__Redis=redis:6379,password=,abortConnect=false

# Kimlik dogrulama
# SigningKey en az 32 bayt olmalidir (ornek uretim: openssl rand -base64 48); bos veya kisa ise uygulama baslamaz.
Auth__Jwt__SigningKey=
Auth__Jwt__Issuer=focus-api
Auth__Jwt__Audience=focus-web
Auth__Jwt__AccessTokenMinutes=15
Auth__Jwt__RefreshTokenDays=30
Auth__Google__ClientId=
Auth__Google__ClientSecret=
Auth__GitHub__ClientId=
Auth__GitHub__ClientSecret=
Auth__Discord__ClientId=
Auth__Discord__ClientSecret=

# CORS (frontend ve admin adresi, virgulle coklu)
Cors__AllowedOrigins=http://localhost:3000,http://localhost:5001,http://127.0.0.1:3000,http://127.0.0.1:5001
# Production ortaminda yalnizca bu liste ile tam eslesen kaynaklara izin verilir (localhost joker degildir).

# Admin paneli (Focus.Admin)
# Production'da en az bir anahtar zorunludur; panel anahtarsiz baslamaz. Ek anahtarlar icin AdminSecurity__Keys__1 vb. kullanin.
# Uretim: openssl rand -hex 32
AdminSecurity__Enabled=true
AdminSecurity__Keys__0=

# Ters proxy arkasinda gercek istemci IP'si ve https algisi icin guvenilen proxy adresleri (virgulle coklu).
# Bos birakilirsa yalnizca loopback proxy'ye guvenilir.
ForwardedHeaders__KnownProxies=

# Yapay zeka
Ai__Gemini__ApiKey=
Ai__Gemini__ChatModelId=gemini-flash-latest
Ai__Gemini__EmbeddingModelId=gemini-embedding-001
Ai__Gemini__EmbeddingDimensions=768
Ai__Gemini__TimeoutSeconds=15
Ai__DailyTokenBudgetPerUser=20000

# Medya depolama (Cloudflare R2, S3 uyumlu)
Storage__R2__AccountId=
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Storage__R2__BucketName=focus-assets
Storage__R2__PublicBaseUrl=

# Harici icerik API'leri
ExternalApis__Pixabay__ApiKey=
ExternalApis__Jamendo__ClientId=
ExternalApis__Jamendo__ClientSecret=
ExternalApis__Freesound__ApiKey=
ExternalApis__Pexels__ApiKey=
ExternalApis__OpenMeteo__BaseUrl=https://api.open-meteo.com/v1
